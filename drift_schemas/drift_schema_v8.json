      "name": "words",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"words\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"german\" TEXT NOT NULL, \"article\" TEXT NULL, \"plural\" TEXT NULL, \"word_type\" TEXT NOT NULL, \"level\" TEXT NULL, \"meaning_fa\" TEXT NOT NULL, \"meaning_en\" TEXT NULL, \"pronunciation\" TEXT NULL, \"examples_json\" TEXT NULL, \"conjugation_json\" TEXT NULL, \"etymology\" TEXT NULL, \"common_errors\" TEXT NULL, \"grammar_note\" TEXT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"regelmaessig\" INTEGER NULL CHECK (\"regelmaessig\" IN (0, 1)), \"trennbar\" INTEGER NULL CHECK (\"trennbar\" IN (0, 1)), \"grammatik_detail\" TEXT NULL, \"aus_app\" INTEGER NULL CHECK (\"aus_app\" IN (0, 1)), UNIQUE (\"german\", \"word_type\"));"
        }
      ]
    },
