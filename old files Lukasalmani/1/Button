Views/DesignSystem/ComponentsShowcasePage.swift
import SwiftUI
import Charts

struct ComponentsShowcasePage: View {
    @State private var showDeleteAlert = false
    @State private var showSuccessToast = false
    @State private var selectedTab = 0
    @State private var wordName = ""
    @State private var selectedDate = Date()

    private let weeklyData: [(day: String, value: Double)] = [
        ("ش", 4), ("ی", 6), ("د", 3), ("س", 8), ("چ", 5), ("پ", 9), ("ج", 7)
    ]

    var body: some View {
        List {
            // MARK: - ۱. کارت‌ها
            Section("۱. کارت‌ها (Cards)") {
                wordCard
                levelCard
                progressCard
            }

            // MARK: - ۲. هشدار و تایید
            Section("۲. پیام‌های هشدار و تایید") {
                Button("حذف کلمه", role: .destructive) {
                    showDeleteAlert = true
                }
                Button("نمایش پیام موفقیت") {
                    withAnimation { showSuccessToast = true }
                    DispatchQueue.main.asyncAfter(deadline: .now() + 2) {
                        withAnimation { showSuccessToast = false }
                    }
                }
            }
            .alert("حذف کلمه", isPresented: $showDeleteAlert) {
                Button("لغو", role: .cancel) {}
                Button("حذف", role: .destructive) {}
            } message: {
                Text("این کلمه برای همیشه حذف می‌شود. مطمئنید؟")
            }

            // MARK: - ۳. نوار پایین (نمونهٔ TabView)
            Section("۳. نوار پایین صفحه (نمونه)") {
                tabBarPreview
                    .frame(height: 70)
            }

            // MARK: - ۴. حالت خالی
            Section("۴. حالت خالی بودن") {
                emptyStateView
            }

            // MARK: - ۵. نمودارها
            Section("۵. نمودار پیشرفت هفتگی") {
                Chart(weeklyData, id: \.day) { item in
                    BarMark(
                        x: .value("روز", item.day),
                        y: .value("کلمات", item.value)
                    )
                    .foregroundStyle(.blue.gradient)
                    .cornerRadius(6)
                }
                .frame(height: 160)
                .padding(.vertical, 8)
            }

            // MARK: - ۶. صفحهٔ آنبوردینگ (پیش‌نمایش کوچک)
            Section("۶. کارت آنبوردینگ") {
                onboardingCardPreview
            }

            // MARK: - ۷. برچسب‌ها و نشان‌ها
            Section("۷. برچسب‌ها و نشان‌ها") {
                HStack(spacing: 10) {
                    levelBadge("A1", color: .green)
                    levelBadge("B2", color: .orange)
                    levelBadge("C1", color: .red)
                    newBadge
                }
            }

            // MARK: - ۸. فرم‌ها
            Section("۸. فرم‌ها (افزودن کلمه)") {
                TextField("کلمهٔ آلمانی", text: $wordName)
                DatePicker("تاریخ یادآوری", selection: $selectedDate, displayedComponents: .date)
                Picker("سطح", selection: $selectedTab) {
                    Text("A1").tag(0)
                    Text("A2").tag(1)
                    Text("B1").tag(2)
                }
                .pickerStyle(.segmented)
            }
        }
        .navigationTitle("نمونهٔ کامل اجزا")
        .navigationBarTitleDisplayMode(.inline)
        .overlay(alignment: .top) {
            if showSuccessToast {
                successToast
                    .padding(.top, 8)
                    .transition(.move(edge: .top).combined(with: .opacity))
            }
        }
    }

    // MARK: - کارت کلمه
    private var wordCard: some View {
        HStack(spacing: 12) {
            Text("der")
                .font(.caption.bold())
                .padding(.horizontal, 8)
                .padding(.vertical, 4)
                .background(.blue.opacity(0.15))
                .foregroundStyle(.blue)
                .clipShape(Capsule())

            VStack(alignment: .leading, spacing: 2) {
                Text("Tisch")
                    .font(.headline)
                Text("میز")
                    .font(.subheadline)
                    .foregroundStyle(.secondary)
            }
            Spacer()
            Image(systemName: "speaker.wave.2.fill")
                .foregroundStyle(.blue)
        }
        .padding(.vertical, 6)
    }

    // MARK: - کارت سطح
    private var levelCard: some View {
        HStack {
            VStack(alignment: .leading, spacing: 4) {
                Text("سطح B1")
                    .font(.headline)
                Text("۱۲۰ درس • ۳۰ درس تمام‌شده")
                    .font(.caption)
                    .foregroundStyle(.secondary)
            }
            Spacer()
            ProgressView(value: 0.25)
                .frame(width: 60)
        }
        .padding(.vertical, 6)
    }

    // MARK: - کارت پیشرفت
    private var progressCard: some View {
        HStack(spacing: 16) {
            ZStack {
                Circle().stroke(.gray.opacity(0.2), lineWidth: 5)
                Circle()
                    .trim(from: 0, to: 0.72)
                    .stroke(.green, style: StrokeStyle(lineWidth: 5, lineCap: .round))
                    .rotationEffect(.degrees(-90))
                Text("72%")
                    .font(.caption.bold())
            }
            .frame(width: 50, height: 50)

            VStack(alignment: .leading) {
                Text("پیشرفت کلی")
                    .font(.subheadline.bold())
                Text("۳۶۰ از ۵۰۰ کلمه یاد گرفته شده")
                    .font(.caption)
                    .foregroundStyle(.secondary)
            }
        }
        .padding(.vertical, 6)
    }

    // MARK: - نوار پایین (نمونه)
    private var tabBarPreview: some View {
        HStack {
            tabItem("Wortschatz", icon: "textformat.abc", selected: selectedTab == 0) { selectedTab = 0 }
            tabItem("Grammatik", icon: "text.book.closed", selected: selectedTab == 1) { selectedTab = 1 }
            tabItem("Lesen", icon: "book", selected: selectedTab == 2) { selectedTab = 2 }
            tabItem("More", icon: "ellipsis.circle", selected: selectedTab == 3) { selectedTab = 3 }
        }
    }

    private func tabItem(_ title: String, icon: String, selected: Bool, action: @escaping () -> Void) -> some View {
        Button(action: action) {
            VStack(spacing: 4) {
                Image(systemName: icon)
                    .font(.title3)
                Text(title)
                    .font(.caption2)
            }
            .foregroundStyle(selected ? .blue : .gray)
            .frame(maxWidth: .infinity)
        }
    }

    // MARK: - حالت خالی
    private var emptyStateView: some View {
        VStack(spacing: 12) {
            Image(systemName: "tray")
                .font(.system(size: 40))
                .foregroundStyle(.tertiary)
            Text("هنوز کلمه‌ای اضافه نکرده‌اید")
                .font(.headline)
            Text("اولین کلمهٔ آلمانی خود را اضافه کنید تا یادگیری را شروع کنید.")
                .font(.caption)
                .foregroundStyle(.secondary)
                .multilineTextAlignment(.center)
            Button("افزودن کلمه", systemImage: "plus.circle.fill") {}
                .buttonStyle(.borderedProminent)
        }
        .frame(maxWidth: .infinity)
        .padding(.vertical, 24)
    }

    // MARK: - آنبوردینگ
    private var onboardingCardPreview: some View {
        VStack(spacing: 10) {
            Image(systemName: "flag.checkered")
                .font(.system(size: 36))
                .foregroundStyle(.blue)
            Text("به LukasAlmani خوش آمدید")
                .font(.headline)
            Text("مسیر یادگیری آلمانی خود را از A1 تا C2 شروع کنید.")
                .font(.caption)
                .foregroundStyle(.secondary)
                .multilineTextAlignment(.center)
        }
        .frame(maxWidth: .infinity)
        .padding(.vertical, 16)
    }

    // MARK: - برچسب سطح
    private func levelBadge(_ text: String, color: Color) -> some View {
        Text(text)
            .font(.caption.bold())
            .padding(.horizontal, 10)
            .padding(.vertical, 5)
            .background(color.opacity(0.15))
            .foregroundStyle(color)
            .clipShape(Capsule())
    }

    private var newBadge: some View {
        Text("جدید")
            .font(.caption2.bold())
            .padding(.horizontal, 8)
            .padding(.vertical, 4)
            .background(.red)
            .foregroundStyle(.white)
            .clipShape(Capsule())
    }

    // MARK: - پیام موفقیت شناور
    private var successToast: some View {
        Label("با موفقیت ذخیره شد", systemImage: "checkmark.circle.fill")
            .font(.subheadline.weight(.medium))
            .padding(.horizontal, 16)
            .padding(.vertical, 10)
            .background(.green)
            .foregroundStyle(.white)
            .clipShape(Capsule())
            .shadow(radius: 4)
    }
}

