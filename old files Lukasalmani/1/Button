import SwiftUI

/// صفحهٔ نمایش تمام سبک‌های دکمه — فقط برای مرور و انتخاب، نه برای استفادهٔ نهایی در اپ.
struct ButtonShowcasePage: View {
    @State private var isToggled = false
    @State private var selectedChip: Int = 0
    @State private var isLoading = false

    var body: some View {
        ScrollView {
            VStack(alignment: .leading, spacing: 32) {

                section("۱. بر اساس اولویت (Filled / Outlined / Ghost)") {
                    HStack(spacing: 12) {
                        ShowcaseButton(title: "Primary", style: .filled(color: .blue))
                        ShowcaseButton(title: "Outlined", style: .outlined(color: .blue))
                        ShowcaseButton(title: "Ghost", style: .ghost(color: .blue))
                    }
                }

                section("۲. سبک نرم و سه‌بعدی (Soft / Clay)") {
                    HStack(spacing: 12) {
                        ShowcaseButton(title: "Soft", style: .soft(color: .purple))
                        ShowcaseButton(title: "Clay", style: .clay(color: .orange))
                    }
                }

                section("۳. گرادینت") {
                    ShowcaseButton(title: "Gradient Button", style: .gradient(colors: [.pink, .purple]))
                }

                section("۴. شکل — گوشه‌گرد در مقابل کاملاً بیضی (Pill)") {
                    HStack(spacing: 12) {
                        ShowcaseButton(title: "Rounded", style: .filled(color: .green), shape: .rounded(12))
                        ShowcaseButton(title: "Pill Shape", style: .filled(color: .green), shape: .pill)
                    }
                }

                section("۵. فقط آیکون / دایره‌ای (FAB)") {
                    HStack(spacing: 16) {
                        IconOnlyButton(systemName: "plus", style: .filled(color: .blue))
                        IconOnlyButton(systemName: "heart.fill", style: .outlined(color: .red))
                        IconOnlyButton(systemName: "trash", style: .soft(color: .red))
                    }
                }

                section("۶. آیکون + متن") {
                    HStack(spacing: 12) {
                        IconTextButton(title: "دانلود", systemName: "arrow.down.circle.fill", style: .filled(color: .blue))
                        IconTextButton(title: "اشتراک‌گذاری", systemName: "square.and.arrow.up", style: .outlined(color: .blue))
                    }
                }

                section("۷. مخرب / هشدار (Destructive)") {
                    ShowcaseButton(title: "حذف حساب کاربری", style: .filled(color: .red))
                }

                section("۸. غیرفعال (Disabled)") {
                    ShowcaseButton(title: "غیرفعال", style: .filled(color: .gray))
                        .disabled(true)
                        .opacity(0.5)
                }

                section("۹. در حال بارگذاری (Loading)") {
                    Button {
                        isLoading.toggle()
                    } label: {
                        HStack(spacing: 8) {
                            if isLoading {
                                ProgressView()
                                    .progressViewStyle(CircularProgressViewStyle(tint: .white))
                            }
                            Text(isLoading ? "در حال ارسال..." : "ارسال")
                        }
                        .frame(maxWidth: .infinity)
                        .padding(.vertical, 14)
                        .background(Color.blue)
                        .foregroundColor(.white)
                        .cornerRadius(12)
                    }
                }

                section("۱۰. تاگل / چیپ (وضعیت فعال/غیرفعال)") {
                    HStack(spacing: 10) {
                        ForEach(0..<3) { index in
                            ChipButton(
                                title: ["همه", "کلمات", "جملات"][index],
                                isSelected: selectedChip == index
                            ) {
                                selectedChip = index
                            }
                        }
                    }
                }

                section("۱۱. سوییچ روشن/خاموش (سبک دکمه‌ای)") {
                    ToggleStyleButton(isOn: $isToggled)
                }

                section("۱۲. اندازه‌ها (Small / Medium / Large)") {
                    VStack(alignment: .leading, spacing: 10) {
                        ShowcaseButton(title: "Small", style: .filled(color: .blue), size: .small)
                        ShowcaseButton(title: "Medium", style: .filled(color: .blue), size: .medium)
                        ShowcaseButton(title: "Large", style: .filled(color: .blue), size: .large)
                    }
                }
            }
            .padding(20)
        }
        .navigationTitle("Button Showcase")
    }

    @ViewBuilder
    private func section<Content: View>(_ title: String, @ViewBuilder content: () -> Content) -> some View {
        VStack(alignment: .leading, spacing: 10) {
            Text(title)
                .font(.headline)
                .foregroundColor(.secondary)
            content()
        }
    }
}

// MARK: - Style Definitions

enum ButtonAppearance {
    case filled(color: Color)
    case outlined(color: Color)
    case ghost(color: Color)
    case soft(color: Color)
    case clay(color: Color)
    case gradient(colors: [Color])
}

enum ButtonShape {
    case rounded(CGFloat)
    case pill
}

enum ButtonSizeToken {
    case small, medium, large

    var verticalPadding: CGFloat {
        switch self { case .small: return 8; case .medium: return 14; case .large: return 18 }
    }
    var horizontalPadding: CGFloat {
        switch self { case .small: return 14; case .medium: return 20; case .large: return 28 }
    }
    var font: Font {
        switch self { case .small: return .footnote; case .medium: return .body; case .large: return .title3 }
    }
}

// MARK: - Reusable Showcase Button

struct ShowcaseButton: View {
    let title: String
    let style: ButtonAppearance
    var shape: ButtonShape = .rounded(12)
    var size: ButtonSizeToken = .medium

    var body: some View {
        Button {} label: {
            Text(title)
                .font(size.font.weight(.semibold))
                .padding(.vertical, size.verticalPadding)
                .padding(.horizontal, size.horizontalPadding)
                .background(background)
                .foregroundColor(foreground)
                .overlay(overlay)
                .clipShape(clipShape)
        }
    }

    private var clipShape: some Shape {
        switch shape {
        case .rounded(let radius): return AnyShape(RoundedRectangle(cornerRadius: radius))
        case .pill: return AnyShape(Capsule())
        }
    }

    @ViewBuilder
    private var background: some View {
        switch style {
        case .filled(let color): color
        case .outlined: Color.clear
        case .ghost: Color.clear
        case .soft(let color): color.opacity(0.15)
        case .clay(let color): color.opacity(0.9)
        case .gradient(let colors): LinearGradient(colors: colors, startPoint: .leading, endPoint: .trailing)
        }
    }

    private var foreground: Color {
        switch style {
        case .filled, .gradient: return .white
        case .outlined(let color): return color
        case .ghost(let color): return color
        case .soft(let color): return color
        case .clay: return .white
        }
    }

    @ViewBuilder
    private var overlay: some View {
        switch style {
        case .outlined(let color):
            clipShape.stroke(color, lineWidth: 1.5)
        case .clay(let color):
            clipShape
                .stroke(color.opacity(0.4), lineWidth: 1)
                .shadow(color: .white.opacity(0.6), radius: 2, x: -2, y: -2)
        default:
            EmptyView()
        }
    }
}

/// کمکی برای type-erase کردن Shape (چون RoundedRectangle و Capsule نوع متفاوت دارند)
struct AnyShape: Shape {
    private let pathBuilder: (CGRect) -> Path
    init<S: Shape>(_ shape: S) { pathBuilder = shape.path(in:) }
    func path(in rect: CGRect) -> Path { pathBuilder(rect) }
}

// MARK: - Icon Only Button (FAB style)

struct IconOnlyButton: View {
    let systemName: String
    let style: ButtonAppearance

    var body: some View {
        Button {} label: {
            Image(systemName: systemName)
                .font(.system(size: 18, weight: .semibold))
                .frame(width: 48, height: 48)
                .background(background)
                .foregroundColor(foreground)
                .clipShape(Circle())
                .shadow(color: .black.opacity(0.15), radius: 4, y: 2)
        }
    }

    @ViewBuilder
    private var background: some View {
        switch style {
        case .filled(let color): color
        case .soft(let color): color.opacity(0.15)
        case .outlined: Color.white
        default: Color.gray.opacity(0.1)
        }
    }

    private var foreground: Color {
        switch style {
        case .filled: return .white
        case .outlined(let color): return color
        case .soft(let color): return color
        default: return .primary
        }
    }
}

// MARK: - Icon + Text Button

struct IconTextButton: View {
    let title: String
    let systemName: String
    let style: ButtonAppearance

    var body: some View {
        Button {} label: {
            HStack(spacing: 8) {
                Image(systemName: systemName)
                Text(title)
            }
            .font(.body.weight(.medium))
            .padding(.vertical, 12)
            .padding(.horizontal, 18)
            .background(background)
            .foregroundColor(foreground)
            .overlay(
                RoundedRectangle(cornerRadius: 12)
                    .stroke(strokeColor, lineWidth: isOutlined ? 1.5 : 0)
            )
            .clipShape(RoundedRectangle(cornerRadius: 12))
        }
    }

    private var isOutlined: Bool {
        if case .outlined = style { return true }
        return false
    }

    @ViewBuilder
    private var background: some View {
        switch style {
        case .filled(let color): color
        default: Color.clear
        }
    }

    private var foreground: Color {
        switch style {
        case .filled: return .white
        case .outlined(let color): return color
        default: return .primary
        }
    }

    private var strokeColor: Color {
        if case .outlined(let color) = style { return color }
        return .clear
    }
}

// MARK: - Chip / Toggle Button

struct ChipButton: View {
    let title: String
    let isSelected: Bool
    let action: () -> Void

    var body: some View {
        Button(action: action) {
            Text(title)
                .font(.footnote.weight(.medium))
                .padding(.vertical, 8)
                .padding(.horizontal, 16)
                .background(isSelected ? Color.blue : Color.gray.opacity(0.12))
                .foregroundColor(isSelected ? .white : .primary)
                .clipShape(Capsule())
        }
    }
}

// MARK: - Toggle Style Button (سوییچ به شکل دکمه)

struct ToggleStyleButton: View {
    @Binding var isOn: Bool

    var body: some View {
        Button {
            withAnimation(.spring(response: 0.3)) { isOn.toggle() }
        } label: {
            HStack {
                Circle()
                    .fill(isOn ? Color.green : Color.gray)
                    .frame(width: 12, height: 12)
                Text(isOn ? "روشن" : "خاموش")
                    .font(.footnote.weight(.medium))
            }
            .padding(.vertical, 8)
            .padding(.horizontal, 16)
            .background(Color.gray.opacity(0.1))
            .clipShape(Capsule())
        }
    }
}

