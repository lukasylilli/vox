import SwiftUI

/// صفحهٔ نمایش دکمه‌ها با اجزای رسمی اپل — این دکمه‌ها به‌طور خودکار با هر آپدیت iOS
/// ظاهرشان به‌روز می‌شود، چون از استایل‌های سیستمی استفاده می‌کنند نه شکل دستی‌کشیده‌شده.
struct ButtonShowcasePage: View {
    @State private var isOn = false
    @State private var isLoading = false
    @State private var selectedSegment = 0

    var body: some View {
        List {
            Section("۱. دکمهٔ اصلی (مهم‌ترین اکشن)") {
                Button("ادامه") {}
                    .buttonStyle(.borderedProminent)
                    .controlSize(.large)
            }

            Section("۲. دکمهٔ فرعی") {
                Button("انصراف") {}
                    .buttonStyle(.bordered)
                    .controlSize(.large)
            }

            Section("۳. دکمهٔ شبح (بدون پس‌زمینه)") {
                Button("بعداً") {}
                    .buttonStyle(.plain)
                    .foregroundStyle(.blue)
            }

            Section("۴. دکمهٔ خطرناک (رنگ سیستمی قرمز)") {
                Button("حذف حساب کاربری", role: .destructive) {}
                    .buttonStyle(.bordered)
            }

            Section("۵. فقط آیکون (دایره‌ای رسمی اپل)") {
                HStack(spacing: 16) {
                    Button {} label: {
                        Image(systemName: "plus")
                    }
                    .buttonStyle(.borderedProminent)
                    .clipShape(Circle())

                    Button {} label: {
                        Image(systemName: "heart.fill")
                    }
                    .buttonStyle(.bordered)
                    .clipShape(Circle())
                }
            }

            Section("۶. آیکون + متن") {
                Button {} label: {
                    Label("اشتراک‌گذاری", systemImage: "square.and.arrow.up")
                }
                .buttonStyle(.bordered)
            }

            Section("۷. غیرفعال") {
                Button("غیرفعال") {}
                    .buttonStyle(.borderedProminent)
                    .disabled(true)
            }

            Section("۸. در حال بارگذاری") {
                Button {
                    isLoading.toggle()
                } label: {
                    if isLoading {
                        ProgressView()
                    } else {
                        Text("ارسال")
                    }
                }
                .buttonStyle(.borderedProminent)
                .controlSize(.large)
            }

            Section("۹. سوییچ (تنظیمات رسمی اپل)") {
                Toggle("حالت شب", isOn: $isOn)
            }

            Section("۱۰. انتخاب‌گر تکه‌ای (Segmented — رسمی اپل)") {
                Picker("فیلتر", selection: $selectedSegment) {
                    Text("همه").tag(0)
                    Text("کلمات").tag(1)
                    Text("جملات").tag(2)
                }
                .pickerStyle(.segmented)
            }

            Section("۱۱. اندازه‌ها") {
                Button("کوچک") {}.buttonStyle(.borderedProminent).controlSize(.small)
                Button("متوسط") {}.buttonStyle(.borderedProminent).controlSize(.regular)
                Button("بزرگ") {}.buttonStyle(.borderedProminent).controlSize(.large)
            }
        }
        .navigationTitle("نمونهٔ دکمه‌ها")
    }
}

