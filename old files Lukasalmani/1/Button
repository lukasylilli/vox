import SwiftUI

/// نمایش نمونهٔ هدر، جستجو، انتخاب‌گر سطح، لیست‌ها و نوار پیشرفت — با اجزای رسمی اپل.
struct HeaderListShowcasePage: View {
    @State private var searchText = ""
    @State private var selectedLevel: String? = nil
    @State private var showLevelSheet = false

    private let levels = ["A1", "A2", "B1", "B2", "C1", "C2"]
    private let sampleWords = ["Haus", "Auto", "Schule", "Freund", "Wasser", "Buch"]

    var body: some View {
        List {
            // MARK: - ۱. انتخاب سطح (لیست کشویی شبیه تنظیمات اپل)
            Section("۱. انتخاب سطح (Navigation Link سبک تنظیمات)") {
                Button {
                    showLevelSheet = true
                } label: {
                    HStack {
                        Text("انتخاب سطح")
                            .foregroundStyle(.primary)
                        Spacer()
                        Text(selectedLevel ?? "همه")
                            .foregroundStyle(.secondary)
                        Image(systemName: "chevron.left")
                            .font(.caption)
                            .foregroundStyle(.tertiary)
                    }
                }
            }

            // MARK: - ۲. لیست ساده با آیکون
            Section("۲. لیست کلمات") {
                ForEach(sampleWords, id: \.self) { word in
                    HStack {
                        Image(systemName: "textformat")
                            .foregroundStyle(.blue)
                            .frame(width: 28)
                        Text(word)
                        Spacer()
                        Text("A1")
                            .font(.caption)
                            .padding(.horizontal, 8)
                            .padding(.vertical, 3)
                            .background(.blue.opacity(0.15))
                            .foregroundStyle(.blue)
                            .clipShape(Capsule())
                    }
                }
            }

            // MARK: - ۳. نوار پیشرفت خطی + درصد
            Section("۳. نوار پیشرفت (Progress Bar)") {
                VStack(alignment: .leading, spacing: 6) {
                    HStack {
                        Text("پیشرفت یادگیری")
                        Spacer()
                        Text("68%")
                            .foregroundStyle(.secondary)
                    }
                    ProgressView(value: 0.68)
                        .tint(.blue)
                }
                .padding(.vertical, 4)
            }

            // MARK: - ۴. پیشرفت دایره‌ای
            Section("۴. پیشرفت دایره‌ای") {
                HStack(spacing: 24) {
                    ForEach([("امروز", 0.4), ("هفته", 0.75), ("کل", 0.9)], id: \.0) { label, value in
                        VStack(spacing: 6) {
                            ZStack {
                                Circle()
                                    .stroke(.gray.opacity(0.2), lineWidth: 6)
                                Circle()
                                    .trim(from: 0, to: value)
                                    .stroke(.blue, style: StrokeStyle(lineWidth: 6, lineCap: .round))
                                    .rotationEffect(.degrees(-90))
                                Text("\(Int(value * 100))%")
                                    .font(.caption.bold())
                            }
                            .frame(width: 60, height: 60)
                            Text(label)
                                .font(.caption)
                                .foregroundStyle(.secondary)
                        }
                    }
                }
                .frame(maxWidth: .infinity)
                .padding(.vertical, 8)
            }

            // MARK: - ۵. کارت‌های آماری کنار هم
            Section("۵. کارت‌های آماری") {
                HStack(spacing: 12) {
                    statCard(title: "کلمات", value: "342", icon: "textformat.abc", color: .blue)
                    statCard(title: "روزهای پیاپی", value: "12", icon: "flame.fill", color: .orange)
                }
            }
        }
        .navigationTitle("Wortschatz")
        .navigationBarTitleDisplayMode(.large)
        .searchable(text: $searchText, prompt: "جستجوی کلمه...")
        .toolbar {
            ToolbarItem(placement: .topBarTrailing) {
                Menu {
                    Button("افزودن کلمه", systemImage: "plus") {}
                    Button("مرتب‌سازی", systemImage: "arrow.up.arrow.down") {}
                } label: {
                    Image(systemName: "ellipsis.circle")
                }
            }
        }
        .sheet(isPresented: $showLevelSheet) {
            levelPickerSheet
        }
    }

    // MARK: - شیت انتخاب سطح (باز شدن از پایین، سبک اپل)
    private var levelPickerSheet: some View {
        NavigationStack {
            List {
                Button {
                    selectedLevel = nil
                    showLevelSheet = false
                } label: {
                    HStack {
                        Text("همه")
                        Spacer()
                        if selectedLevel == nil {
                            Image(systemName: "checkmark").foregroundStyle(.blue)
                        }
                    }
                }
                ForEach(levels, id: \.self) { level in
                    Button {
                        selectedLevel = level
                        showLevelSheet = false
                    } label: {
                        HStack {
                            Text(level)
                            Spacer()
                            if selectedLevel == level {
                                Image(systemName: "checkmark").foregroundStyle(.blue)
                            }
                        }
                    }
                }
            }
            .navigationTitle("انتخاب سطح")
            .navigationBarTitleDisplayMode(.inline)
            .toolbar {
                ToolbarItem(placement: .topBarTrailing) {
                    Button("بستن") { showLevelSheet = false }
                }
            }
        }
        .presentationDetents([.medium])
    }

    @ViewBuilder
    private func statCard(title: String, value: String, icon: String, color: Color) -> some View {
        VStack(alignment: .leading, spacing: 8) {
            Image(systemName: icon)
                .foregroundStyle(color)
            Text(value)
                .font(.title2.bold())
            Text(title)
                .font(.caption)
                .foregroundStyle(.secondary)
        }
        .frame(maxWidth: .infinity, alignment: .leading)
        .padding(12)
        .background(Color(.secondarySystemGroupedBackground))
        .clipShape(RoundedRectangle(cornerRadius: 12))
    }
}

