import SwiftUI

/// نمایش کامل تمام سبک‌های دکمه با استفاده از APIهای رسمی SwiftUI/اپل.
/// هیچ شکل دستی‌کشیده‌ای اینجا نیست — همه از سیستم گرفته شده تا با هر آپدیت iOS خودکار به‌روز شود.
struct ButtonShowcasePage: View {
    @State private var isOn = false
    @State private var isLoading = false
    @State private var selectedSegment = 0
    @State private var sliderValue: Double = 50
    @State private var stepperValue = 1
    @State private var successTrigger = false

    var body: some View {
        List {
            // MARK: - ۱. دکمهٔ اصلی
            Section {
                Button("ادامه") { successTrigger.toggle() }
                    .buttonStyle(.borderedProminent)
                    .controlSize(.large)
                    .frame(maxWidth: .infinity)
                    .sensoryFeedback(.success, trigger: successTrigger)
            } header: {
                Text("۱. دکمهٔ اصلی (Primary)")
            } footer: {
                Text("برای مهم‌ترین اکشن صفحه — رنگ پررنگ سیستمی.")
            }

            // MARK: - ۲. دکمهٔ فرعی
            Section("۲. دکمهٔ فرعی (Secondary)") {
                Button("انصراف") {}
                    .buttonStyle(.bordered)
                    .controlSize(.large)
                    .frame(maxWidth: .infinity)
            }

            // MARK: - ۳. دکمهٔ متنی (بدون پس‌زمینه)
            Section("۳. دکمهٔ متنی (Plain)") {
                Button("بعداً") {}
                    .buttonStyle(.plain)
                    .foregroundStyle(.tint)
            }

            // MARK: - ۴. رنگ‌های سیستمی مختلف (tint)
            Section("۴. رنگ‌های سیستمی (Tint)") {
                HStack(spacing: 12) {
                    Button("آبی") {}.buttonStyle(.borderedProminent).tint(.blue)
                    Button("سبز") {}.buttonStyle(.borderedProminent).tint(.green)
                    Button("نارنجی") {}.buttonStyle(.borderedProminent).tint(.orange)
                }
            }

            // MARK: - ۵. دکمهٔ خطرناک (Destructive role)
            Section("۵. دکمهٔ خطرناک (Destructive)") {
                Button("حذف حساب کاربری", role: .destructive) {}
                    .buttonStyle(.bordered)
                    .frame(maxWidth: .infinity)
            }

            // MARK: - ۶. شکل کپسولی (Pill) — سبک اپ‌استور و پیام‌ها
            Section("۶. شکل کپسولی (Capsule)") {
                Button("دریافت") {}
                    .buttonStyle(.borderedProminent)
                    .buttonBorderShape(.capsule)
                    .controlSize(.regular)
            }

            // MARK: - ۷. دکمهٔ فقط آیکون (دایره‌ای)
            Section("۷. فقط آیکون") {
                HStack(spacing: 20) {
                    Button {} label: { Image(systemName: "plus") }
                        .buttonStyle(.borderedProminent)
                        .buttonBorderShape(.circle)
                        .controlSize(.large)

                    Button {} label: { Image(systemName: "heart.fill") }
                        .buttonStyle(.bordered)
                        .buttonBorderShape(.circle)
                        .tint(.red)

                    Button {} label: { Image(systemName: "trash") }
                        .buttonStyle(.borderless)
                        .foregroundStyle(.red)
                }
            }

            // MARK: - ۸. آیکون + متن (Label رسمی اپل)
            Section("۸. آیکون + متن") {
                Button {} label: {
                    Label("اشتراک‌گذاری", systemImage: "square.and.arrow.up")
                }
                .buttonStyle(.bordered)

                Button {} label: {
                    Label("دانلود", systemImage: "arrow.down.circle.fill")
                }
                .buttonStyle(.borderedProminent)
            }

            // MARK: - ۹. غیرفعال
            Section("۹. غیرفعال (Disabled)") {
                Button("غیرفعال") {}
                    .buttonStyle(.borderedProminent)
                    .disabled(true)
            }

            // MARK: - ۱۰. در حال بارگذاری
            Section("۱۰. در حال بارگذاری") {
                Button {
                    isLoading = true
                    DispatchQueue.main.asyncAfter(deadline: .now() + 1.5) { isLoading = false }
                } label: {
                    HStack {
                        if isLoading {
                            ProgressView()
                                .tint(.white)
                        }
                        Text(isLoading ? "در حال ارسال..." : "ارسال")
                    }
                    .frame(maxWidth: .infinity)
                }
                .buttonStyle(.borderedProminent)
                .controlSize(.large)
                .disabled(isLoading)
            }

            // MARK: - ۱۱. سوییچ رسمی اپل (Toggle)
            Section("۱۱. سوییچ (Toggle)") {
                Toggle("حالت شب", isOn: $isOn)
                Toggle(isOn: $isOn) {
                    Label("اعلان‌ها", systemImage: "bell.fill")
                }
            }

            // MARK: - ۱۲. انتخاب‌گر تکه‌ای (Segmented — دقیقاً سبک تنظیمات اپل)
            Section("۱۲. انتخاب‌گر تکه‌ای (Segmented)") {
                Picker("فیلتر", selection: $selectedSegment) {
                    Text("همه").tag(0)
                    Text("کلمات").tag(1)
                    Text("جملات").tag(2)
                }
                .pickerStyle(.segmented)
            }

            // MARK: - ۱۳. منوی کشویی (Menu — سبک آیفون)
            Section("۱۳. منوی کشویی (Menu)") {
                Menu {
                    Button("ویرایش", systemImage: "pencil") {}
                    Button("اشتراک‌گذاری", systemImage: "square.and.arrow.up") {}
                    Button("حذف", systemImage: "trash", role: .destructive) {}
                } label: {
                    Label("گزینه‌ها", systemImage: "ellipsis.circle")
                }
                .buttonStyle(.bordered)
            }

            // MARK: - ۱۴. استپر (+/-) رسمی اپل
            Section("۱۴. استپر عددی (Stepper)") {
                Stepper("تعداد: \(stepperValue)", value: $stepperValue, in: 1...10)
            }

            // MARK: - ۱۵. اسلایدر (لغزنده)
            Section("۱۵. لغزنده (Slider)") {
                Slider(value: $sliderValue, in: 0...100)
                Text("مقدار: \(Int(sliderValue))")
                    .font(.caption)
                    .foregroundStyle(.secondary)
            }

            // MARK: - ۱۶. اندازه‌های مختلف دکمه
            Section("۱۶. اندازه‌ها (Size)") {
                Button("کوچک") {}.buttonStyle(.borderedProminent).controlSize(.mini)
                Button("متوسط") {}.buttonStyle(.borderedProminent).controlSize(.small)
                Button("معمولی") {}.buttonStyle(.borderedProminent).controlSize(.regular)
                Button("بزرگ") {}.buttonStyle(.borderedProminent).controlSize(.large)
            }

            // MARK: - ۱۷. دکمهٔ شناور با سایهٔ سیستمی (FAB سبک اپل)
            Section("۱۷. دکمهٔ شناور (Floating Action)") {
                HStack {
                    Spacer()
                    Button {} label: {
                        Image(systemName: "plus")
                            .font(.title2.weight(.semibold))
                            .foregroundStyle(.white)
                            .frame(width: 56, height: 56)
                            .background(.tint, in: Circle())
                            .shadow(color: .black.opacity(0.25), radius: 8, y: 4)
                    }
                    Spacer()
                }
            }
        }
        .navigationTitle("نمونهٔ کامل دکمه‌ها")
        .navigationBarTitleDisplayMode(.inline)
    }
}

