import SwiftUI

struct ExerciseMatchingView: View {
    let exercise: GrammarExercise
    @ObservedObject var session: ExerciseSessionViewModel
    @State private var selectedLeft: String? = nil
    @State private var matchedPairs: Set<String> = []
    @State private var wrongAttempt: String? = nil
    @State private var showFeedback = false
    @EnvironmentObject private var languageManager: LanguageManager

    var body: some View {
        guard case .matching(let pairs) = exercise.payload else {
            return AnyView(EmptyView())
        }
        let rightShuffled = pairs.map { $0.right }.shuffled()

        return AnyView(
            VStack(alignment: .leading, spacing: AppSpacing.md) {
                Text(exercise.promptDE).font(AppFonts.title)

                HStack(alignment: .top, spacing: AppSpacing.lg) {
                    VStack(spacing: 8) {
                        ForEach(pairs, id: \.left) { pair in
                            Button {
                                guard !matchedPairs.contains(pair.left) else { return }
                                selectedLeft = pair.left
                            } label: {
                                Text(pair.left)
                                    .padding(8)
                                    .frame(maxWidth: .infinity)
                                    .background(matchedPairs.contains(pair.left) ? Color.green.opacity(0.3) : (selectedLeft == pair.left ? AppColors.accent.opacity(0.3) : AppColors.surfaceSecondary))
                                    .cornerRadius(8)
                            }
                        }
                    }
                    VStack(spacing: 8) {
                        ForEach(rightShuffled, id: \.self) { right in
                            Button {
                                guard let left = selectedLeft else { return }
                                let correctPair = pairs.first { $0.left == left }
                                if correctPair?.right == right {
                                    matchedPairs.insert(left)
                                    selectedLeft = nil
                                    if matchedPairs.count == pairs.count {
                                        showFeedback = true
                                    }
                                } else {
                                    wrongAttempt = right
                                    DispatchQueue.main.asyncAfter(deadline: .now() + 0.4) {
                                        wrongAttempt = nil
                                    }
                                }
                            } label: {
                                Text(right)
                                    .padding(8)
                                    .frame(maxWidth: .infinity)
                                    .background(wrongAttempt == right ? Color.red.opacity(0.3) : AppColors.surfacePrimary)
                                    .cornerRadius(8)
                            }
                        }
                    }
                }

                if showFeedback {
                    Text(languageManager.currentLanguage == .fa ? exercise.explanationAfterAnswerFA : exercise.explanationAfterAnswerEN)
                        .font(AppFonts.caption)
                    PrimaryButton(title: languageManager.currentLanguage == .fa ? "بعدی" : "Next") {
                        session.submitAnswer(isCorrect: true)
                        matchedPairs = []
                        showFeedback = false
                    }
                }
            }
            .padding(AppSpacing.md)
        )
    }
}

