import SwiftUI

struct LevelQuizPage: View {
    let level: Level

    @StateObject private var repository = GrammarRepository.shared
    @StateObject private var session = ExerciseSessionViewModel(lessonSlug: "__level_quiz__")
    @State private var configLoaded = false
    @EnvironmentObject private var languageManager: LanguageManager

    var body: some View {
        Group {
            if let current = session.currentExercise {
                switch current.type {
                case .multipleChoice:
                    ExerciseMultipleChoiceView(exercise: current, session: session)
                case .wordOrder:
                    ExerciseWordOrderView(exercise: current, session: session)
                case .matching:
                    ExerciseMatchingView(exercise: current, session: session)
                case .fillBlank:
                    ExerciseFillBlankView(exercise: current, session: session)
                case .transform:
                    ExerciseTransformView(exercise: current, session: session)
                }
            } else if session.isFinished {
                ExerciseResultView(session: session)
            } else {
                ProgressView()
            }
        }
        .navigationTitle(languageManager.currentLanguage == .fa ? "آزمون سطح \(level.rawValue)" : "\(level.rawValue) Quiz")
        .task {
            repository.loadAllIfNeeded()
            loadQuizExercises()
        }
    }

    private func loadQuizExercises() {
        guard !configLoaded else { return }
        configLoaded = true

        let questionsPerLevel = 10 // از level-quiz-config.json — می‌تواند بعداً دینامیک شود

        let lessonsForLevel = repository.lessons(for: level)
        var pool: [GrammarExercise] = []
        for lesson in lessonsForLevel {
            pool.append(contentsOf: repository.exercises(forLesson: lesson.slug))
        }

        session.exercises = Array(pool.shuffled().prefix(questionsPerLevel))
        session.currentIndex = 0
        session.correctCount = 0
        session.isFinished = session.exercises.isEmpty
    }
}

