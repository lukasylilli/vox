import Foundation

@MainActor
final class GrammarRepository: ObservableObject {
    static let shared = GrammarRepository()

    @Published private(set) var lessons: [GrammarLesson] = []
    @Published private(set) var exercises: [GrammarExercise] = []
    private(set) var isLoaded = false

    private init() {}

    func loadAllIfNeeded() {
        guard !isLoaded else { return }
        for category in GrammarCategory.allCases {
            loadCategory(category)
        }
        // فایل اضافی مرحلهٔ ۴ (Verben erweitert) و بقیهٔ فایل‌های چندگانه دستی اضافه می‌شوند:
        loadJSON(fileName: "verben-erweitert")
        loadJSON(fileName: "satzlehre-misc")
        loadJSON(fileName: "temporalsaetze")
        isLoaded = true
    }

    private func loadCategory(_ category: GrammarCategory) {
        loadJSON(fileName: category.jsonFileName)
    }

    private func loadJSON(fileName: String) {
        guard let url = Bundle.main.url(forResource: fileName, withExtension: "json", subdirectory: "JSON/Grammar")
                ?? Bundle.main.url(forResource: fileName, withExtension: "json") else {
            print("⚠️ GrammarRepository: فایل \(fileName).json پیدا نشد")
            return
        }
        do {
            let data = try Data(contentsOf: url)
            let container = try JSONDecoder().decode(GrammarFileContainer.self, from: data)
            lessons.append(contentsOf: container.lessons)
            exercises.append(contentsOf: container.exercises)
        } catch {
            print("⚠️ GrammarRepository: خطا در پارس \(fileName).json — \(error)")
        }
    }

    // MARK: - Query Helpers

    func lessons(for category: GrammarCategory) -> [GrammarLesson] {
        lessons.filter { $0.category == category }
    }

    func lessons(for level: Level) -> [GrammarLesson] {
        lessons.filter { $0.levels.contains(level) }
    }

    func lesson(slug: String) -> GrammarLesson? {
        lessons.first { $0.slug == slug }
    }

    func exercises(forLesson slug: String) -> [GrammarExercise] {
        exercises.filter { $0.lessonSlug == slug }
    }

    func relatedLessons(for lesson: GrammarLesson) -> [GrammarLesson] {
        lesson.relatedSlugs.compactMap { self.lesson(slug: $0) }
    }
}

/// هر فایل JSON یک دسته، شامل هم درس‌ها و هم تمرین‌های همان دسته
private struct GrammarFileContainer: Codable {
    var lessons: [GrammarLesson]
    var exercises: [GrammarExercise]
}

