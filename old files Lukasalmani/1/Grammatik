import Foundation

@MainActor
final class ExerciseSessionViewModel: ObservableObject {
    let lessonSlug: String
    @Published var exercises: [GrammarExercise] = []
    @Published var currentIndex: Int = 0
    @Published var correctCount: Int = 0
    @Published var isFinished: Bool = false

    var currentExercise: GrammarExercise? {
        guard currentIndex < exercises.count else { return nil }
        return exercises[currentIndex]
    }

    init(lessonSlug: String) {
        self.lessonSlug = lessonSlug
    }

    func load(from repository: GrammarRepository) {
        exercises = repository.exercises(forLesson: lessonSlug)
        currentIndex = 0
        correctCount = 0
        isFinished = exercises.isEmpty
    }

    func submitAnswer(isCorrect: Bool) {
        if isCorrect { correctCount += 1 }
        if currentIndex + 1 < exercises.count {
            currentIndex += 1
        } else {
            isFinished = true
        }
    }

    var scoreText: String {
        "\(correctCount) / \(exercises.count)"
    }
}

