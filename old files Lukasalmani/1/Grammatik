    @StateObject private var repository = GrammarRepository.shared
    @EnvironmentObject private var languageManager: LanguageManager

    private var lesson: GrammarLesson? {
        repository.lesson(slug: slug)
    }

    var body: some View {
        Group {
            if let lesson {
                ScrollView {
                    VStack(alignment: .leading, spacing: AppSpacing.lg) {
                        GrammarLessonHeaderView(lesson: lesson)

                        ForEach(lesson.explanationBlocks) { block in
                            GrammarExplanationView(block: block)
                        }

                        if let tables = lesson.tables {
                            ForEach(tables) { table in
                                if table.style == .interactiveGrid {
                                    GrammarInteractiveGridView(table: table)
                                } else {
                                    GrammarSimpleTableView(table: table)
                                }
                            }
                        }

                        ForEach(lesson.examples) { example in
                            GrammarExampleCardView(example: example)
                        }

                        if !lesson.exerciseSlugs.isEmpty {
                            NavigationLink {
                                GrammarExercisePage(lessonSlug: lesson.slug)
                            } label: {
                                PrimaryButton(title: languageManager.currentLanguage == .fa ? "شروع تمرین" : "Start Exercises")
                            }
                        }

                        if !lesson.relatedSlugs.isEmpty {
                            GrammarRelatedLessonsView(lesson: lesson)
                        }
                    }
                    .padding(AppSpacing.md)
                }
            } else {
                ProgressView()
                    .onAppear { repository.loadAllIfNeeded() }
            }
        }
        .task { repository.loadAllIfNeeded() }
    }
}

