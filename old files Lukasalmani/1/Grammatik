import Foundation

enum ExercisePayload: Codable, Hashable {
    case multipleChoice(options: [String], correctIndex: Int)
    case wordOrder(shuffledWords: [String], correctSentence: String)
    case matching(pairs: [MatchPair])
    case fillBlank(sentenceWithBlank: String, correctAnswer: String, alternatives: [String])
    case transform(sourceSentence: String, instructionDE: String, instructionFA: String, instructionEN: String, correctAnswer: String)

    private enum CodingKeys: String, CodingKey {
        case type, options, correctIndex, shuffledWords, correctSentence,
             pairs, sentenceWithBlank, correctAnswer, alternatives,
             sourceSentence, instructionDE, instructionFA, instructionEN
    }

    func encode(to encoder: Encoder) throws {
        var c = encoder.container(keyedBy: CodingKeys.self)
        switch self {
        case .multipleChoice(let options, let correctIndex):
            try c.encode("multipleChoice", forKey: .type)
            try c.encode(options, forKey: .options)
            try c.encode(correctIndex, forKey: .correctIndex)
        case .wordOrder(let words, let sentence):
            try c.encode("wordOrder", forKey: .type)
            try c.encode(words, forKey: .shuffledWords)
            try c.encode(sentence, forKey: .correctSentence)
        case .matching(let pairs):
            try c.encode("matching", forKey: .type)
            try c.encode(pairs, forKey: .pairs)
        case .fillBlank(let sentence, let answer, let alts):
            try c.encode("fillBlank", forKey: .type)
            try c.encode(sentence, forKey: .sentenceWithBlank)
            try c.encode(answer, forKey: .correctAnswer)
            try c.encode(alts, forKey: .alternatives)
        case .transform(let source, let dDE, let dFA, let dEN, let answer):
            try c.encode("transform", forKey: .type)
            try c.encode(source, forKey: .sourceSentence)
            try c.encode(dDE, forKey: .instructionDE)
            try c.encode(dFA, forKey: .instructionFA)
            try c.encode(dEN, forKey: .instructionEN)
            try c.encode(answer, forKey: .correctAnswer)
        }
    }

    init(from decoder: Decoder) throws {
        let c = try decoder.container(keyedBy: CodingKeys.self)
        let type = try c.decode(String.self, forKey: .type)
        switch type {
        case "multipleChoice":
            self = .multipleChoice(
                options: try c.decode([String].self, forKey: .options),
                correctIndex: try c.decode(Int.self, forKey: .correctIndex))
        case "wordOrder":
            self = .wordOrder(
                shuffledWords: try c.decode([String].self, forKey: .shuffledWords),
                correctSentence: try c.decode(String.self, forKey: .correctSentence))
        case "matching":
            self = .matching(pairs: try c.decode([MatchPair].self, forKey: .pairs))
        case "fillBlank":
            self = .fillBlank(
                sentenceWithBlank: try c.decode(String.self, forKey: .sentenceWithBlank),
                correctAnswer: try c.decode(String.self, forKey: .correctAnswer),
                alternatives: try c.decode([String].self, forKey: .alternatives))
        case "transform":
            self = .transform(
                sourceSentence: try c.decode(String.self, forKey: .sourceSentence),
                instructionDE: try c.decode(String.self, forKey: .instructionDE),
                instructionFA: try c.decode(String.self, forKey: .instructionFA),
                instructionEN: try c.decode(String.self, forKey: .instructionEN),
                correctAnswer: try c.decode(String.self, forKey: .correctAnswer))
        default:
            throw DecodingError.dataCorruptedError(forKey: .type, in: c, debugDescription: "Unknown ExercisePayload type: \(type)")
        }
    }
}

