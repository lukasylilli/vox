import SwiftUI

struct ExerciseResultView: View {
    @ObservedObject var session: ExerciseSessionViewModel
    @EnvironmentObject private var languageManager: LanguageManager
    @Environment(\.dismiss) private var dismiss

    private var scoreRatio: Double {
        guard !session.exercises.isEmpty else { return 0 }
        return Double(session.correctCount) / Double(session.exercises.count)
    }

    var body: some View {
        VStack(spacing: AppSpacing.lg) {
            Text(languageManager.currentLanguage == .fa ? "نتیجهٔ تمرین" : "Exercise Result")
                .font(AppFonts.title)

            CircularProgressView(progress: scoreRatio)
                .frame(width: 120, height: 120)

            Text(session.scoreText)
                .font(AppFonts.title.bold())

            Text(scoreRatio >= 0.7
                 ? (languageManager.currentLanguage == .fa ? "آفرین! خوب پیش رفتی 🎉" : "Great job! 🎉")
                 : (languageManager.currentLanguage == .fa ? "دوباره تمرین کن تا بهتر شود." : "Practice again to improve."))
                .font(AppFonts.body)
                .foregroundColor(AppColors.textSecondary)

            PrimaryButton(title: languageManager.currentLanguage == .fa ? "بازگشت به درس" : "Back to Lesson") {
                dismiss()
            }
        }
        .padding(AppSpacing.lg)
    }
}

