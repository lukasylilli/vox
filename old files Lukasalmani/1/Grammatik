                Divider()

                // کلمات در دسترس
                FlowLayoutWordOrder(words: availableWords) { word, index in
                    Button {
                        guard !showFeedback else { return }
                        availableWords.remove(at: index)
                        chosenWords.append(word)
                    } label: {
                        Text(word)
                            .padding(8)
                            .background(AppColors.surfacePrimary)
                            .cornerRadius(8)
                    }
                }

                if showFeedback {
                    Text(isCorrect ? "✅" : "❌  \(correctSentence)")
                    Text(languageManager.currentLanguage == .fa ? exercise.explanationAfterAnswerFA : exercise.explanationAfterAnswerEN)
                        .font(AppFonts.caption)
                    PrimaryButton(title: languageManager.currentLanguage == .fa ? "بعدی" : "Next") {
                        session.submitAnswer(isCorrect: isCorrect)
                        resetForNext()
                    }
                } else {
                    PrimaryButton(title: languageManager.currentLanguage == .fa ? "بررسی" : "Check") {
                        let built = chosenWords.joined(separator: " ")
                        isCorrect = built.trimmingCharacters(in: .whitespaces) == correctSentence.trimmingCharacters(in: .whitespacesAndPunctuationCharacters())
                        showFeedback = true
                    }
                    .disabled(chosenWords.isEmpty)
                }
            }
            .padding(AppSpacing.md)
            .onAppear {
                if availableWords.isEmpty && chosenWords.isEmpty {
                    availableWords = shuffled
                }
            }
        )
    }

    private func resetForNext() {
        showFeedback = false
        chosenWords = []
        availableWords = []
    }
}

/// چیدمان سادهٔ Flow برای نمایش کلمات به‌صورت افقی با شکستن خط
private struct FlowLayoutWordOrder: View {
    let words: [String]
    let content: (String, Int) -> Button<Text>

    var body: some View {
        // ساده‌سازی: HStack با wrap دستی از طریق LazyVGrid
        LazyVGrid(columns: [GridItem(.adaptive(minimum: 60))], alignment: .leading, spacing: 8) {
            ForEach(Array(words.enumerated()), id: \.offset) { index, word in
                content(word, index)
            }
        }
    }
}

private extension String {
    func trimmingCharacters(in set: CharacterSet, andPunctuation: Bool) -> String {
        self
    }
    func trimmingCharacters(in set: CharacterSet) -> String {
        (self as NSString).trimmingCharacters(in: set)
    }
}

private extension CharacterSet {
    static func whitespacesAndPunctuationCharacters() -> CharacterSet {
        CharacterSet.whitespaces.union(.punctuationCharacters)
    }
}

