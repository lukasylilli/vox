import SwiftUI

struct ExerciseMultipleChoiceView: View {
    let exercise: GrammarExercise
    @ObservedObject var session: ExerciseSessionViewModel
    @State private var selected: Int? = nil
    @State private var showFeedback = false
    @EnvironmentObject private var languageManager: LanguageManager

    var body: some View {
        guard case .multipleChoice(let options, let correctIndex) = exercise.payload else {
            return AnyView(EmptyView())
        }
        return AnyView(
            VStack(alignment: .leading, spacing: AppSpacing.md) {
                Text(exercise.promptDE).font(AppFonts.title)
                ForEach(Array(options.enumerated()), id: \.offset) { idx, option in
                    Button {
                        guard !showFeedback else { return }
                        selected = idx
                        showFeedback = true
                    } label: {
                        Text(option)
                            .frame(maxWidth: .infinity, alignment: .leading)
                            .padding()
                            .background(selected == idx ? (idx == correctIndex ? Color.green.opacity(0.3) : Color.red.opacity(0.3)) : AppColors.surfaceSecondary)
                            .cornerRadius(10)
                    }
                    .disabled(showFeedback)
                }
                if showFeedback {
                    Text(languageManager.currentLanguage == .fa ? exercise.explanationAfterAnswerFA : exercise.explanationAfterAnswerEN)
                        .font(AppFonts.caption)
                        .foregroundColor(AppColors.textSecondary)
                    PrimaryButton(title: languageManager.currentLanguage == .fa ? "بعدی" : "Next") {
                        session.submitAnswer(isCorrect: selected == correctIndex)
                        selected = nil
                        showFeedback = false
                    }
                }
            }
            .padding(AppSpacing.md)
        )
    }
}

