import SwiftUI

struct GrammarExercisePage: View {
    let lessonSlug: String

    @StateObject private var repository = GrammarRepository.shared
    @StateObject private var session: ExerciseSessionViewModel

    init(lessonSlug: String) {
        self.lessonSlug = lessonSlug
        _session = StateObject(wrappedValue: ExerciseSessionViewModel(lessonSlug: lessonSlug))
    }

    var body: some View {
        Group {
            if let current = session.currentExercise {
                switch current.type {
                case .multipleChoice:
                    ExerciseMultipleChoiceView(exercise: current, session: session)
                case .wordOrder:
                    ExerciseWordOrderView(exercise: current, session: session)
                case .matching:
                    ExerciseMatchingView(exercise: current, session: session)
                case .fillBlank:
                    ExerciseFillBlankView(exercise: current, session: session)
                case .transform:
                    ExerciseTransformView(exercise: current, session: session)
                }
            } else if session.isFinished {
                ExerciseResultView(session: session)
            } else {
                ProgressView()
            }
        }
        .task {
            repository.loadAllIfNeeded()
            session.load(from: repository)
        }
    }
}

