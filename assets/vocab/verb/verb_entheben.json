  "uebersetzung": {
    "fa": [
      "(رسمی) (کسی را از مقام یا وظیفه‌ای) برکنار کردن، معاف کردن"
    ],
    "en": [
      "(formal) to relieve (of an office or duty), to remove"
    ]
  },
  "niveau": "C2",
  "themen": [
    "Politik",
    "Recht",
    "Arbeit"
