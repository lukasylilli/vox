    {
      "niveau": "A2",
      "satz": "Man enthebt ihn seines Amtes.",
      "uebersetzung": {
        "fa": "او را از مقامش برکنار می‌کنند.",
        "en": "He is being removed from office."
      }
    },
    {
      "niveau": "B2",
      "satz": "Nachdem der Skandal bekannt wurde, wurde der Direktor mit sofortiger Wirkung seines Postens enthoben.",
      "uebersetzung": {
        "fa": "پس از اینکه رسوایی علنی شد، مدیر بلافاصله از سمتش برکنار شد.",
        "en": "After the scandal became known, the director was relieved of his post with immediate effect."
      }
    }
