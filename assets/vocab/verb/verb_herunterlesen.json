  "wort": "herunterlesen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(متنی را) یکنواخت و بی‌حوصله از رو خواندن"
    ],
    "en": [
      "to read out monotonously, to rattle off"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Kommunikation",
    "Schule"
  ],
  "ipa": "hɛˈʁʊntɐˌleːzn̩",
