  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Er liest den Text nur herunter.",
      "uebersetzung": {
        "fa": "او متن را فقط از رو می‌خواند.",
        "en": "He just reads the text out."
      }
    },
    {
      "niveau": "B2",
      "satz": "Der Redner hat seinen Vortrag ohne Pause heruntergelesen, und viele Zuhörer sind eingeschlafen.",
      "uebersetzung": {
        "fa": "سخنران سخنرانی‌اش را بی‌وقفه و یکنواخت از رو خواند و بسیاری از شنوندگان خوابشان برد.",
        "en": "The speaker read out his talk without a break, and many listeners fell asleep."
      }
    }
  ],
