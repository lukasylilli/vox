{
  "schema": "3.0",
  "id": "verb_reihen",
  "wort": "reihen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(چیزها را) پشت سر هم ردیف کردن، به رشته کشیدن",
      "(sich reihen) پشت سر هم آمدن"
    ],
    "en": [
      "to string, to line up",
      "(sich) to follow one after another"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Handwerk",
    "Sprache (gehoben)"
  ],
  "ipa": "ˈʁaɪ̯ən",
  "anmerkung": "In der Verbliste unter den unregelmäßigen Verben; heute regelmäßig (reihte, gereiht). Die starken Formen (rieh, geriehen) gelten nur im Sinn «mit großen Stichen nähen» und sind veraltet.",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Sie reiht Perlen auf eine Schnur.",
      "uebersetzung": {
        "fa": "او مرواریدها را به نخ می‌کشد.",
        "en": "She is stringing pearls onto a thread."
      }
    },
    {
      "niveau": "B2",
      "satz": "In diesem Sommer reihte sich ein Hitzetag an den anderen, und es regnete kaum.",
      "uebersetzung": {
        "fa": "این تابستان روزهای گرم پشت سر هم می‌آمدند و تقریباً باران نمی‌بارید.",
        "en": "This summer one hot day followed another, and it hardly rained."
      }
    }
  ],
  "synonyme": [
    {
      "wort": "aufreihen",
      "uebersetzung": {
        "fa": "ردیف کردن",
        "en": "to line up"
      }
    },
    {
      "wort": "aneinanderreihen",
      "uebersetzung": {
        "fa": "پشت سر هم چیدن",
        "en": "to string together"
      }
    }
  ],
