  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "افتادن، واژگون شدن",
      "(محاوره) از حال رفتن، غش کردن",
      "(محاوره) نظر خود را عوض کردن، کوتاه آمدن"
    ],
    "en": [
      "to fall over",
      "(colloquial) to collapse, to pass out",
      "(colloquial) to cave in, to change one's mind"
    ]
  },
  "niveau": "A2",
  "themen": [
    "Alltag"
  ],
  "ipa": "ˈʊmˌfalən",
  "anmerkung": "Übertragen (ugs.): «Er ist im letzten Moment umgefallen» = hat nachgegeben, seine Meinung geändert.",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Die Vase ist umgefallen.",
      "uebersetzung": {
        "fa": "گلدان افتاد.",
        "en": "The vase fell over."
      }
    },
    {
      "niveau": "B2",
      "satz": "Als der Sturm stärker wurde, fiel der alte Baum vor unserem Haus um.",
      "uebersetzung": {
        "fa": "وقتی طوفان شدیدتر شد، درخت پیر جلوی خانه‌مان افتاد.",
        "en": "When the storm got stronger, the old tree in front of our house fell over."
      }
    }
  ],
