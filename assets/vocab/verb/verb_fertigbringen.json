{
  "schema": "3.0",
  "id": "verb_fertigbringen",
  "wort": "fertigbringen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "از پس (کاری) برآمدن، توانستن",
      "(در نفی) دلِ (کاری را) داشتن"
    ],
    "en": [
      "to manage, to bring oneself to do",
      "(negated) not to have the heart to"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Alltag",
    "Gefühle"
  ],
  "ipa": "ˈfɛʁtɪçˌbʁɪŋən",
  "anmerkung": "Gemischtes Verb: brachte fertig, fertiggebracht.",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Das bringe ich nicht fertig.",
      "uebersetzung": {
        "fa": "دلش را ندارم (از عهده‌اش برنمی‌آیم).",
        "en": "I can't bring myself to do that."
      }
    },
    {
      "niveau": "B2",
      "satz": "Er hat es nicht fertiggebracht, ihr die Wahrheit zu sagen, weil er sie nicht verletzen wollte.",
      "uebersetzung": {
        "fa": "دلش را نداشت حقیقت را به او بگوید، چون نمی‌خواست دلش را بشکند.",
        "en": "He couldn't bring himself to tell her the truth because he didn't want to hurt her."
      }
    }
  ],
