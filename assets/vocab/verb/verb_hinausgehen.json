    "fa": [
      "بیرون رفتن",
      "(über etwas hinausgehen) از (حدی) فراتر رفتن",
      "(پنجره یا اتاقی) رو به (جایی) بودن"
    ],
    "en": [
      "to go out",
      "(über etw) to go beyond, to exceed",
      "to face, to look out onto"
    ]
  },
  "niveau": "B1",
