  "id": "verb_heilighalten",
  "wort": "heilighalten",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(ادبی) (روز، سنت یا چیزی را) مقدس شمردن و پاس داشتن"
    ],
    "en": [
      "(literary) to keep holy, to hold sacred"
    ]
  },
  "niveau": "C2",
  "themen": [
    "Religion",
    "Tradition"
  ],
  "ipa": "ˈhaɪ̯lɪçˌhaltn̩",
  "anmerkung": "Gehoben.",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Sie halten den Sonntag heilig.",
      "uebersetzung": {
        "fa": "آن‌ها یکشنبه را مقدس می‌شمارند.",
        "en": "They keep Sunday holy."
      }
    },
    {
      "niveau": "B2",
      "satz": "Für meinen Großvater war das gemeinsame Abendessen mit der Familie etwas, das er immer heiliggehalten hat.",
      "uebersetzung": {
        "fa": "برای پدربزرگم شام خوردن با خانواده چیزی بود که همیشه مقدس می‌شمرد.",
        "en": "For my grandfather, dinner together with the family was something he always held sacred."
      }
    }
  ],
