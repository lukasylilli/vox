  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(دوباره) درباره‌ی چیزی فکر کردن، بازنگری کردن"
    ],
    "en": [
      "to reconsider",
      "to think over"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Arbeit",
    "Kommunikation"
  ],
  "ipa": "yːbɐˈdɛŋkn̩",
  "anmerkung": "Untrennbar, gemischtes Verb (überdachte, überdacht).",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Ich überdenke meine Entscheidung.",
      "uebersetzung": {
        "fa": "درباره‌ی تصمیمم دوباره فکر می‌کنم.",
        "en": "I'm reconsidering my decision."
      }
    },
    {
      "niveau": "B2",
      "satz": "Nachdem ich alles noch einmal überdacht hatte, habe ich das Angebot doch angenommen.",
      "uebersetzung": {
        "fa": "بعد از آنکه دوباره همه‌چیز را سنجیدم، پیشنهاد را بالاخره پذیرفتم.",
        "en": "After I had thought everything over again, I accepted the offer after all."
      }
    }
  ],
