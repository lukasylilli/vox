  "id": "verb_festlaufen",
  "wort": "festlaufen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(sich festlaufen) (کار، مذاکره یا حمله‌ای) متوقف شدن، به بن‌بست خوردن"
    ],
    "en": [
      "(sich) to come to a standstill, to get bogged down"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Politik",
    "Arbeit",
    "Sport"
  ],
