  "anmerkung": null,
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Das Gespräch hat sich festgelaufen.",
      "uebersetzung": {
        "fa": "گفت‌وگو به بن‌بست رسید.",
        "en": "The talks came to a standstill."
      }
    },
    {
      "niveau": "B2",
      "satz": "Der Angriff der Mannschaft lief sich immer wieder an der starken Abwehr fest.",
      "uebersetzung": {
        "fa": "حمله‌های تیم بارها و بارها پشت دفاع قوی حریف متوقف شد.",
        "en": "The team's attack kept getting bogged down against the strong defence."
      }
    }
  ],
