  "uebersetzung": {
    "fa": [
      "(از خطر یا مجازاتی) گریختن، رهایی یافتن",
      "از چشم (کسی) پنهان ماندن، (فرصتی) از دست رفتن"
    ],
    "en": [
      "to escape, to avoid",
      "to escape (someone's notice), to miss out on"
    ]
  },
  "niveau": "B2",
