  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Ihm entgeht nichts.",
      "uebersetzung": {
        "fa": "هیچ چیز از چشمش پنهان نمی‌ماند.",
        "en": "Nothing escapes him."
      }
    },
    {
      "niveau": "B2",
      "satz": "Nur knapp ist der Fahrer einem schweren Unfall entgangen, weil er rechtzeitig gebremst hat.",
      "uebersetzung": {
        "fa": "راننده تنها با فاصله‌ی کمی از یک تصادف سخت جان به در برد، چون به‌موقع ترمز کرد.",
        "en": "The driver only narrowly escaped a serious accident because he braked in time."
      }
    }
