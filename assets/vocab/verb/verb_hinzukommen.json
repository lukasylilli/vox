  "id": "verb_hinzukommen",
  "wort": "hinzukommen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(به جمعی) پیوستن، از راه رسیدن",
      "(به آنچه هست) اضافه شدن («hinzu kommt, dass …» = به این‌ها اضافه کن که …)"
    ],
    "en": [
      "to join, to arrive",
      "to be added («hinzu kommt, dass …» = on top of that …)"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Kommunikation",
    "Alltag"
  ],
  "ipa": "hɪnˈt͡suːˌkɔmən",
  "anmerkung": null,
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Später kommen noch zwei Gäste hinzu.",
      "uebersetzung": {
        "fa": "بعداً دو مهمان دیگر هم اضافه می‌شوند.",
        "en": "Later two more guests will join."
      }
    },
    {
      "niveau": "B2",
      "satz": "Die Wohnung ist zu klein; hinzu kommt, dass die Miete viel zu hoch ist.",
      "uebersetzung": {
        "fa": "آپارتمان خیلی کوچک است؛ به این اضافه کن که اجاره‌اش هم خیلی بالاست.",
        "en": "The flat is too small; on top of that, the rent is far too high."
      }
    }
  ],
