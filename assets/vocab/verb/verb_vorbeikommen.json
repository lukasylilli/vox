    "fa": [
      "سر زدن، به دیدن کسی آمدن",
      "از کنار (چیزی) رد شدن",
      "(از مانع) عبور کردن"
    ],
    "en": [
      "to drop by",
      "to come past",
      "to get past"
    ]
  },
