  "uebersetzung": {
    "fa": [
      "(دوان یا پیاده) به اینجا آمدن",
      "(hinter jemandem herlaufen) دنبال (کسی) دویدن؛ (محاوره) به (کسی) آویزان شدن"
    ],
    "en": [
      "to run here, to come running",
      "(hinter jdm) to run after; (colloquial) to chase after"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Bewegung",
    "Beziehungen"
