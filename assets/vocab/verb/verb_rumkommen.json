  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(محاوره) جاهای زیادی رفتن، زیاد سفر کردن",
      "(محاوره) (از چیزی ناخوشایند) قسر در رفتن"
    ],
    "en": [
      "(colloquial) to get around",
      "(colloquial) to get out of (sth)"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Umgangssprache",
    "Reisen"
  ],
  "ipa": "ˈʁʊmˌkɔmən",
  "anmerkung": "Umgangssprachlich; Standard: «herumkommen».",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Als Pilot kommt er viel rum.",
      "uebersetzung": {
        "fa": "او به‌عنوان خلبان جاهای زیادی می‌رود.",
        "en": "As a pilot, he gets around a lot."
      }
    },
    {
      "niveau": "B2",
      "satz": "Ich weiß, dass ich um die Prüfung nicht rumkomme, also lerne ich jetzt.",
      "uebersetzung": {
        "fa": "می‌دانم که از امتحان راه فراری ندارم، پس الان درس می‌خوانم.",
        "en": "I know I can't get out of the exam, so I'm studying now."
      }
    }
  ],
