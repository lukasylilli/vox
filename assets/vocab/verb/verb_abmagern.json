  "anmerkung": "Trennbar (magerte ab, abgemagert), Perfekt mit «sein». Partizip «abgemagert» oft adjektivisch.",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Der Hund ist stark abgemagert.",
      "uebersetzung": {
        "fa": "سگ خیلی لاغر شده است.",
        "en": "The dog has become very thin."
      }
    },
    {
      "niveau": "B2",
      "satz": "Weil er wochenlang krank war, ist er bis auf die Knochen abgemagert.",
      "uebersetzung": {
        "fa": "چون هفته‌ها بیمار بود، پوست و استخوان شده است.",
        "en": "Because he was ill for weeks, he has become skin and bones."
      }
    }
  ],
