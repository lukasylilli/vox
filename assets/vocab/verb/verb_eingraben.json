  "uebersetzung": {
    "fa": [
      "(در خاک) چال کردن، دفن کردن",
      "(sich eingraben) در خاک فرو رفتن؛ در ذهن حک شدن"
    ],
    "en": [
      "to bury, to dig in",
      "(sich) to dig in; to become engraved (in memory)"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Natur",
    "Garten"
  ],
