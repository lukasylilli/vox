  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(es liegt jemandem fern) (کسی) قصد (کاری را) نداشتن، از (کسی) بعید بودن",
      "(فکر یا گمانی) دور از ذهن بودن"
    ],
    "en": [
      "(es liegt jdm fern) to be far from someone's mind/intention",
      "to be far-fetched"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Kommunikation",
    "Sprache (gehoben)"
  ],
  "ipa": "ˈfɛʁnˌliːɡn̩",
  "anmerkung": "Meist unpersönlich: «Es liegt mir fern, …»; in Süddeutschland und Österreich auch mit «sein».",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Das liegt mir fern.",
      "uebersetzung": {
        "fa": "چنین قصدی ندارم.",
        "en": "That is the last thing I want."
      }
    },
    {
      "niveau": "B2",
      "satz": "Es liegt mir fern, Sie zu kritisieren, aber der Bericht enthält einige Fehler.",
      "uebersetzung": {
        "fa": "قصد انتقاد از شما را ندارم، اما گزارش چند اشتباه دارد.",
        "en": "Far be it from me to criticise you, but the report contains a few mistakes."
      }
    }
  ],
