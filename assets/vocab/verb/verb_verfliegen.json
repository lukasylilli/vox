{
  "schema": "3.0",
  "id": "verb_verfliegen",
  "wort": "verfliegen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(بو/احساس) از بین رفتن، پریدن",
      "(زمان) به‌سرعت گذشتن",
      "(هواپیما) مسیر را گم کردن"
    ],
    "en": [
      "to evaporate, to fade (smell, feeling)",
      "to fly by (time)",
      "(sich) to lose one's way (plane)"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Gefühle",
    "Alltag"
  ],
  "ipa": "fɛɐ̯ˈfliːɡn̩",
  "anmerkung": "Untrennbar (verflog, verflogen). Mit «sein»; «sich verfliegen» (vom Kurs abkommen) mit «haben».",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Mein Ärger ist schnell verflogen.",
      "uebersetzung": {
        "fa": "عصبانیتم زود از بین رفت.",
        "en": "My anger quickly faded."
      }
    },
    {
      "niveau": "B2",
      "satz": "Die Ferien sind so schnell verflogen, dass ich kaum glauben kann, dass morgen die Schule beginnt.",
      "uebersetzung": {
        "fa": "تعطیلات آن‌قدر زود گذشت که باورم نمی‌شود فردا مدرسه شروع می‌شود.",
        "en": "The holidays flew by so fast that I can hardly believe school starts tomorrow."
      }
    }
  ],
  "synonyme": [
    {
      "wort": "vergehen",
      "uebersetzung": {
        "fa": "گذشتن، از بین رفتن",
