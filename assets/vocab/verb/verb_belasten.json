    ],
    "en": [
      "to burden",
      "to strain",
      "to pollute",
      "to debit"
    ]
  },
  "niveau": "B1",
  "themen": [
    "Gefühle",
    "Umwelt",
    "Finanzen"
  ],
  "ipa": "bəˈlastn̩",
