  "id": "verb_wegbekommen",
  "wort": "wegbekommen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "از بین بردن، پاک کردن (لکه و مانند آن)",
      "(با زحمت) جابه‌جا کردن، دور کردن"
    ],
    "en": [
      "to get rid of, to remove",
      "to get away, to shift"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Alltag",
    "Haushalt"
  ],
  "ipa": "ˈvɛkbəˌkɔmən",
  "anmerkung": "Trennbar (bekam weg, wegbekommen) — Partizip II ohne ge-. Umgangssprachlich. Kein üblicher Imperativ.",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Ich bekomme den Fleck nicht weg.",
      "uebersetzung": {
        "fa": "نمی‌توانم این لکه را پاک کنم.",
        "en": "I can't get the stain out."
      }
    },
    {
      "niveau": "B2",
      "satz": "Mit diesem Mittel haben wir den Rost endlich wegbekommen, nachdem nichts anderes geholfen hatte.",
      "uebersetzung": {
        "fa": "بعد از اینکه هیچ چیز دیگری فایده نداشت، با این ماده بالاخره زنگ‌زدگی را پاک کردیم.",
        "en": "With this product we finally got rid of the rust after nothing else had worked."
      }
    }
  ],
