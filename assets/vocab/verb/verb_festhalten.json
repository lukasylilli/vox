  "id": "verb_festhalten",
  "wort": "festhalten",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "محکم نگه داشتن، گرفتن",
      "(کسی را) نگه داشتن، (به‌اجبار) بازداشت کردن",
      "(چیزی را) ثبت کردن، یادداشت کردن",
      "(an etwas festhalten) به (چیزی) پایبند ماندن"
    ],
    "en": [
      "to hold (on to), to hold tight",
      "to detain",
      "to record, to note",
      "(an etwas) to stick to"
    ]
  },
  "niveau": "B1",
  "themen": [
    "Alltag",
    "Arbeit",
    "Recht"
  ],
  "ipa": "ˈfɛstˌhaltn̩",
  "anmerkung": null,
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Halt dich gut fest!",
      "uebersetzung": {
        "fa": "محکم بگیر (خودت را نگه دار)!",
        "en": "Hold on tight!"
      }
    },
    {
      "niveau": "B1",
      "satz": "Im Protokoll wird festgehalten, welche Medikamente der Patient bekommen hat.",
      "uebersetzung": {
        "fa": "در گزارش ثبت می‌شود که بیمار چه داروهایی گرفته است.",
        "en": "The record notes which medicines the patient received."
      }
    }
  ],
  "synonyme": [
