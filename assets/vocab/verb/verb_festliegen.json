  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(تاریخ، قاعده یا برنامه‌ای) قطعی و تعیین‌شده بودن",
      "(کشتی) به گل نشستن، گیر افتادن"
    ],
    "en": [
      "to be fixed, to be set (date, rules)",
      "to be stuck, to be aground"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Arbeit",
    "Behörde",
    "Verkehr"
  ],
  "ipa": "ˈfɛstˌliːɡn̩",
  "anmerkung": "In Süddeutschland und Österreich auch mit «sein».",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Der Termin liegt schon fest.",
      "uebersetzung": {
        "fa": "تاریخ (قرار) دیگر قطعی است.",
        "en": "The date is already fixed."
      }
    },
    {
      "niveau": "B2",
      "satz": "Wie hoch die Gebühren sind, liegt noch nicht fest, weil der Gemeinderat erst im Mai entscheidet.",
      "uebersetzung": {
        "fa": "هنوز قطعی نیست هزینه‌ها چقدر است، چون شورای شهر تازه در ماه مه تصمیم می‌گیرد.",
        "en": "How high the fees are is not yet fixed because the town council will only decide in May."
      }
    }
  ],
