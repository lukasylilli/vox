  "wort": "verkommen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "رو به خرابی رفتن، فرسوده شدن",
      "(اخلاقی) فاسد شدن، به انحطاط کشیده شدن",
      "(غذا) خراب شدن"
    ],
    "en": [
      "to go to ruin, to become run-down",
      "to go to the bad",
      "to go off (food)"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Gesellschaft",
    "Wohnen"
  ],
  "ipa": "fɛɐ̯ˈkɔmən",
  "anmerkung": "Untrennbar (verkam, verkommen). Partizip «verkommen» auch Adjektiv (= heruntergekommen).",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Das alte Haus verkommt.",
      "uebersetzung": {
        "fa": "خانه‌ی قدیمی دارد خراب می‌شود.",
        "en": "The old house is falling into ruin."
      }
    },
    {
      "niveau": "B2",
      "satz": "Weil niemand den Park pflegte, ist er in wenigen Jahren völlig verkommen.",
      "uebersetzung": {
        "fa": "چون کسی به پارک رسیدگی نمی‌کرد، ظرف چند سال کاملاً از ریخت افتاد.",
        "en": "Because nobody maintained the park, it became completely run-down within a few years."
      }
    }
  ],
