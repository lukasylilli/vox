  "uebersetzung": {
    "fa": [
      "(قانون، دستور یا فرمانی را) صادر کردن، وضع کردن",
      "(بدهی، جریمه یا وظیفه‌ای را) بخشیدن، معاف کردن"
    ],
    "en": [
      "to issue, to enact (a law, decree)",
      "to remit, to let off (a debt, penalty)"
    ]
  },
