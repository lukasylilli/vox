  "wort": "heranlassen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "اجازه‌ی نزدیک شدن دادن",
      "(کسی را به کاری یا چیزی) راه دادن، اجازه دادن"
    ],
    "en": [
      "to let (someone) come near",
      "to let (someone) at/near (something)"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Beziehungen",
    "Arbeit"
  ],
  "ipa": "hɛˈʁanˌlasn̩",
  "anmerkung": null,
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Der Hund lässt niemanden heran.",
      "uebersetzung": {
        "fa": "سگ اجازه نمی‌دهد کسی نزدیک شود.",
        "en": "The dog doesn't let anyone near."
      }
    },
    {
      "niveau": "B2",
      "satz": "Seit der Trennung lässt sie keinen Menschen mehr richtig an sich heran.",
      "uebersetzung": {
        "fa": "از وقتی جدا شده، دیگر به هیچ‌کس اجازه نمی‌دهد واقعاً به او نزدیک شود.",
        "en": "Since the separation she no longer really lets anyone get close to her."
      }
    }
  ],
