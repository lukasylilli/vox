  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Ich kam nicht umhin zu lachen.",
      "uebersetzung": {
        "fa": "نتوانستم جلوی خنده‌ام را بگیرم.",
        "en": "I couldn't help laughing."
      }
    },
    {
      "niveau": "B2",
      "satz": "Nach dem schweren Fehler wird der Minister nicht umhinkommen, sich öffentlich zu entschuldigen.",
      "uebersetzung": {
        "fa": "پس از این اشتباه بزرگ، وزیر چاره‌ای جز این نخواهد داشت که علناً عذرخواهی کند.",
        "en": "After the serious mistake, the minister will have no choice but to apologise publicly."
      }
    }
  ],
