    "fa": [
      "(موضوعی را به کسی) فهماندن، (کسی را با چیزی) آشنا کردن و به آن علاقه‌مند کردن"
    ],
    "en": [
      "to bring (something) home to someone, to introduce someone to"
    ]
  },
  "niveau": "C1",
