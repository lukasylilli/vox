{
  "schema": "3.0",
  "id": "verb_hinkommen",
  "wort": "hinkommen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(به جایی) رسیدن، آمدن",
      "(محاوره) (چیزی) جای خودش را داشتن، گذاشته شدن",
      "(محاوره) درست بودن، جور درآمدن؛ (با پول) سر کردن"
    ],
    "en": [
      "to get there",
      "(colloquial) to belong, to go (somewhere)",
      "(colloquial) to be right; to manage (with money)"
    ]
  },
  "niveau": "B1",
  "themen": [
    "Alltag",
    "Umgangssprache"
  ],
  "ipa": "ˈhɪnˌkɔmən",
  "anmerkung": null,
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Wo kommt das Glas hin?",
      "uebersetzung": {
        "fa": "لیوان کجا گذاشته می‌شود؟",
        "en": "Where does the glass go?"
      }
    },
    {
      "niveau": "B1",
      "satz": "Mit 1.500 Euro im Monat komme ich gerade so hin, aber für Urlaub reicht es nicht.",
      "uebersetzung": {
        "fa": "با ماهی ۱۵۰۰ یورو به‌زور سر می‌کنم، اما برای مرخصی کافی نیست.",
        "en": "I just about manage on 1,500 euros a month, but it isn't enough for a holiday."
      }
    }
  ],
