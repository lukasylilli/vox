  "id": "verb_nachempfinden",
  "wort": "nachempfinden",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(احساس کسی را) درک کردن، با (کسی) همدل بودن",
      "(اثری را) از روی (اثری دیگر) ساختن"
    ],
    "en": [
      "to empathise with, to understand (someone's feelings)",
      "to model (something) on"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Gefühle",
    "Kunst"
  ],
  "ipa": "ˈnaːxɛmpˌfɪndn̩",
  "anmerkung": null,
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Das kann ich gut nachempfinden.",
      "uebersetzung": {
        "fa": "این را خوب درک می‌کنم.",
        "en": "I can understand that well."
      }
    },
    {
      "niveau": "B2",
      "satz": "Wer selbst einmal ins Ausland gezogen ist, kann gut nachempfinden, wie einsam man sich am Anfang fühlt.",
      "uebersetzung": {
        "fa": "کسی که خودش یک بار به خارج رفته، خوب درک می‌کند آدم اوایل چقدر احساس تنهایی می‌کند.",
        "en": "Anyone who has moved abroad themselves can well understand how lonely you feel at first."
      }
    }
  ],
