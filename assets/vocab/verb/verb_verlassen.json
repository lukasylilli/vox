  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "ترک کردن، از (جایی) بیرون رفتن",
      "(کسی را) ترک کردن، تنها گذاشتن",
      "به (کسی/چیزی) اعتماد کردن"
    ],
    "en": [
      "to leave",
      "to abandon",
      "(sich) to rely on"
    ]
  },
  "niveau": "A2",
  "themen": [
    "Alltag",
    "Beziehungen"
  ],
  "ipa": "fɛɐ̯ˈlasn̩",
  "anmerkung": "Untrennbar (verließ, verlassen). Reflexiv: «sich auf jemanden verlassen» (= vertrauen). Partizip «verlassen» auch Adjektiv (= leer, einsam).",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Ich verlasse um acht Uhr das Haus.",
      "uebersetzung": {
        "fa": "ساعت هشت از خانه بیرون می‌روم.",
        "en": "I leave the house at eight."
      }
    },
    {
      "niveau": "B2",
      "satz": "Du kannst dich darauf verlassen, dass ich dir helfe, wenn du Probleme hast.",
      "uebersetzung": {
        "fa": "می‌توانی مطمئن باشی که اگر مشکلی داشتی، کمکت می‌کنم.",
        "en": "You can rely on me helping you if you have problems."
      }
    }
  ],
