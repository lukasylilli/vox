  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(فکر یا نتیجه‌ای) بدیهی بودن، به ذهن رسیدن"
    ],
    "en": [
      "to be obvious, to suggest itself"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Denken"
  ],
  "ipa": "ˈnaːəˌliːɡn̩",
  "anmerkung": "Oft als Partizip: «naheliegend» (= offensichtlich). In Süddeutschland und Österreich auch mit «sein».",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Die Lösung liegt nahe.",
      "uebersetzung": {
        "fa": "راه‌حل بدیهی است.",
        "en": "The solution is obvious."
      }
    },
    {
      "niveau": "B2",
      "satz": "Es liegt nahe, dass die Kopfschmerzen vom Schlafmangel kommen, aber wir sollten trotzdem untersuchen.",
      "uebersetzung": {
        "fa": "بدیهی به نظر می‌رسد که سردرد از کم‌خوابی باشد، اما با این حال باید معاینه کنیم.",
        "en": "It seems obvious that the headaches come from lack of sleep, but we should still examine you."
      }
    }
  ],
