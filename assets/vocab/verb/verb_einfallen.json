  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "به ذهن (کسی) رسیدن، یاد (کسی) آمدن",
      "(ساختمان) فرو ریختن؛ (به کشوری) یورش بردن",
      "(در آواز یا گفت‌وگو) همراه شدن"
    ],
    "en": [
      "to occur to, to come to mind",
      "to collapse; to invade",
      "to join in (singing, talking)"
    ]
  },
  "niveau": "B1",
  "themen": [
    "Denken",
    "Alltag"
  ],
