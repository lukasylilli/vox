{
  "schema": "3.0",
  "id": "verb_leiden",
  "wort": "leiden",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "رنج بردن، عذاب کشیدن",
      "(an einer Krankheit leiden) به (بیماری) مبتلا بودن",
      "(jemanden nicht leiden können) از (کسی) خوش نیامدن"
    ],
    "en": [
      "to suffer",
      "(an einer Krankheit) to suffer from",
      "(jdn nicht leiden können) not to be able to stand someone"
    ]
  },
  "niveau": "B1",
  "themen": [
    "Gesundheit",
    "Gefühle"
  ],
  "ipa": "ˈlaɪ̯dn̩",
  "anmerkung": null,
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Ich kann ihn nicht leiden.",
      "uebersetzung": {
        "fa": "از او خوشم نمی‌آید.",
        "en": "I can't stand him."
      }
    },
    {
      "niveau": "B1",
      "satz": "Viele Pflegekräfte leiden unter dem Stress und den unregelmäßigen Arbeitszeiten.",
      "uebersetzung": {
        "fa": "بسیاری از پرستاران از استرس و ساعت کاری نامنظم رنج می‌برند.",
        "en": "Many nursing staff suffer from the stress and the irregular working hours."
      }
    }
  ],
