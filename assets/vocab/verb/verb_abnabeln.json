  "id": "verb_abnabeln",
  "wort": "abnabeln",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "بند ناف را بریدن",
      "(از خانواده) مستقل شدن"
    ],
    "en": [
      "to cut the umbilical cord",
      "to become independent"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Familie",
    "Medizin"
  ],
  "ipa": "ˈapˌnaːbl̩n",
  "anmerkung": "Trennbar (nabelte ab, abgenabelt). Bildlich reflexiv: «sich von den Eltern abnabeln».",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Die Hebamme nabelt das Baby ab.",
      "uebersetzung": {
        "fa": "ماما بند ناف نوزاد را می‌برد.",
        "en": "The midwife cuts the baby's umbilical cord."
      }
    },
    {
      "niveau": "B2",
      "satz": "Mit zwanzig wollte er sich endlich von seinen Eltern abnabeln und zog in eine eigene Wohnung.",
      "uebersetzung": {
        "fa": "در بیست‌سالگی می‌خواست بالاخره از پدر و مادرش مستقل شود و به آپارتمان خودش رفت.",
        "en": "At twenty he finally wanted to cut the cord with his parents and moved into his own flat."
      }
    }
  ],
  "synonyme": [
    {
      "wort": "sich lösen",
      "uebersetzung": {
        "fa": "جدا شدن",
        "en": "to break free"
      }
    }
  ],
