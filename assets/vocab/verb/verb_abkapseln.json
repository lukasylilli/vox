  "id": "verb_abkapseln",
  "wort": "abkapseln",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(خود را) منزوی کردن، کناره گرفتن"
    ],
    "en": [
      "to isolate oneself",
      "to cut oneself off"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Gefühle",
    "Beziehungen"
  ],
  "ipa": "ˈapˌkapsl̩n",
  "anmerkung": "Trennbar, meist reflexiv: «sich abkapseln» (kapselte sich ab, hat sich abgekapselt).",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Er kapselt sich ab.",
      "uebersetzung": {
        "fa": "او خودش را منزوی می‌کند.",
        "en": "He is cutting himself off."
      }
    },
    {
      "niveau": "B2",
      "satz": "Seit sie ihren Job verloren hat, kapselt sie sich immer mehr von ihren Freunden ab.",
      "uebersetzung": {
        "fa": "از وقتی کارش را از دست داده، روزبه‌روز بیشتر از دوستانش کناره می‌گیرد.",
        "en": "Since she lost her job, she has been cutting herself off more and more from her friends."
      }
    }
  ],
  "synonyme": [
    {
      "wort": "sich zurückziehen",
      "uebersetzung": {
        "fa": "کناره گرفتن",
        "en": "to withdraw"
