  "id": "verb_festfahren",
  "wort": "festfahren",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(sich festfahren) (وسیله‌ی نقلیه) گیر کردن (در گل، برف و مانند آن)",
      "(مذاکره یا وضعی) به بن‌بست رسیدن"
    ],
    "en": [
      "(sich) to get stuck (vehicle)",
      "(sich) to reach deadlock"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Verkehr",
    "Politik"
  ],
  "ipa": "ˈfɛstˌfaːʁən",
  "anmerkung": "Meist reflexiv mit «haben» (Das Auto hat sich festgefahren); intransitiv auch mit «sein». Oft adjektivisch: «festgefahrene Verhandlungen».",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Das Auto hat sich im Schnee festgefahren.",
      "uebersetzung": {
        "fa": "ماشین در برف گیر کرد.",
        "en": "The car got stuck in the snow."
      }
    },
    {
      "niveau": "B2",
      "satz": "Die Verhandlungen haben sich festgefahren, weil keine Seite einen Kompromiss eingehen will.",
      "uebersetzung": {
        "fa": "مذاکرات به بن‌بست رسیده است، چون هیچ طرفی حاضر به سازش نیست.",
        "en": "The negotiations have reached deadlock because neither side wants to compromise."
      }
    }
  ],
  "synonyme": [
