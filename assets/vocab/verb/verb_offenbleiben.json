  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(سؤال یا موضوعی) بی‌پاسخ یا حل‌نشده ماندن"
    ],
    "en": [
      "to remain open, to remain unresolved"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Diskussion",
    "Arbeit"
  ],
  "ipa": "ˈɔfn̩ˌblaɪ̯bn̩",
  "anmerkung": "Im Sinn «unentschieden bleiben» zusammengeschrieben; wörtlich («Die Tür soll offen bleiben») meist getrennt.",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Die Frage bleibt offen.",
      "uebersetzung": {
        "fa": "سؤال بی‌پاسخ می‌ماند.",
        "en": "The question remains open."
      }
    },
    {
      "niveau": "B2",
      "satz": "Nach der langen Sitzung sind immer noch viele Punkte offengeblieben, die wir nächste Woche klären müssen.",
      "uebersetzung": {
        "fa": "بعد از آن جلسه‌ی طولانی هنوز نکات زیادی حل‌نشده مانده که باید هفته‌ی بعد روشن کنیم.",
        "en": "After the long meeting many points still remained open, which we have to clarify next week."
      }
    }
  ],
  "synonyme": [
