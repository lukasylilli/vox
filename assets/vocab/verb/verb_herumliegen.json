  "id": "verb_herumliegen",
  "wort": "herumliegen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(اشیا) بی‌نظم این طرف و آن طرف افتاده بودن",
      "(محاوره) (آدم) بیکار دراز کشیدن"
    ],
    "en": [
      "to lie around",
      "(colloquial) to lie about, to laze around"
    ]
  },
  "niveau": "B1",
  "themen": [
    "Haushalt",
    "Alltag"
  ],
  "ipa": "hɛˈʁʊmˌliːɡn̩",
  "anmerkung": "Umgangssprachlich oft «rum…». In Süddeutschland und Österreich auch mit «sein».",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Hier liegen überall Socken herum.",
      "uebersetzung": {
        "fa": "اینجا همه‌جا جوراب افتاده است.",
        "en": "There are socks lying around everywhere here."
      }
    },
    {
      "niveau": "B1",
      "satz": "Am Sonntag haben wir den ganzen Tag nur auf dem Sofa herumgelegen und Filme geschaut.",
      "uebersetzung": {
        "fa": "یکشنبه تمام روز فقط روی مبل دراز کشیدیم و فیلم دیدیم.",
        "en": "On Sunday we just lay around on the sofa all day watching films."
      }
    }
  ],
  "synonyme": [
