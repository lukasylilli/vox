    "fa": [
      "خرج (کسی را) دادن، بزرگ کردن",
      "(بیمار را) نجات دادن",
      "(قانون را) تصویب کردن",
      "(پول را) به باد دادن"
    ],
    "en": [
      "to support (a family)",
      "to pull through",
      "to get passed",
      "to squander"
    ]
  },
