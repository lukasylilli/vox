  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Er hat mir viel voraus.",
      "uebersetzung": {
        "fa": "او خیلی از من جلوتر است.",
        "en": "He is far ahead of me."
      }
    },
    {
      "niveau": "B2",
      "satz": "Sie hat den anderen Bewerbern voraus, dass sie schon im Ausland gearbeitet hat.",
      "uebersetzung": {
        "fa": "برتری او بر متقاضیان دیگر این است که قبلاً در خارج کار کرده است.",
        "en": "Her advantage over the other applicants is that she has already worked abroad."
      }
    }
  ],
