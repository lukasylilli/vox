  "id": "verb_herumlaufen",
  "wort": "herumlaufen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "این طرف و آن طرف راه رفتن یا دویدن، پرسه زدن",
      "(محاوره) (با ظاهری خاص) گشتن، ظاهر شدن"
    ],
    "en": [
      "to run around, to walk around",
      "(colloquial) to go around (dressed in a certain way)"
    ]
  },
  "niveau": "B1",
  "themen": [
    "Alltag",
    "Bewegung"
  ],
  "ipa": "hɛˈʁʊmˌlaʊ̯fn̩",
  "anmerkung": "Umgangssprachlich oft «rum…».",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Die Kinder laufen im Garten herum.",
      "uebersetzung": {
        "fa": "بچه‌ها در باغ این طرف و آن طرف می‌دوند.",
        "en": "The children are running around in the garden."
      }
    },
    {
      "niveau": "B1",
      "satz": "Er läuft schon seit Tagen mit derselben Jacke herum, obwohl sie ganz schmutzig ist.",
      "uebersetzung": {
        "fa": "چند روز است که با همان کاپشن می‌گردد، با اینکه کاملاً کثیف است.",
        "en": "He has been going around in the same jacket for days, although it is completely dirty."
      }
    }
  ],
  "synonyme": [
