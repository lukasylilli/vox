    "fa": [
      "(فقط منفی) (کسی را به‌خاطر کاری) سرزنش نکردن، به (کسی) حق دادن"
    ],
    "en": [
      "(only negated) not to blame (sb. for sth.)"
    ]
  },
  "niveau": "C1",
