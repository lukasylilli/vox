  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Ich kann es ihr nicht verdenken.",
      "uebersetzung": {
        "fa": "نمی‌توانم او را سرزنش کنم.",
        "en": "I can't blame her."
      }
    },
    {
      "niveau": "B2",
      "satz": "Niemand kann ihm verdenken, dass er nach so vielen Überstunden gekündigt hat.",
      "uebersetzung": {
        "fa": "هیچ‌کس نمی‌تواند او را سرزنش کند که بعد از این همه اضافه‌کاری استعفا داده است.",
        "en": "Nobody can blame him for quitting after so much overtime."
