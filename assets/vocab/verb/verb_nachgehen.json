  "uebersetzung": {
    "fa": [
      "دنبال (کسی) رفتن",
      "(موضوعی را) پیگیری کردن، بررسی کردن؛ (به کاری) پرداختن",
      "(ساعت) عقب بودن"
    ],
    "en": [
      "to follow",
      "to look into, to pursue; to pursue (an activity)",
      "(clock) to be slow"
    ]
  },
