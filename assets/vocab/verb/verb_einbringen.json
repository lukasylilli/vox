  "uebersetzung": {
    "fa": [
      "(سود یا پول) به همراه داشتن، عاید کردن",
      "(پیشنهاد یا لایحه‌ای را) ارائه کردن",
      "(sich einbringen) فعالانه مشارکت کردن؛ (محصول را) برداشت کردن"
    ],
    "en": [
      "to bring in, to yield",
      "to introduce (a proposal, bill)",
      "(sich) to get involved; to bring in (the harvest)"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Arbeit",
    "Politik",
    "Wirtschaft"
