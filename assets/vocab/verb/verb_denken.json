  "id": "verb_denken",
  "wort": "denken",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "فکر کردن",
      "(an etwas denken) به یاد چیزی بودن",
      "(über etwas denken) نظری داشتن"
    ],
    "en": [
      "to think",
      "to remember (an)",
      "to have an opinion (über)"
    ]
  },
  "niveau": "A1",
  "themen": [
    "Denken",
    "Kommunikation"
  ],
  "ipa": "ˈdɛŋkn̩",
  "anmerkung": null,
  "beispiele": [
    {
      "niveau": "A1",
      "satz": "Ich denke, er kommt morgen.",
      "uebersetzung": {
        "fa": "فکر می‌کنم او فردا می‌آید.",
        "en": "I think he's coming tomorrow."
      }
    },
    {
      "niveau": "B1",
      "satz": "Denk bitte daran, dass wir heute Abend bei meinen Eltern eingeladen sind.",
      "uebersetzung": {
        "fa": "لطفاً یادت باشد که امشب خانه‌ی پدر و مادرم دعوت داریم.",
        "en": "Please remember that we're invited to my parents' this evening."
      }
    }
  ],
  "synonyme": [
