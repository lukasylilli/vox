  "anmerkung": "Trennbar (klarte auf, aufgeklart). Vom Wetter, meist unpersönlich: «Es klart auf.»",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Am Abend klart es auf.",
      "uebersetzung": {
        "fa": "عصر هوا صاف می‌شود.",
        "en": "It clears up in the evening."
      }
    },
    {
      "niveau": "B2",
      "satz": "Laut Wetterbericht soll es morgen aufklaren, sodass wir endlich wandern können.",
      "uebersetzung": {
        "fa": "طبق پیش‌بینی، فردا هوا صاف می‌شود و بالاخره می‌توانیم پیاده‌روی کنیم.",
        "en": "According to the forecast it should clear up tomorrow so that we can finally go hiking."
      }
    }
  ],
