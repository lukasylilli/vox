    {
      "niveau": "A1",
      "satz": "Ich lade dich zum Essen ein.",
      "uebersetzung": {
        "fa": "تو را به غذا دعوت می‌کنم (مهمان من).",
        "en": "I'm inviting you to dinner (my treat)."
      }
    },
    {
      "niveau": "B1",
      "satz": "Sie hat alle Kollegen zu ihrer Geburtstagsparty eingeladen, obwohl ihre Wohnung sehr klein ist.",
      "uebersetzung": {
        "fa": "همه‌ی همکاران را به جشن تولدش دعوت کرد، با اینکه آپارتمانش خیلی کوچک است.",
        "en": "She invited all her colleagues to her birthday party, although her flat is very small."
      }
    }
  ],
