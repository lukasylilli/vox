  "uebersetzung": {
    "fa": [
      "دعوت کردن",
      "(کسی را) مهمان کردن، (پول چیزی را) حساب کردن",
      "بار زدن (در ماشین و مانند آن)"
    ],
    "en": [
      "to invite",
      "to treat (someone)",
      "to load (into)"
    ]
  },
  "niveau": "A1",
  "themen": [
    "Alltag",
    "Freizeit",
    "Feste"
