  "id": "verb_dazukommen",
  "wort": "dazukommen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "سر رسیدن، به جمع پیوستن",
      "اضافه شدن (به چیزی)",
      "(dazu kommen, etwas zu tun) فرصت کردن"
    ],
    "en": [
      "to arrive, to join",
      "to be added",
      "to get round to"
    ]
  },
  "niveau": "B1",
  "themen": [
    "Alltag",
    "Arbeit"
  ],
  "ipa": "daˈtsuːˌkɔmən",
  "anmerkung": null,
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Später kommt noch Anna dazu.",
      "uebersetzung": {
        "fa": "بعداً آنا هم به ما می‌پیوندد.",
        "en": "Anna will join us later."
      }
    },
    {
      "niveau": "B1",
      "satz": "Ich wollte dir eigentlich schreiben, aber ich bin leider nicht dazugekommen, weil so viel los war.",
      "uebersetzung": {
        "fa": "راستش می‌خواستم برایت بنویسم، ولی متأسفانه فرصت نکردم، چون خیلی سرم شلوغ بود.",
        "en": "I actually wanted to write to you, but unfortunately I didn't get round to it because there was so much going on."
      }
    }
  ],
