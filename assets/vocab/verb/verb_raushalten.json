  "id": "verb_raushalten",
  "wort": "raushalten",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(محاوره، sich raushalten) دخالت نکردن، کنار کشیدن",
      "(محاوره) (چیزی را) بیرون نگه داشتن"
    ],
    "en": [
      "(colloquial, sich) to stay out of it",
      "(colloquial) to hold out, to keep out"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Umgangssprache",
    "Konflikt"
  ],
  "ipa": "ˈʁaʊ̯sˌhaltn̩",
  "anmerkung": "Umgangssprachlich; Standard: «heraushalten».",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Halt dich da raus!",
      "uebersetzung": {
        "fa": "خودت را قاطی نکن!",
        "en": "Stay out of it!"
      }
    },
    {
      "niveau": "B2",
      "satz": "Bei Streit zwischen meinen Eltern halte ich mich lieber raus, sonst wird alles noch schlimmer.",
      "uebersetzung": {
        "fa": "وقتی پدر و مادرم دعوا می‌کنند ترجیح می‌دهم دخالت نکنم، وگرنه همه چیز بدتر می‌شود.",
        "en": "When my parents argue I prefer to stay out of it, otherwise everything gets even worse."
      }
    }
  ],
