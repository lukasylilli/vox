  "uebersetzung": {
    "fa": [
      "(ارزش یا ماهیت کسی/چیزی را) درست نشناختن، دست کم گرفتن"
    ],
    "en": [
      "to misjudge",
      "to fail to recognize, to underrate"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Gesellschaft",
    "Kunst"
  ],
  "ipa": "fɛɐ̯ˈkɛnən",
  "anmerkung": "Gemischtes Verb (verkannte, verkannt). Oft: «ein verkanntes Genie»; «nicht zu verkennen sein» (= deutlich sein).",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Viele verkennen die Gefahr.",
      "uebersetzung": {
        "fa": "خیلی‌ها خطر را دست کم می‌گیرند.",
        "en": "Many people misjudge the danger."
      }
    },
    {
      "niveau": "B2",
      "satz": "Der Maler wurde zu Lebzeiten verkannt, obwohl seine Bilder heute Millionen kosten.",
      "uebersetzung": {
        "fa": "آن نقاش در زمان حیاتش قدر دیده نشد، با این که تابلوهایش امروز میلیون‌ها می‌ارزد.",
        "en": "The painter was not appreciated during his lifetime, although his paintings cost millions today."
      }
    }
  ],
