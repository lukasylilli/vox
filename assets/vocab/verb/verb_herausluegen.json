  "id": "verb_herausluegen",
  "wort": "herauslügen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(sich herauslügen) با دروغ خود را (از وضع بدی) بیرون کشیدن"
    ],
    "en": [
      "(sich) to lie one's way out (of)"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Moral",
    "Beziehungen"
  ],
  "ipa": "hɛˈʁaʊ̯sˌlyːɡn̩",
  "anmerkung": null,
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Er lügt sich immer heraus.",
      "uebersetzung": {
        "fa": "او همیشه با دروغ خودش را خلاص می‌کند.",
        "en": "He always lies his way out."
      }
    },
    {
      "niveau": "B2",
      "satz": "Als man ihn mit dem Fehler konfrontierte, versuchte er, sich mit einer erfundenen Geschichte herauszulügen.",
      "uebersetzung": {
        "fa": "وقتی با اشتباهش روبه‌رویش کردند، سعی کرد با یک داستان ساختگی خودش را خلاص کند.",
        "en": "When he was confronted with the mistake, he tried to lie his way out of it with a made-up story."
      }
    }
  ],
  "synonyme": [
    {
      "wort": "sich herausreden",
      "uebersetzung": {
