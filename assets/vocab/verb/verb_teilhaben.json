  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Alle sollen am Erfolg teilhaben.",
      "uebersetzung": {
        "fa": "همه باید در موفقیت سهیم باشند.",
        "en": "Everyone should share in the success."
      }
    },
    {
      "niveau": "B2",
      "satz": "Menschen mit Behinderung sollen am gesellschaftlichen Leben teilhaben, damit niemand ausgeschlossen wird.",
      "uebersetzung": {
        "fa": "افراد دارای معلولیت باید در زندگی اجتماعی مشارکت داشته باشند تا هیچ‌کس کنار گذاشته نشود.",
        "en": "People with disabilities should take part in social life so that nobody is excluded."
      }
    }
  ],
