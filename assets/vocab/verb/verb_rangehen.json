  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(محاوره) نزدیک رفتن",
      "(محاوره) (کاری را) با جدیت شروع کردن",
      "(محاوره، ans Telefon rangehen) گوشی را برداشتن"
    ],
    "en": [
      "(colloquial) to go up close",
      "(colloquial) to get stuck in, to tackle",
      "(colloquial, ans Telefon) to answer the phone"
    ]
  },
  "niveau": "B2",
