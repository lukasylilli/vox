  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(کسی را) پذیرایی کردن، به استقبال رفتن",
      "(سیگنال، پیام یا هدیه را) دریافت کردن"
    ],
    "en": [
      "to receive, to welcome (someone)",
      "to receive (a signal, message, gift)"
    ]
  },
  "niveau": "B1",
  "themen": [
    "Kommunikation",
    "Technik",
    "Beruf"
  ],
  "ipa": "ɛmˈpfaŋən",
  "anmerkung": null,
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Wir empfangen die Gäste an der Tür.",
      "uebersetzung": {
        "fa": "مهمان‌ها را دم در استقبال می‌کنیم.",
        "en": "We welcome the guests at the door."
      }
    },
    {
      "niveau": "B1",
      "satz": "In den Bergen konnten wir kein Signal empfangen, deshalb haben wir die Nachricht erst später gelesen.",
      "uebersetzung": {
        "fa": "در کوهستان نمی‌توانستیم آنتن (سیگنال) بگیریم، برای همین پیام را بعداً خواندیم.",
        "en": "In the mountains we couldn't receive a signal, so we only read the message later."
      }
    }
  ],
