  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Wir hängen im Stau fest.",
      "uebersetzung": {
        "fa": "در ترافیک گیر افتاده‌ایم.",
        "en": "We are stuck in a traffic jam."
      }
    },
    {
      "niveau": "B2",
      "satz": "Wegen des Streiks hingen tausende Reisende am Flughafen fest und mussten dort übernachten.",
      "uebersetzung": {
        "fa": "به خاطر اعتصاب، هزاران مسافر در فرودگاه گیر افتادند و مجبور شدند شب را آنجا بمانند.",
        "en": "Because of the strike, thousands of travellers were stuck at the airport and had to spend the night there."
      }
    }
  ],
