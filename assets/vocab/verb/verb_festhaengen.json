  "id": "verb_festhaengen",
  "wort": "festhängen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "گیر کردن، (در جایی) گیر افتادن و نتوانستن جلو رفتن"
    ],
    "en": [
      "to be stuck, to be caught"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Alltag",
    "Verkehr",
    "Technik"
  ],
  "ipa": "ˈfɛstˌhɛŋən",
