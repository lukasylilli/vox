{
  "schema": "3.0",
  "id": "verb_befremden",
  "wort": "befremden",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "شگفت‌زده و ناخوشایند کردن، عجیب به نظر آمدن"
    ],
    "en": [
      "to strike as odd",
      "to disconcert"
    ]
  },
  "niveau": "C2",
  "themen": [
    "Gefühle"
  ],
  "ipa": "bəˈfʁɛmdn̩",
  "anmerkung": "Untrennbar, regelmäßig (befremdete, befremdet). Gehoben; oft «Es befremdet mich, dass …».",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Sein Verhalten befremdet mich.",
      "uebersetzung": {
        "fa": "رفتارش برایم عجیب و ناخوشایند است.",
        "en": "His behaviour strikes me as odd."
      }
    },
    {
      "niveau": "B2",
      "satz": "Es hat viele befremdet, dass der Minister zu dem Unglück kein Wort gesagt hat.",
      "uebersetzung": {
        "fa": "برای خیلی‌ها عجیب بود که وزیر درباره‌ی این فاجعه هیچ نگفت.",
        "en": "It disconcerted many that the minister said not a word about the disaster."
      }
    }
  ],
  "synonyme": [
    {
      "wort": "irritieren",
      "uebersetzung": {
        "fa": "آشفته کردن",
        "en": "to irritate"
      }
    },
    {
      "wort": "verwundern",
      "uebersetzung": {
        "fa": "متعجب کردن",
        "en": "to astonish"
      }
    }
  ],
