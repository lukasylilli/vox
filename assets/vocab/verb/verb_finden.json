  "id": "verb_finden",
  "wort": "finden",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "پیدا کردن، یافتن",
      "(نظری داشتن) به نظرِ (کسی) آمدن، فکر کردن",
      "(sich finden) پیدا شدن"
    ],
    "en": [
      "to find",
      "to think, to find (opinion)",
      "(sich) to turn up, to be found"
    ]
  },
  "niveau": "A1",
  "themen": [
    "Alltag",
    "Meinung"
  ],
  "ipa": "ˈfɪndn̩",
  "anmerkung": null,
  "beispiele": [
    {
      "niveau": "A1",
      "satz": "Ich finde meinen Schlüssel nicht.",
      "uebersetzung": {
        "fa": "کلیدم را پیدا نمی‌کنم.",
        "en": "I can't find my key."
      }
    },
    {
      "niveau": "B1",
      "satz": "Ich finde es gut, dass die Stadt mehr Radwege baut, auch wenn das teuer ist.",
      "uebersetzung": {
        "fa": "به نظرم خوب است که شهر مسیرهای دوچرخه‌ی بیشتری می‌سازد، حتی اگر گران باشد.",
        "en": "I think it's good that the city is building more cycle paths, even if it is expensive."
      }
    }
  ],
