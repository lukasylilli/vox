  "uebersetzung": {
    "fa": [
      "(بار را) خالی کردن، تخلیه کردن",
      "(باتری) خالی شدن یا تخلیه کردن",
      "(sich entladen) (طوفان یا خشم) فوران کردن"
    ],
    "en": [
      "to unload",
      "to discharge (a battery)",
      "(sich) to burst, to erupt (storm, anger)"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Technik",
    "Verkehr",
    "Wetter"
  ],
