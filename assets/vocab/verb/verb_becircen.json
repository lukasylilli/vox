  "ipa": "bəˈt͡sɪʁt͡sn̩",
  "anmerkung": "Untrennbar, regelmäßig (becircte, becirct) — nach der Zauberin Circe. Umgangssprachlich/scherzhaft.",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Sie becirct alle Männer.",
      "uebersetzung": {
        "fa": "او همه‌ی مردها را افسون می‌کند.",
        "en": "She charms all the men."
      }
    },
    {
      "niveau": "B2",
      "satz": "Mit seinem Lächeln hat er die strenge Beamtin so becirct, dass sie den Antrag sofort bearbeitet hat.",
      "uebersetzung": {
        "fa": "با لبخندش کارمند سخت‌گیر را آن‌قدر افسون کرد که فوراً به درخواستش رسیدگی کرد.",
        "en": "He charmed the strict official so much with his smile that she processed the application immediately."
      }
    }
  ],
