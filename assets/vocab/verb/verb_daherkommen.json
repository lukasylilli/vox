  "uebersetzung": {
    "fa": [
      "از راه رسیدن، سر رسیدن",
      "(محاوره) ظاهر شدن، به نظر آمدن (با ظاهری خاص)"
    ],
    "en": [
      "to come along",
      "to appear (in a certain way)"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Alltag"
  ],
