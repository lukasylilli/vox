{
  "schema": "3.0",
  "id": "verb_loskommen",
  "wort": "loskommen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(توانستن) راه افتادن، از جایی رفتن",
      "(von etwas loskommen) از (عادت، اعتیاد یا کسی) رها شدن"
    ],
    "en": [
      "to get away, to get going",
      "(von etw) to get away from, to break free of"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Alltag",
    "Gesundheit",
    "Gefühle"
  ],
  "ipa": "ˈloːsˌkɔmən",
  "anmerkung": null,
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Wir kommen heute nicht los.",
      "uebersetzung": {
        "fa": "امروز نمی‌توانیم راه بیفتیم.",
        "en": "We can't get away today."
      }
    },
    {
      "niveau": "B2",
      "satz": "Es hat Jahre gedauert, bis er vom Rauchen endgültig losgekommen ist.",
      "uebersetzung": {
        "fa": "سال‌ها طول کشید تا او برای همیشه از سیگار کشیدن رها شد.",
        "en": "It took years for him to finally get away from smoking."
      }
    }
  ],
  "synonyme": [
