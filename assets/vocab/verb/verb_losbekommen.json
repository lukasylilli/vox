  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(چیزی چسبیده یا گیرکرده را) جدا کردن، باز کردن",
      "(محاوره) (چیزی یا کسی را) از سر باز کردن"
    ],
    "en": [
      "to get (something) off/loose",
      "(colloquial) to get rid of"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Alltag",
    "Umgangssprache"
  ],
