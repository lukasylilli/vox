  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Ich bekomme den Deckel nicht los.",
      "uebersetzung": {
        "fa": "نمی‌توانم در را باز کنم.",
        "en": "I can't get the lid off."
      }
    },
    {
      "niveau": "B2",
      "satz": "Wir haben das alte Sofa endlich losbekommen, ein Student hat es kostenlos abgeholt.",
      "uebersetzung": {
        "fa": "بالاخره از شر مبل قدیمی خلاص شدیم؛ یک دانشجو آن را مجانی برد.",
        "en": "We finally got rid of the old sofa; a student collected it for free."
      }
    }
  ],
