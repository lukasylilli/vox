  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Er ackert jeden Tag.",
      "uebersetzung": {
        "fa": "او هر روز سخت کار می‌کند.",
        "en": "He slogs away every day."
      }
    },
    {
      "niveau": "B2",
      "satz": "Für die Prüfung hat sie wochenlang geackert, und am Ende hat es sich gelohnt.",
      "uebersetzung": {
        "fa": "او هفته‌ها برای امتحان جان کند و در آخر ارزشش را داشت.",
        "en": "She slogged away for weeks for the exam, and in the end it paid off."
      }
    }
