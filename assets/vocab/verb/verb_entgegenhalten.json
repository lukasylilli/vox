  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(چیزی را) به سوی (کسی) گرفتن",
      "(در بحث، در برابر نظری) استدلال مخالف آوردن"
    ],
    "en": [
      "to hold out (towards someone)",
      "to counter (with an argument), to object"
    ]
  },
  "niveau": "C1",
  "themen": [
