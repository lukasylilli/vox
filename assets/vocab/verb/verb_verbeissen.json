{
  "schema": "3.0",
  "id": "verb_verbeissen",
  "wort": "verbeißen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(خنده/درد را) فرو خوردن، جلوی (چیزی را) گرفتن",
      "دندان فرو کردن و ول نکردن، سخت به (چیزی) چسبیدن"
    ],
    "en": [
      "to suppress, to stifle (a laugh, pain)",
      "(sich in) to sink one's teeth into, to become obsessed with"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Gefühle"
  ],
  "ipa": "fɛɐ̯ˈbaɪ̯sn̩",
  "anmerkung": "Meist reflexiv: «sich (Dat) etwas verbeißen» (unterdrücken), «sich in etwas (Akk) verbeißen». Das Partizip «verbissen» ist auch Adjektiv (= hartnäckig).",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Sie verbiss sich das Lachen.",
      "uebersetzung": {
        "fa": "جلوی خنده‌اش را گرفت.",
        "en": "She stifled her laugh."
      }
    },
    {
      "niveau": "B2",
      "satz": "Obwohl das Problem kaum lösbar war, hat er sich tagelang darin verbissen.",
      "uebersetzung": {
        "fa": "با این که مسئله تقریباً حل‌نشدنی بود، او روزها سخت به آن چسبیده بود.",
        "en": "Although the problem was hardly solvable, he stubbornly worked on it for days."
      }
    }
  ],
  "synonyme": [
    {
      "wort": "unterdrücken",
      "uebersetzung": {
        "fa": "سرکوب کردن، فرو خوردن",
        "en": "to suppress"
      }
    }
  ],
