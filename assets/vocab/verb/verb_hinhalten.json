  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Er hält mir die Hand hin.",
      "uebersetzung": {
        "fa": "او دستش را به سمت من دراز می‌کند.",
        "en": "He holds out his hand to me."
      }
    },
    {
      "niveau": "B2",
      "satz": "Der Vermieter hält uns seit Monaten hin und repariert die Heizung einfach nicht.",
      "uebersetzung": {
        "fa": "صاحب‌خانه ماه‌هاست ما را سر می‌دواند و بخاری را تعمیر نمی‌کند.",
        "en": "The landlord has been putting us off for months and simply isn't repairing the heating."
      }
    }
  ],
