  "uebersetzung": {
    "fa": [
      "(چیزی را به سوی کسی) دراز کردن، جلو گرفتن",
      "(کسی را) معطل کردن، سر دواندن"
    ],
    "en": [
      "to hold out",
      "to put (someone) off, to keep (someone) waiting"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Alltag",
    "Beziehungen"
  ],
