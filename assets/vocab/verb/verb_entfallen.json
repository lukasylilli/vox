    "fa": [
      "(برنامه یا کلاسی) لغو شدن، حذف شدن",
      "از یاد (کسی) رفتن",
      "(سهمی) تعلق گرفتن به"
    ],
    "en": [
      "to be cancelled, to be dropped",
      "to slip one's mind",
      "to be allotted to"
    ]
