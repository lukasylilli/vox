    "fa": [
      "داغ زدن، (نشانه‌ای را با آتش) حک کردن",
      "(sich einbrennen) در ذهن نقش بستن"
    ],
    "en": [
      "to brand, to burn in",
      "(sich) to be etched (in memory)"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Gefühle",
    "Handwerk"
  ],
  "ipa": "ˈaɪ̯nˌbʁɛnən",
  "anmerkung": "Gemischtes Verb: brannte ein, eingebrannt. Österreichisch auch: eine Mehlschwitze (Einbrenn) machen.",
