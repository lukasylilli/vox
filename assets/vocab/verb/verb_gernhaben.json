  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(کسی یا چیزی را) دوست داشتن، از (کسی) خوش آمدن"
    ],
    "en": [
      "to be fond of, to like"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Gefühle",
    "Beziehungen"
  ],
  "ipa": "ˈɡɛʁnˌhaːbn̩",
  "anmerkung": "Ironisch: «Du kannst mich mal gernhaben!» (= Lass mich in Ruhe!).",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Ich habe dich gern.",
      "uebersetzung": {
        "fa": "دوستت دارم (از تو خوشم می‌آید).",
        "en": "I'm fond of you."
      }
    },
    {
      "niveau": "B2",
      "satz": "Die Kinder haben ihre neue Lehrerin schon nach einer Woche richtig gerngehabt.",
      "uebersetzung": {
        "fa": "بچه‌ها بعد از یک هفته حسابی از معلم جدیدشان خوششان آمده بود.",
        "en": "After just one week the children had really grown fond of their new teacher."
      }
    }
  ],
