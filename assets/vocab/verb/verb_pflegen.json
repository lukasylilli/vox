  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(از بیمار، سالمند یا کودکی) پرستاری و مراقبت کردن",
      "(از چیزی) نگهداری کردن، رسیدگی کردن",
      "(عادت یا رابطه‌ای را) داشتن، حفظ کردن («zu tun pflegen» = عادت داشتن)"
    ],
    "en": [
      "to nurse, to care for",
      "to look after, to maintain",
      "to cultivate, to keep up («zu tun pflegen» = to be in the habit of)"
    ]
  },
  "niveau": "B1",
  "themen": [
    "Pflege",
    "Gesundheit",
    "Beziehungen"
  ],
  "ipa": "ˈp͡fleːɡn̩",
  "anmerkung": "In der Verbliste unter den unregelmäßigen Verben; heute regelmäßig (pflegte, gepflegt). Veraltete starke Formen (pflog, gepflogen) nur noch in festen Wendungen.",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Sie pflegt ihre kranke Mutter.",
      "uebersetzung": {
        "fa": "او از مادر بیمارش پرستاری می‌کند.",
        "en": "She is nursing her sick mother."
      }
    },
    {
      "niveau": "B1",
      "satz": "Auf der Station pflegen wir vor allem ältere Patienten nach Operationen.",
      "uebersetzung": {
        "fa": "در این بخش بیشتر از بیماران مسن بعد از عمل جراحی مراقبت می‌کنیم.",
        "en": "On the ward we mainly care for older patients after operations."
      }
    }
  ],
