    {
      "niveau": "A2",
      "satz": "Unterlass bitte diese Witze!",
      "uebersetzung": {
        "fa": "لطفاً این شوخی‌ها را بس کن!",
        "en": "Please stop making these jokes!"
      }
    },
    {
      "niveau": "B2",
      "satz": "Er hat es unterlassen, seinen Chef rechtzeitig zu informieren.",
      "uebersetzung": {
        "fa": "او از اطلاع دادن به‌موقع به رئیسش کوتاهی کرد.",
        "en": "He failed to inform his boss in time."
