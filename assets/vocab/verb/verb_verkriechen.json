  "uebersetzung": {
    "fa": [
      "(در جایی) پنهان شدن، (به کنجی) خزیدن"
    ],
    "en": [
      "to creep away, to hide"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Gefühle",
    "Tiere"
  ],
  "ipa": "fɛɐ̯ˈkʁiːçn̩",
  "anmerkung": "Untrennbar, reflexiv (verkroch sich, hat sich verkrochen).",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Die Katze verkriecht sich unter dem Bett.",
      "uebersetzung": {
        "fa": "گربه زیر تخت قایم می‌شود.",
        "en": "The cat hides under the bed."
      }
    },
    {
      "niveau": "B2",
      "satz": "Am liebsten hätte ich mich verkrochen, als alle merkten, dass ich mich geirrt hatte.",
      "uebersetzung": {
        "fa": "وقتی همه فهمیدند اشتباه کرده‌ام، دلم می‌خواست جایی قایم شوم.",
        "en": "When everyone noticed that I had been wrong, I would have loved to crawl away and hide."
      }
    }
  ],
