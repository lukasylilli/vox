  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Der Hund kommt langsam heran.",
      "uebersetzung": {
        "fa": "سگ آرام نزدیک می‌آید.",
        "en": "The dog is slowly coming closer."
      }
    },
    {
      "niveau": "B2",
      "satz": "An die Akten kommt man nur mit einer besonderen Erlaubnis heran.",
      "uebersetzung": {
        "fa": "به پرونده‌ها فقط با مجوز ویژه می‌توان دسترسی داشت.",
        "en": "You can only get at the files with special permission."
      }
    }
  ],
