    "fa": [
      "نزدیک آمدن، نزدیک شدن",
      "(به چیزی) دسترسی پیدا کردن، به دست آوردن"
    ],
    "en": [
      "to come near, to approach",
      "to get at, to get hold of"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Alltag",
    "Zeit"
  ],
