  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(با وسیله‌ی نقلیه) به اینجا آمدن",
      "(hinter jemandem herfahren) پشت سر (کسی) راندن"
    ],
    "en": [
      "to drive here, to come here",
      "(hinter jdm) to drive behind"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Verkehr"
  ],
  "ipa": "ˈheːɐ̯ˌfaːʁən",
  "anmerkung": "Transitiv (jemanden herfahren) mit «haben».",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Wie lange fährst du her?",
      "uebersetzung": {
        "fa": "چقدر طول می‌کشد تا با ماشین بیایی اینجا؟",
        "en": "How long does it take you to drive here?"
      }
    },
    {
      "niveau": "B2",
      "satz": "Wir sind extra aus Graz hergefahren, aber das Konzert wurde leider abgesagt.",
      "uebersetzung": {
        "fa": "ما مخصوصاً از گراتس تا اینجا آمدیم، اما متأسفانه کنسرت لغو شد.",
        "en": "We drove all the way here from Graz, but unfortunately the concert was cancelled."
      }
    }
  ],
