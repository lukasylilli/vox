  "id": "verb_herhaben",
  "wort": "herhaben",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(محاوره) (چیزی را) از جایی آوردن، از جایی داشتن یا شنیدن"
    ],
    "en": [
      "(colloquial) to have got (something) from somewhere"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Alltag",
    "Umgangssprache"
  ],
  "ipa": "ˈheːɐ̯ˌhaːbn̩",
  "anmerkung": "Umgangssprachlich, meist in Fragen: «Wo hast du das her?»",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Wo hast du das her?",
      "uebersetzung": {
        "fa": "این را از کجا آورده‌ای؟",
        "en": "Where did you get that?"
      }
    },
    {
      "niveau": "B2",
      "satz": "Ich weiß nicht, wo er diese Information herhat, aber sie stimmt leider.",
      "uebersetzung": {
        "fa": "نمی‌دانم این اطلاعات را از کجا آورده، اما متأسفانه درست است.",
        "en": "I don't know where he got this information from, but unfortunately it's true."
      }
    }
  ],
  "synonyme": [
    {
      "wort": "herbekommen",
      "uebersetzung": {
        "fa": "از جایی گرفتن",
        "en": "to get from"
