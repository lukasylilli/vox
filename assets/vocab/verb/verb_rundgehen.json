  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(محاوره، es geht rund) حسابی شلوغ و پرکار بودن",
      "دست‌به‌دست گشتن"
    ],
    "en": [
      "(colloquial, es geht rund) to be hectic",
      "to be passed around"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Umgangssprache",
    "Alltag"
  ],
  "ipa": "ˈʁʊntˌɡeːən",
  "anmerkung": "Meist unpersönlich: «es geht rund» (ugs.: es ist viel los). Auch: «Die Flasche geht rund» (wird herumgereicht). Kein sinnvoller Imperativ.",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Heute geht es im Laden rund.",
      "uebersetzung": {
        "fa": "امروز توی مغازه حسابی شلوغ است.",
        "en": "It's really hectic in the shop today."
      }
    },
    {
      "niveau": "B2",
      "satz": "Als die Gäste kamen, ging es in der Küche richtig rund, sodass niemand Pause machen konnte.",
      "uebersetzung": {
        "fa": "وقتی مهمان‌ها آمدند، آشپزخانه حسابی شلوغ شد، طوری که هیچ‌کس نتوانست استراحت کند.",
        "en": "When the guests arrived, things got really hectic in the kitchen, so nobody could take a break."
      }
    }
  ],
