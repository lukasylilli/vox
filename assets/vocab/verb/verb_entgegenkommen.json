  "uebersetzung": {
    "fa": [
      "به سوی (کسی) آمدن، از روبه‌رو آمدن",
      "(با کسی) کنار آمدن، (به خواسته‌ای) تا حدی تن دادن، مساعدت کردن"
    ],
    "en": [
      "to come towards",
      "to meet (someone) halfway, to accommodate"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Verkehr",
    "Beziehungen",
    "Arbeit"
  ],
