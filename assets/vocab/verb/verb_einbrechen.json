    {
      "niveau": "A2",
      "satz": "Diebe sind in unser Haus eingebrochen.",
      "uebersetzung": {
        "fa": "دزدها به خانه‌مان دستبرد زدند.",
        "en": "Thieves broke into our house."
      }
    },
    {
      "niveau": "B1",
      "satz": "Als die Nacht einbrach, waren die Wanderer noch immer nicht im Tal.",
