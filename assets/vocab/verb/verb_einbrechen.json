  "uebersetzung": {
    "fa": [
      "(به جایی برای دزدی) دستبرد زدن، وارد شدن",
      "(یخ یا سقف) شکستن و فرو ریختن",
      "(تاریکی یا زمستان) فرا رسیدن؛ (قیمت) سقوط کردن"
    ],
    "en": [
      "to break in, to burgle",
      "to collapse, to fall through (ice)",
      "(night, winter) to set in; (prices) to slump"
    ]
  },
  "niveau": "B1",
  "themen": [
    "Kriminalität",
    "Wetter",
    "Wirtschaft"
  ],
