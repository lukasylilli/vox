  "wort": "unterbieten",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(قیمت) کمتر از دیگری پیشنهاد دادن",
      "(رکورد را) شکستن، (زمان را) کمتر کردن"
    ],
    "en": [
      "to undercut, to underbid",
      "to beat (a record time)"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Wirtschaft",
    "Sport"
  ],
  "ipa": "ʊntɐˈbiːtn̩",
  "anmerkung": "Untrennbar (unterbot, unterboten).",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Der Laden unterbietet die Konkurrenz.",
      "uebersetzung": {
        "fa": "این مغازه ارزان‌تر از رقبا می‌فروشد.",
        "en": "The shop undercuts the competition."
      }
    },
    {
      "niveau": "B2",
      "satz": "Die Läuferin hat den alten Rekord um zwei Sekunden unterboten, obwohl es stark regnete.",
      "uebersetzung": {
        "fa": "دونده با وجود باران شدید، رکورد قبلی را دو ثانیه بهتر کرد.",
        "en": "The runner beat the old record by two seconds, although it was raining heavily."
      }
    }
  ],
