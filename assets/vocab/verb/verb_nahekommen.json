  "wort": "nahekommen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(به کسی یا چیزی) نزدیک شدن",
      "(به حقیقت یا هدفی) نزدیک بودن، شبیه بودن",
      "(با کسی) صمیمی شدن"
    ],
    "en": [
      "to come close to",
      "to come close to (truth, a goal)",
      "to get close to (someone)"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Beziehungen",
    "Denken"
  ],
  "ipa": "ˈnaːəˌkɔmən",
  "anmerkung": null,
