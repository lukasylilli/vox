    {
      "niveau": "A2",
      "satz": "Wir sind dem Ziel schon nahegekommen.",
      "uebersetzung": {
        "fa": "دیگر به هدف نزدیک شده‌ایم.",
        "en": "We have already come close to the goal."
      }
    },
    {
      "niveau": "B2",
      "satz": "Seine Vermutung kommt der Wahrheit ziemlich nahe, auch wenn sie nicht ganz stimmt.",
      "uebersetzung": {
        "fa": "حدسش به حقیقت خیلی نزدیک است، حتی اگر کاملاً درست نباشد.",
        "en": "His guess comes pretty close to the truth, even if it isn't quite right."
      }
    }
  ],
