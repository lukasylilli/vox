{
  "schema": "3.0",
  "id": "verb_festfressen",
  "wort": "festfressen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(sich festfressen) (قطعه‌ی ماشین) گیر کردن و قفل شدن (از اصطکاک یا زنگ‌زدگی)",
      "(فکری در ذهن) ریشه دواندن"
    ],
    "en": [
      "(sich) to seize up, to jam",
      "(sich) to take root (an idea)"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Technik"
  ],
  "ipa": "ˈfɛstˌfʁɛsn̩",
  "anmerkung": null,
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Die Schraube hat sich festgefressen.",
      "uebersetzung": {
        "fa": "پیچ (از زنگ‌زدگی) گیر کرده است.",
        "en": "The screw has seized."
      }
    },
    {
      "niveau": "B2",
      "satz": "Weil zu wenig Öl im Motor war, hat sich der Kolben festgefressen und der Wagen blieb stehen.",
      "uebersetzung": {
        "fa": "چون روغن موتور کم بود، پیستون گیر کرد و ماشین ایستاد.",
        "en": "Because there was too little oil in the engine, the piston seized and the car stopped."
      }
    }
  ],
  "synonyme": [
    {
      "wort": "blockieren",
      "uebersetzung": {
        "fa": "قفل شدن، گیر کردن",
        "en": "to jam"
