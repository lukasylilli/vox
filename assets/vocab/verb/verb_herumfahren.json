    "fa": [
      "(با وسیله‌ی نقلیه) این طرف و آن طرف رفتن، گشت زدن",
      "(دور چیزی) راندن",
      "ناگهان برگشتن (رو برگرداندن)"
    ],
    "en": [
      "to drive around",
      "to drive round (something)",
      "to spin round"
    ]
  },
