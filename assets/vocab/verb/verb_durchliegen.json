  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(sich durchliegen) زخم بستر گرفتن (از دراز کشیدن طولانی)",
      "(تشک را) از بس رویش خوابیده‌اند گود کردن"
    ],
    "en": [
      "(sich) to get bedsores",
      "to wear out (a mattress) by lying on it"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Gesundheit",
    "Pflege"
  ],
  "ipa": "ˈdʊʁçˌliːɡn̩",
  "anmerkung": null,
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Die alte Matratze ist ganz durchgelegen.",
      "uebersetzung": {
        "fa": "تشک قدیمی از بس رویش خوابیده‌اند کاملاً گود شده است.",
        "en": "The old mattress is completely worn out."
      }
    },
    {
      "niveau": "B2",
      "satz": "Damit sich bettlägerige Patienten nicht durchliegen, werden sie regelmäßig umgelagert.",
      "uebersetzung": {
        "fa": "برای اینکه بیماران بستری زخم بستر نگیرند، مرتب جابه‌جایشان می‌کنند.",
        "en": "So that bedridden patients do not get bedsores, they are repositioned regularly."
      }
    }
  ],
