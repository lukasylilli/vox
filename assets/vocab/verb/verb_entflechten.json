  "anmerkung": null,
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Sie entflicht die Kabel.",
      "uebersetzung": {
        "fa": "او سیم‌ها را از هم باز می‌کند.",
        "en": "She disentangles the cables."
      }
    },
    {
      "niveau": "B2",
      "satz": "Die Behörde will den großen Konzern entflechten, damit wieder mehr Wettbewerb entsteht.",
      "uebersetzung": {
        "fa": "اداره‌ی مربوط می‌خواهد آن شرکت بزرگ را تفکیک کند تا دوباره رقابت بیشتری ایجاد شود.",
        "en": "The authority wants to break up the large corporation so that more competition arises again."
      }
    }
  ],
