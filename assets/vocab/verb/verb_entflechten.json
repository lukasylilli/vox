  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(چیزهای درهم‌تنیده را) از هم باز کردن",
      "(شرکت یا ساختار بزرگی را) تجزیه و تفکیک کردن"
    ],
    "en": [
      "to disentangle",
      "to break up, to decartelise (companies, structures)"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Wirtschaft",
    "Politik",
    "Verkehr"
  ],
