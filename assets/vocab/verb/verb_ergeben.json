  "uebersetzung": {
    "fa": [
      "(به عنوان نتیجه) به دست دادن، نشان دادن",
      "(sich ergeben) نتیجه شدن، پیش آمدن؛ تسلیم شدن"
    ],
    "en": [
      "to yield, to result in, to show",
      "(sich) to arise, to result; to surrender"
    ]
  },
  "niveau": "B2",
