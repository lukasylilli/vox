  "anmerkung": "Das Partizip «ergeben» (= treu, demütig) ist auch ein eigenes Adjektiv.",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Drei mal drei ergibt neun.",
      "uebersetzung": {
        "fa": "سه ضرب در سه می‌شود نه.",
        "en": "Three times three makes nine."
      }
    },
    {
      "niveau": "B2",
      "satz": "Die Untersuchung hat ergeben, dass der Patient keine Allergie hat, sondern eine Infektion.",
      "uebersetzung": {
        "fa": "معاینه نشان داد که بیمار حساسیت ندارد، بلکه عفونت دارد.",
        "en": "The examination showed that the patient does not have an allergy but an infection."
      }
    }
  ],
