  "id": "verb_durchkommen",
  "wort": "durchkommen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "از جایی گذشتن، رد شدن",
      "(در امتحان) قبول شدن؛ (از بیماری) جان سالم به در بردن",
      "با (پول یا چیزی) سر کردن؛ (تلفنی) ارتباط برقرار کردن"
    ],
    "en": [
      "to get through, to pass through",
      "to pass (an exam); to survive",
      "to get by (with); to get through (on the phone)"
    ]
  },
  "niveau": "B1",
  "themen": [
    "Alltag",
    "Lernen",
    "Gesundheit"
  ],
  "ipa": "ˈdʊʁçˌkɔmən",
  "anmerkung": null,
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Hier kommt kein Auto durch.",
      "uebersetzung": {
        "fa": "اینجا هیچ ماشینی نمی‌تواند رد شود.",
        "en": "No car can get through here."
      }
    },
    {
      "niveau": "B1",
      "satz": "Obwohl er kaum gelernt hatte, ist er in der Prüfung durchgekommen.",
      "uebersetzung": {
        "fa": "با اینکه تقریباً درس نخوانده بود، در امتحان قبول شد.",
        "en": "Although he had hardly studied, he passed the exam."
      }
    }
  ],
