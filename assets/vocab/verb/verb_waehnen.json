  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(به‌اشتباه) پنداشتن، گمان کردن"
    ],
    "en": [
      "to believe (wrongly)",
      "to imagine"
    ]
  },
  "niveau": "C2",
  "themen": [
    "Gefühle"
  ],
  "ipa": "ˈvɛːnən",
  "anmerkung": "Regelmäßig (wähnte, gewähnt), obwohl in der Liste unregelmäßiger Verben. Gehoben; meist «sich + Adjektiv/Ort wähnen». Kein üblicher Imperativ.",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Er wähnte sich sicher.",
      "uebersetzung": {
        "fa": "خودش را در امان می‌پنداشت.",
        "en": "He believed himself safe."
      }
    },
    {
      "niveau": "B2",
      "satz": "Sie wähnte sich allein im Haus, bis sie plötzlich Schritte hörte.",
      "uebersetzung": {
        "fa": "گمان می‌کرد در خانه تنهاست، تا اینکه ناگهان صدای پا شنید.",
        "en": "She thought she was alone in the house until she suddenly heard footsteps."
      }
    }
  ],
