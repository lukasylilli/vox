{
  "schema": "3.0",
  "id": "verb_entgleiten",
  "wort": "entgleiten",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(از دست کسی) لیز خوردن و افتادن",
      "(کنترل وضعی) از دست (کسی) خارج شدن"
    ],
    "en": [
      "to slip (from someone's hands)",
      "to slip out of control"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Alltag",
    "Gefühle"
  ],
  "ipa": "ɛntˈɡlaɪ̯tn̩",
  "anmerkung": null,
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Das Glas entgleitet ihr.",
      "uebersetzung": {
        "fa": "لیوان از دستش لیز می‌خورد.",
        "en": "The glass slips from her hand."
      }
    },
    {
      "niveau": "B2",
      "satz": "Die Situation ist der Lehrerin völlig entglitten, als zwei Schüler anfingen, sich zu prügeln.",
      "uebersetzung": {
        "fa": "وقتی دو دانش‌آموز شروع به کتک‌کاری کردند، اوضاع کاملاً از کنترل معلم خارج شد.",
        "en": "The situation slipped completely out of the teacher's control when two pupils started fighting."
      }
    }
  ],
  "synonyme": [
    {
      "wort": "entrutschen",
      "uebersetzung": {
        "fa": "لیز خوردن (از دست)",
        "en": "to slip"
      }
    },
    {
      "wort": "außer Kontrolle geraten",
      "uebersetzung": {
        "fa": "از کنترل خارج شدن",
        "en": "to get out of control"
      }
    }
  ],
