  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(آتش یا نور) خاموش شدن",
      "(حق، قرارداد یا عضویتی) از اعتبار افتادن، باطل شدن"
    ],
    "en": [
      "to go out (fire, light)",
      "to expire, to lapse (right, contract)"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Recht",
    "Alltag"
  ],
  "ipa": "ɛɐ̯ˈlœʃn̩",
  "anmerkung": "Intransitiv und unregelmäßig (erlischt, erlosch, ist erloschen) — anders als das regelmäßige transitive «löschen».",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Das Feuer erlischt.",
      "uebersetzung": {
        "fa": "آتش خاموش می‌شود.",
        "en": "The fire goes out."
      }
    },
    {
      "niveau": "B2",
      "satz": "Wenn Sie den Beitrag zwei Jahre nicht bezahlen, erlischt Ihre Mitgliedschaft automatisch.",
      "uebersetzung": {
        "fa": "اگر حق عضویت را دو سال پرداخت نکنید، عضویت‌تان خودبه‌خود باطل می‌شود.",
        "en": "If you do not pay the fee for two years, your membership will lapse automatically."
      }
    }
  ],
