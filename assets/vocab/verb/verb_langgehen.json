  "uebersetzung": {
    "fa": [
      "(محاوره) (از مسیری) رفتن، در امتداد (چیزی) رفتن",
      "(wissen, wo es langgeht) دانستن که اوضاع از چه قرار است، رئیس بودن"
    ],
    "en": [
      "(colloquial) to go along",
      "(wissen, wo es langgeht) to know what's what, to be in charge"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Orientierung",
    "Umgangssprache"
  ],
  "ipa": "ˈlaŋˌɡeːən",
