  "id": "verb_herangehen",
  "wort": "herangehen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(به کسی یا چیزی) نزدیک شدن",
      "(کاری یا مسئله‌ای را) شروع کردن، با آن برخورد کردن"
    ],
    "en": [
      "to go up (to), to approach",
      "to tackle, to approach (a task)"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Arbeit",
    "Lernen"
  ],
  "ipa": "hɛˈʁanˌɡeːən",
  "anmerkung": null,
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Geh nicht zu nah heran!",
      "uebersetzung": {
        "fa": "زیادی نزدیک نرو!",
        "en": "Don't go too close!"
      }
    },
    {
      "niveau": "B2",
      "satz": "Man sollte an eine so schwierige Aufgabe ruhig und mit einem klaren Plan herangehen.",
      "uebersetzung": {
        "fa": "باید با آرامش و یک برنامه‌ی روشن سراغ چنین کار دشواری رفت.",
        "en": "One should approach such a difficult task calmly and with a clear plan."
      }
    }
  ],
