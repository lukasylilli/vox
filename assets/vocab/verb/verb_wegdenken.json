    "rektion": [
      {
        "muster": "sich (Dat) etwas wegdenken",
        "bedeutung": "sich vorstellen, dass etwas nicht da ist",
        "beispiel": "Denk dir die Bäume einmal weg!",
        "uebersetzung": {
          "fa": "یک لحظه تصور کن درخت‌ها نیستند!",
          "en": "Just imagine the trees were not there!"
        }
      }
    ],
