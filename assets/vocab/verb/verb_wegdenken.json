{
  "schema": "3.0",
  "id": "verb_wegdenken",
  "wort": "wegdenken",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(در ذهن) نبودِ چیزی را تصور کردن"
    ],
    "en": [
      "to imagine without",
      "to think away"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Alltag"
  ],
  "ipa": "ˈvɛkˌdɛŋkn̩",
  "anmerkung": "Trennbar, gemischtes Verb (dachte weg, weggedacht). Meist: «nicht mehr wegzudenken sein» (= unverzichtbar). Kein üblicher Imperativ.",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Das Handy ist nicht mehr wegzudenken.",
      "uebersetzung": {
        "fa": "دیگر نمی‌شود زندگی را بدون موبایل تصور کرد.",
        "en": "The mobile phone has become indispensable."
      }
    },
    {
      "niveau": "B2",
      "satz": "Wenn man sich das Internet wegdenkt, merkt man erst, wie sehr sich unser Leben verändert hat.",
      "uebersetzung": {
        "fa": "وقتی اینترنت را از ذهن کنار بگذاری، تازه می‌فهمی زندگی ما چقدر تغییر کرده است.",
        "en": "If you imagine the internet away, you realise how much our lives have changed."
      }
    }
  ],
  "synonyme": [],
  "antonyme": [],
  "komposita": [],
  "etymologie": {
    "fa": "weg (دور) + denken (فکر کردن)",
    "en": "weg (away) + denken (to think)"
  },
