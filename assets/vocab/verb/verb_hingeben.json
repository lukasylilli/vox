{
  "schema": "3.0",
  "id": "verb_hingeben",
  "wort": "hingeben",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(ادبی) (چیزی را) فدا کردن، بخشیدن",
      "(sich hingeben) خود را وقف (چیزی) کردن، غرق (احساسی) شدن"
    ],
    "en": [
      "(literary) to give up, to sacrifice",
      "(sich) to devote oneself to, to abandon oneself to"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Gefühle",
    "Sprache (gehoben)"
  ],
  "ipa": "ˈhɪnˌɡeːbn̩",
  "anmerkung": "Gehoben. Das Partizip «hingebungsvoll» / Nomen «Hingabe» (= Leidenschaft, Hingebung) sind häufig.",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Sie gibt sich der Musik hin.",
      "uebersetzung": {
        "fa": "او غرق موسیقی می‌شود.",
        "en": "She abandons herself to the music."
      }
    },
    {
      "niveau": "B2",
      "satz": "Man sollte sich nicht der Illusion hingeben, dass sich das Problem von selbst löst.",
      "uebersetzung": {
        "fa": "نباید دل به این خیال خوش کرد که مشکل خودبه‌خود حل می‌شود.",
        "en": "One shouldn't be under the illusion that the problem will solve itself."
      }
    }
  ],
  "synonyme": [
    {
      "wort": "sich widmen",
      "uebersetzung": {
        "fa": "خود را وقف کردن",
        "en": "to devote oneself"
      }
    },
    {
      "wort": "opfern",
      "uebersetzung": {
        "fa": "فدا کردن",
        "en": "to sacrifice"
      }
    }
  ],
