  "uebersetzung": {
    "fa": [
      "(پس از رفتن یا مرگ، چیزی را) به جا گذاشتن، ارث گذاشتن",
      "(پیام یا اثری را) گذاشتن، باقی گذاشتن"
    ],
    "en": [
      "to leave (behind), to bequeath",
      "to leave (a message, an impression)"
    ]
  },
  "niveau": "B2",
