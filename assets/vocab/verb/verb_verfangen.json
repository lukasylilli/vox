  "uebersetzung": {
    "fa": [
      "گیر افتادن (در چیزی)",
      "(ترفند یا حرف) اثر کردن، کارگر افتادن"
    ],
    "en": [
      "(sich) to get caught (in)",
      "to have an effect, to work"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Alltag"
  ],
  "ipa": "fɛɐ̯ˈfaŋən",
  "anmerkung": "Untrennbar (verfing, verfangen). Meist reflexiv: «sich in etwas (Dat) verfangen»; ohne «sich» oft verneint: «Das verfängt bei mir nicht.»",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Der Vogel hat sich im Netz verfangen.",
      "uebersetzung": {
        "fa": "پرنده در تور گیر افتاد.",
        "en": "The bird got caught in the net."
      }
    },
    {
      "niveau": "B2",
      "satz": "Seine Ausreden verfangen bei mir nicht mehr, weil er mich schon zu oft angelogen hat.",
      "uebersetzung": {
        "fa": "بهانه‌هایش دیگر روی من اثر ندارد، چون بارها به من دروغ گفته است.",
        "en": "His excuses no longer work on me because he has lied to me too often."
      }
    }
  ],
