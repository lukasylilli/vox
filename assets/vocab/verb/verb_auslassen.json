  "uebersetzung": {
    "fa": [
      "جا انداختن، حذف کردن",
      "(sich auslassen / an jemandem auslassen) خالی کردن (خشم)",
      "از دست دادن (فرصت)"
    ],
    "en": [
      "to leave out",
      "to vent (on)",
      "to miss"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Kommunikation",
    "Gefühle"
  ],
  "ipa": "ˈaʊ̯sˌlasn̩",
  "anmerkung": null,
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Du hast ein Wort ausgelassen.",
      "uebersetzung": {
        "fa": "یک کلمه را جا انداختی.",
        "en": "You have left out a word."
      }
    },
    {
      "niveau": "B2",
      "satz": "Er sollte seine schlechte Laune nicht an den Kindern auslassen, nur weil er Stress im Büro hat.",
      "uebersetzung": {
        "fa": "نباید بدخلقی‌اش را سر بچه‌ها خالی کند، فقط چون در اداره استرس دارد.",
        "en": "He shouldn't take his bad mood out on the children just because he's stressed at the office."
      }
    }
  ],
