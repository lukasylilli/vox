  "id": "verb_hervorbringen",
  "wort": "hervorbringen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "پدید آوردن، به وجود آوردن، (هنرمند یا دانشمندی را) پرورش دادن",
      "(صدا یا کلمه‌ای را) بیرون آوردن، بر زبان آوردن"
    ],
    "en": [
      "to produce, to bring forth",
      "to utter, to get out (a sound, word)"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Kultur",
    "Natur",
    "Wissenschaft"
  ],
  "ipa": "hɛɐ̯ˈfoːɐ̯ˌbʁɪŋən",
  "anmerkung": "Gemischtes Verb: brachte hervor, hervorgebracht.",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Er bringt kein Wort hervor.",
      "uebersetzung": {
        "fa": "یک کلمه هم نمی‌تواند به زبان بیاورد.",
        "en": "He can't get a word out."
      }
    },
    {
      "niveau": "B2",
      "satz": "Diese kleine Stadt hat erstaunlich viele berühmte Musiker hervorgebracht.",
      "uebersetzung": {
        "fa": "این شهر کوچک به‌طرز شگفت‌انگیزی موسیقی‌دانان مشهور زیادی پرورش داده است.",
        "en": "This small town has produced an astonishing number of famous musicians."
      }
    }
  ],
