  "uebersetzung": {
    "fa": [
      "با هواپیما (به جایی) آوردن یا رساندن",
      "(هواپیما) وارد (منطقه‌ای) شدن"
    ],
    "en": [
      "to fly in (people, goods)",
      "to fly into (an area)"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Reisen",
    "Verkehr",
    "Politik"
  ],
  "ipa": "ˈaɪ̯nˌfliːɡn̩",
  "anmerkung": "Transitiv mit «haben» (Hilfsgüter einfliegen); intransitiv mit «sein» (Das Flugzeug ist in den Luftraum eingeflogen).",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Man fliegt Ärzte in das Gebiet ein.",
      "uebersetzung": {
        "fa": "پزشکان را با هواپیما به آن منطقه می‌برند.",
        "en": "Doctors are being flown into the area."
      }
    },
    {
      "niveau": "B2",
      "satz": "Nach dem Erdbeben wurden Medikamente und Zelte eingeflogen, weil die Straßen zerstört waren.",
      "uebersetzung": {
        "fa": "بعد از زلزله دارو و چادر با هواپیما رساندند، چون جاده‌ها ویران شده بودند.",
        "en": "After the earthquake, medicine and tents were flown in because the roads were destroyed."
      }
    }
  ],
