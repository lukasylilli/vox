  "id": "verb_herumkommen",
  "wort": "herumkommen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(در دنیا) سفر زیاد کردن، جاهای زیادی دیدن",
      "(um etwas herumkommen) از (کاری) معاف شدن، از زیر (کاری) در رفتن"
    ],
    "en": [
      "to get around (travel a lot)",
      "(um etw) to get out of, to avoid"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Reisen",
    "Alltag"
  ],
  "ipa": "hɛˈʁʊmˌkɔmən",
  "anmerkung": "Umgangssprachlich oft «rum…».",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Sie ist viel herumgekommen.",
      "uebersetzung": {
        "fa": "او جاهای زیادی را دیده است.",
        "en": "She has been around a lot."
      }
    },
    {
      "niveau": "B2",
      "satz": "Um die Steuererklärung kommst du leider nicht herum, auch wenn du sie hasst.",
      "uebersetzung": {
        "fa": "متأسفانه از زیر اظهارنامه‌ی مالیاتی نمی‌توانی در بروی، حتی اگر از آن متنفر باشی.",
        "en": "Unfortunately you can't get out of doing your tax return, even if you hate it."
      }
    }
  ],
