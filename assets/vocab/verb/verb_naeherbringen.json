  "wort": "näherbringen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(کسی را با چیزی) آشنا کردن و نزدیک کردن، (چیزی را) قابل‌فهم کردن",
      "(دو نفر را به هم) نزدیک‌تر کردن"
    ],
    "en": [
      "to introduce (someone) to, to bring (something) closer",
      "to bring (people) closer together"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Bildung",
    "Beziehungen"
  ],
  "ipa": "ˈnɛːɐˌbʁɪŋən",
  "anmerkung": "Gemischtes Verb: brachte näher, nähergebracht.",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Das Buch bringt uns Österreich näher.",
      "uebersetzung": {
        "fa": "این کتاب ما را با اتریش آشناتر می‌کند.",
        "en": "The book brings Austria closer to us."
      }
    },
    {
      "niveau": "B2",
      "satz": "Die schwere Zeit hat die beiden Geschwister einander wieder nähergebracht.",
      "uebersetzung": {
        "fa": "آن دوران سخت دو خواهر و برادر را دوباره به هم نزدیک کرد.",
        "en": "The difficult time brought the two siblings closer together again."
      }
    }
  ],
