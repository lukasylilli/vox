  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(کشتی به‌گل‌نشسته را) دوباره به حرکت درآوردن",
      "(محاوره) (ماشین یا کاری را) دوباره راه انداختن"
    ],
    "en": [
      "to refloat (a ship)",
      "(colloquial) to get (something) going again"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Technik",
    "Verkehr"
  ],
  "ipa": "ˈflɔtbəˌkɔmən",
  "anmerkung": null,
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Er bekommt das Auto wieder flott.",
      "uebersetzung": {
        "fa": "او ماشین را دوباره راه می‌اندازد.",
        "en": "He gets the car going again."
      }
    },
    {
      "niveau": "B2",
      "satz": "Erst nach drei Tagen haben Schlepper das auf Grund gelaufene Schiff wieder flottbekommen.",
      "uebersetzung": {
        "fa": "تازه بعد از سه روز یدک‌کش‌ها توانستند کشتی به‌گل‌نشسته را دوباره به حرکت درآورند.",
        "en": "Only after three days did tugs manage to refloat the ship that had run aground."
      }
    }
  ],
