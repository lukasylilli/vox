{
  "schema": "3.0",
  "id": "verb_anecken",
  "wort": "anecken",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(با رفتار) دیگران را رنجاندن، مورد انتقاد قرار گرفتن"
    ],
    "en": [
      "to rub people up the wrong way",
      "to cause offence"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Beziehungen"
  ],
  "ipa": "ˈanˌʔɛkn̩",
  "anmerkung": "Trennbar (eckte an, angeeckt), Perfekt mit «sein». Umgangssprachlich.",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Mit seiner Meinung eckt er oft an.",
      "uebersetzung": {
        "fa": "او با نظرش اغلب دیگران را می‌رنجاند.",
        "en": "He often rubs people up the wrong way with his opinion."
      }
    },
    {
      "niveau": "B2",
      "satz": "Weil sie immer ehrlich sagt, was sie denkt, ist sie bei ihren Vorgesetzten schon oft angeeckt.",
      "uebersetzung": {
        "fa": "چون همیشه رک می‌گوید چه فکر می‌کند، بارها با مدیرانش به مشکل خورده است.",
        "en": "Because she always says honestly what she thinks, she has often fallen foul of her superiors."
      }
    }
  ],
  "synonyme": [
    {
      "wort": "anstoßen",
      "uebersetzung": {
        "fa": "مایه‌ی رنجش شدن",
        "en": "to give offence"
      }
    }
  ],
