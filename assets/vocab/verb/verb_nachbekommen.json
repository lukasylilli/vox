    "fa": [
      "(از چیزی) دوباره یا بعداً گرفتن (مثلاً غذای بیشتر یا قطعه‌ای که تمام شده)"
    ],
    "en": [
      "to get more, to get (something) later"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Essen",
    "Einkaufen"
  ],
  "ipa": "ˈnaːxbəˌkɔmən",
  "anmerkung": null,
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Kann ich Suppe nachbekommen?",
      "uebersetzung": {
        "fa": "می‌توانم باز هم سوپ بگیرم؟",
        "en": "Can I have some more soup?"
      }
    },
    {
      "niveau": "B2",
      "satz": "Die Schuhe sind gerade ausverkauft, aber wir bekommen sie nächste Woche nach.",
      "uebersetzung": {
        "fa": "این کفش‌ها فعلاً تمام شده‌اند، اما هفته‌ی بعد دوباره به دستمان می‌رسند.",
        "en": "The shoes are sold out at the moment, but we will get more in next week."
      }
    }
  ],
