  "id": "verb_hergehen",
  "wort": "hergehen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(neben/hinter jemandem hergehen) کنار یا پشت سر (کسی) راه رفتن",
      "(es geht … her) (مهمانی یا جایی) شلوغ یا پرهیجان بودن"
    ],
    "en": [
      "to walk along (beside/behind someone)",
      "(es geht … her) things are lively, there is a lot going on"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Alltag",
    "Feste"
  ],
  "ipa": "ˈheːɐ̯ˌɡeːən",
  "anmerkung": null,
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Er geht hinter mir her.",
      "uebersetzung": {
        "fa": "او پشت سر من راه می‌رود.",
        "en": "He walks behind me."
      }
    },
    {
      "niveau": "B2",
      "satz": "Auf der Hochzeit ging es so lustig her, dass wir bis zum Morgen getanzt haben.",
      "uebersetzung": {
        "fa": "در عروسی آن‌قدر خوش گذشت که تا صبح رقصیدیم.",
        "en": "Things were so lively at the wedding that we danced until morning."
      }
    }
  ],
