  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "کوتاه آمدن، تسلیم شدن، (در برابر خواسته‌ای) کوتاه آمدن",
      "(زیر فشار) شُل شدن، وا دادن",
      "(قیمت) پایین آمدن"
    ],
    "en": [
      "to give in, to yield",
      "to give way (under pressure)",
      "(prices) to fall"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Beziehungen",
    "Konflikt"
  ],
