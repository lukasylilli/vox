      "uebersetzung": {
        "fa": "مادر کوتاه می‌آید.",
        "en": "The mother gives in."
      }
    },
    {
      "niveau": "B2",
      "satz": "Nach langer Diskussion hat der Chef nachgegeben und uns einen freien Tag erlaubt.",
      "uebersetzung": {
        "fa": "بعد از بحثی طولانی، رئیس کوتاه آمد و یک روز تعطیل به ما داد.",
        "en": "After a long discussion the boss gave in and allowed us a day off."
      }
    }
  ],
