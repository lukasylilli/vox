  "uebersetzung": {
    "fa": [
      "(محاوره، معمولاً منفی) کوتاه آمدن، ول کردن («nicht lockerlassen» = سمج بودن، دست برنداشتن)"
    ],
    "en": [
      "(colloquial, usually negated) to give up, to let up"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Umgangssprache",
    "Verhalten"
  ],
  "ipa": "ˈlɔkɐˌlasn̩",
  "anmerkung": "Umgangssprachlich, meist verneint: «nicht lockerlassen».",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Er lässt nicht locker.",
      "uebersetzung": {
        "fa": "دست برنمی‌دارد.",
        "en": "He won't let up."
      }
    },
    {
      "niveau": "B2",
      "satz": "Die Journalistin hat nicht lockergelassen, bis der Minister endlich eine klare Antwort gab.",
      "uebersetzung": {
        "fa": "خبرنگار دست برنداشت تا اینکه وزیر بالاخره پاسخ روشنی داد.",
        "en": "The journalist didn't let up until the minister finally gave a clear answer."
      }
    }
  ],
