  "id": "verb_ankreiden",
  "wort": "ankreiden",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(تقصیر را) به گردن کسی انداختن، سرزنش کردن"
    ],
    "en": [
      "to blame for",
      "to hold against"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Kommunikation"
  ],
  "ipa": "ˈanˌkʁaɪ̯dn̩",
  "anmerkung": "Trennbar (kreidete an, angekreidet). Mit Dativ der Person: «jemandem etwas ankreiden».",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Man kreidet ihm den Fehler an.",
      "uebersetzung": {
        "fa": "اشتباه را به گردن او می‌اندازند.",
        "en": "They blame him for the mistake."
      }
    },
    {
      "niveau": "B2",
      "satz": "Die Opposition kreidet der Regierung an, dass sie zu spät auf die Krise reagiert hat.",
      "uebersetzung": {
        "fa": "مخالفان دولت را سرزنش می‌کنند که دیر به بحران واکنش نشان داد.",
        "en": "The opposition holds it against the government that it reacted too late to the crisis."
      }
    }
  ],
  "synonyme": [
