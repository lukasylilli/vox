  "id": "verb_loslassen",
  "wort": "loslassen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(چیزی یا کسی را) رها کردن، ول کردن",
      "(از نظر احساسی) دل کندن، رها کردن",
      "(محاوره) (چیزی را) بر زبان آوردن، (کسی را به جان کسی) انداختن"
    ],
    "en": [
      "to let go (of)",
      "to let go (emotionally)",
      "(colloquial) to come out with; to set (someone) on"
    ]
  },
  "niveau": "B1",
  "themen": [
    "Gefühle",
    "Alltag"
  ],
  "ipa": "ˈloːsˌlasn̩",
  "anmerkung": null,
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Lass meine Hand nicht los!",
      "uebersetzung": {
        "fa": "دستم را ول نکن!",
        "en": "Don't let go of my hand!"
      }
    },
    {
      "niveau": "B2",
      "satz": "Für viele Eltern ist es schwer, ihre Kinder loszulassen, wenn sie zum Studium wegziehen.",
      "uebersetzung": {
        "fa": "برای بسیاری از والدین سخت است که وقتی بچه‌هایشان برای تحصیل می‌روند، از آن‌ها دل بکنند.",
        "en": "For many parents it is hard to let their children go when they move away to study."
      }
    }
  ],
