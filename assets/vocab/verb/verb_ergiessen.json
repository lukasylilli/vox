  "wort": "ergießen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(sich ergießen) (مایع) سرازیر شدن، جاری شدن",
      "(ادبی) (سیلی از کلمات و مانند آن) فرو ریختن"
    ],
    "en": [
      "(sich) to pour out, to flow (into)",
      "(literary) to pour forth"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Natur",
    "Literatur"
  ],
  "ipa": "ɛɐ̯ˈɡiːsn̩",
  "anmerkung": null,
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Der Regen ergießt sich über die Stadt.",
      "uebersetzung": {
        "fa": "باران بر شهر فرو می‌ریزد.",
        "en": "The rain pours down over the town."
      }
    },
    {
      "niveau": "B2",
      "satz": "Nach dem Dammbruch ergossen sich riesige Wassermassen in das Tal und zerstörten mehrere Dörfer.",
      "uebersetzung": {
        "fa": "پس از شکستن سد، حجم عظیمی از آب به دره سرازیر شد و چند روستا را ویران کرد.",
        "en": "After the dam burst, huge masses of water poured into the valley and destroyed several villages."
      }
    }
  ],
