    {
      "niveau": "A2",
      "satz": "Das Land schottet sich ab.",
      "uebersetzung": {
        "fa": "این کشور خودش را (از دنیا) جدا می‌کند.",
        "en": "The country is sealing itself off."
      }
    },
    {
      "niveau": "B2",
      "satz": "Der Star schottet sich von der Presse ab, weil er seine Familie schützen will.",
      "uebersetzung": {
        "fa": "این ستاره خودش را از مطبوعات دور نگه می‌دارد، چون می‌خواهد از خانواده‌اش محافظت کند.",
        "en": "The star shuts himself off from the press because he wants to protect his family."
      }
    }
  ],
