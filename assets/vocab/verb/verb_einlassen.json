  "id": "verb_einlassen",
  "wort": "einlassen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(کسی را) راه دادن، اجازه‌ی ورود دادن",
      "(آب را در وان) ریختن، پر کردن",
      "(sich auf etwas einlassen) پذیرفتن، تن دادن به، درگیر (چیزی) شدن"
    ],
    "en": [
      "to let in, to admit",
      "to run (water, a bath)",
      "(sich auf etwas) to get involved in, to agree to"
    ]
  },
  "niveau": "B1",
  "themen": [
    "Alltag",
    "Beziehungen"
  ],
  "ipa": "ˈaɪ̯nˌlasn̩",
  "anmerkung": null,
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Der Türsteher lässt uns nicht ein.",
      "uebersetzung": {
        "fa": "دربان ما را راه نمی‌دهد.",
        "en": "The bouncer won't let us in."
      }
    },
    {
      "niveau": "B2",
      "satz": "Ich habe mich auf das Angebot eingelassen, obwohl ich die Bedingungen nicht ganz verstanden hatte.",
      "uebersetzung": {
        "fa": "پیشنهاد را پذیرفتم، با اینکه شرایطش را کاملاً نفهمیده بودم.",
        "en": "I agreed to the offer, although I hadn't fully understood the conditions."
      }
    }
  ],
