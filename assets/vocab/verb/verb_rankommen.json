{
  "schema": "3.0",
  "id": "verb_rankommen",
  "wort": "rankommen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(محاوره) نزدیک آمدن",
      "(محاوره، an etwas rankommen) به (چیزی) دسترسی پیدا کردن",
      "(محاوره) نوبت (کسی) شدن"
    ],
    "en": [
      "(colloquial) to come near",
      "(colloquial, an etw) to get at, to reach",
      "(colloquial) to have one's turn"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Umgangssprache",
    "Alltag"
  ],
  "ipa": "ˈʁanˌkɔmən",
  "anmerkung": "Umgangssprachlich für «heran…».",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Ich komme nicht ans Regal ran.",
      "uebersetzung": {
        "fa": "دستم به قفسه نمی‌رسد.",
        "en": "I can't reach the shelf."
      }
    },
    {
      "niveau": "B2",
      "satz": "An gute Konzertkarten kommt man nur ran, wenn man sofort nach dem Verkaufsstart bucht.",
      "uebersetzung": {
        "fa": "بلیت‌های خوب کنسرت را فقط وقتی می‌شود گیر آورد که بلافاصله بعد از شروع فروش رزرو کنی.",
        "en": "You can only get hold of good concert tickets if you book right after sales open."
      }
    }
  ],
  "synonyme": [
