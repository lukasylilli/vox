  "id": "verb_lassen",
  "wort": "lassen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "گذاشتن، اجازه دادن",
      "(کاری را) ترک کردن، دست کشیدن از",
      "(کاری را) سپردن، (کسی را وادار به کاری) کردن («Ich lasse mein Auto reparieren» = ماشینم را می‌دهم تعمیر کنند)"
    ],
    "en": [
      "to let, to allow",
      "to stop, to leave (doing something)",
      "to have (something done)"
    ]
  },
  "niveau": "A2",
  "themen": [
    "Alltag",
    "Grammatik"
  ],
  "ipa": "ˈlasn̩",
  "anmerkung": "Mit Infinitiv Ersatzinfinitiv statt Partizip II: «Ich habe das Auto reparieren lassen».",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Lass mich bitte in Ruhe!",
      "uebersetzung": {
        "fa": "لطفاً راحتم بگذار!",
        "en": "Please leave me alone!"
      }
    },
    {
      "niveau": "B1",
      "satz": "Ich lasse mir die Haare schneiden, bevor wir zur Hochzeit fahren.",
      "uebersetzung": {
        "fa": "قبل از اینکه به عروسی برویم، موهایم را کوتاه می‌کنم (می‌دهم کوتاه کنند).",
        "en": "I'm going to have my hair cut before we go to the wedding."
      }
    }
  ],
  "synonyme": [
