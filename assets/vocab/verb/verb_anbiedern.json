  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Er biedert sich beim Chef an.",
      "uebersetzung": {
        "fa": "او پیش رئیس خودشیرینی می‌کند.",
        "en": "He is sucking up to the boss."
      }
    },
    {
      "niveau": "B2",
      "satz": "Die Partei biedert sich bei jungen Wählern an, ohne wirklich etwas für sie zu tun.",
      "uebersetzung": {
        "fa": "حزب برای رأی‌دهندگان جوان خودشیرینی می‌کند، بی‌آنکه واقعاً کاری برایشان بکند.",
        "en": "The party is currying favour with young voters without really doing anything for them."
      }
    }
  ],
