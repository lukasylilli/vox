  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "خم کردن، تا کردن",
      "(به سمتی) پیچیدن"
    ],
    "en": [
      "to bend (over)",
      "to turn (around)"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Alltag"
  ],
  "ipa": "ˈʊmˌbiːɡn̩",
  "anmerkung": "Transitiv mit «haben» (Er hat den Draht umgebogen); intransitiv mit «sein» (Der Weg ist nach links umgebogen).",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Er biegt den Draht um.",
      "uebersetzung": {
        "fa": "او سیم را خم می‌کند.",
        "en": "He bends the wire over."
      }
    },
    {
      "niveau": "B2",
      "satz": "Die Seite war so oft umgebogen worden, dass sie schließlich abgerissen ist.",
      "uebersetzung": {
        "fa": "صفحه آن‌قدر تا شده بود که بالاخره کنده شد.",
        "en": "The page had been folded over so often that it finally tore off."
      }
    }
  ],
