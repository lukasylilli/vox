  "id": "verb_hineinfinden",
  "wort": "hineinfinden",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "راه ورود به (جایی) را پیدا کردن",
      "(sich hineinfinden) با (وضع یا نقش تازه‌ای) خو گرفتن"
    ],
    "en": [
      "to find one's way in",
      "(sich) to get used to, to settle into"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Arbeit",
    "Gefühle"
  ],
  "ipa": "hɪˈnaɪ̯nˌfɪndn̩",
  "anmerkung": null,
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Ich finde nicht hinein.",
      "uebersetzung": {
        "fa": "راه ورود را پیدا نمی‌کنم.",
        "en": "I can't find my way in."
      }
    },
    {
      "niveau": "B2",
      "satz": "Am Anfang war die neue Stelle schwer, aber inzwischen habe ich mich gut hineingefunden.",
      "uebersetzung": {
        "fa": "اوایل کار جدید سخت بود، اما حالا خوب با آن خو گرفته‌ام.",
        "en": "At first the new job was hard, but by now I have settled into it well."
      }
    }
  ],
