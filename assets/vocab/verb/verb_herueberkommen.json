  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "از آن طرف به این طرف آمدن",
      "(محاوره) (به خانه‌ی کسی) سر زدن، آمدن"
    ],
    "en": [
      "to come over",
      "(colloquial) to come round, to drop by"
    ]
  },
  "niveau": "B1",
  "themen": [
    "Alltag",
    "Freizeit"
  ],
  "ipa": "hɛˈʁyːbɐˌkɔmən",
  "anmerkung": "Umgangssprachlich oft «rüber…».",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Komm doch heute Abend herüber!",
      "uebersetzung": {
        "fa": "امشب بیا پیش ما!",
        "en": "Come over this evening!"
      }
    },
    {
      "niveau": "B1",
      "satz": "Die Großeltern sind gestern herübergekommen, um mit den Kindern zu spielen.",
      "uebersetzung": {
        "fa": "پدربزرگ و مادربزرگ دیروز آمدند پیش ما تا با بچه‌ها بازی کنند.",
        "en": "The grandparents came over yesterday to play with the children."
      }
    }
  ],
