  "id": "verb_stechen",
  "wort": "stechen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "نیش زدن",
      "(با چیز نوک‌تیز) فرو کردن، سوراخ کردن",
      "(درد) تیر کشیدن"
    ],
    "en": [
      "to sting",
      "to prick, to stab",
      "to have a stabbing pain"
    ]
  },
  "niveau": "B1",
  "themen": [
    "Natur",
    "Gesundheit"
  ],
  "ipa": "ˈʃtɛçn̩",
  "anmerkung": null,
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Eine Biene hat mich gestochen.",
      "uebersetzung": {
        "fa": "یک زنبور نیشم زد.",
        "en": "A bee stung me."
      }
    },
    {
      "niveau": "B2",
      "satz": "Seit ich gestern so viel gelaufen bin, sticht es mir in der Seite.",
      "uebersetzung": {
        "fa": "از وقتی دیروز آن‌قدر دویدم، پهلویم تیر می‌کشد.",
        "en": "Since I ran so much yesterday, I've had a stabbing pain in my side."
      }
    }
  ],
  "synonyme": [
