  "uebersetzung": {
    "fa": [
      "(ادبی) راه را گم کردن",
      "(در فرض یا حدسی) اشتباه کردن"
    ],
    "en": [
      "(literary) to go astray",
      "to be mistaken (in an assumption)"
    ]
  },
  "niveau": "C1",
  "themen": [
