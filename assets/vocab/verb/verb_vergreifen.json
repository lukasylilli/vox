  "id": "verb_vergreifen",
  "wort": "vergreifen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(در انتخاب) اشتباه کردن",
      "دست‌درازی کردن (به مال یا کسی)"
    ],
    "en": [
      "to make a wrong choice (of words, tone)",
      "to lay hands on, to misappropriate"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Verhalten",
    "Recht"
  ],
  "ipa": "fɛɐ̯ˈɡʁaɪ̯fn̩",
