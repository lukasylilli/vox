  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Er hat sich im Ton vergriffen.",
      "uebersetzung": {
        "fa": "او لحن نامناسبی به کار برد.",
        "en": "He struck the wrong tone."
      }
    },
    {
      "niveau": "B2",
      "satz": "Der Kassierer wurde entlassen, weil er sich an der Kasse vergriffen hatte.",
      "uebersetzung": {
        "fa": "صندوق‌دار اخراج شد، چون به پول صندوق دست‌درازی کرده بود.",
        "en": "The cashier was dismissed because he had helped himself from the till."
      }
    }
  ],
