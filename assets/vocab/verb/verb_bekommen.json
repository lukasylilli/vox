  "uebersetzung": {
    "fa": [
      "گرفتن، دریافت کردن",
      "(بیماری) گرفتن",
      "(jemandem gut bekommen) به کسی ساختن (غذا)"
    ],
    "en": [
      "to get",
      "to receive",
      "to agree with (food)"
    ]
  },
  "niveau": "A1",
