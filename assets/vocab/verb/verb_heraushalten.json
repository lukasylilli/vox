  "id": "verb_heraushalten",
  "wort": "heraushalten",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(چیزی را از جایی) بیرون نگه داشتن",
      "(sich heraushalten) دخالت نکردن، خود را کنار کشیدن"
    ],
    "en": [
      "to hold out, to keep out",
      "(sich) to keep out of, to stay out of"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Beziehungen",
    "Konflikt"
  ],
  "ipa": "hɛˈʁaʊ̯sˌhaltn̩",
  "anmerkung": null,
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Halt dich da heraus!",
      "uebersetzung": {
        "fa": "خودت را قاطی نکن!",
        "en": "Stay out of it!"
      }
    },
    {
      "niveau": "B2",
      "satz": "Bei Streitigkeiten zwischen den Kollegen versucht er, sich so gut wie möglich herauszuhalten.",
      "uebersetzung": {
        "fa": "در دعواهای بین همکاران، او سعی می‌کند تا جای ممکن دخالت نکند.",
        "en": "In disputes between colleagues he tries to stay out of it as much as possible."
      }
    }
  ],
  "synonyme": [
