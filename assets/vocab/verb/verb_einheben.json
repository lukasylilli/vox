  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(اتریش) (عوارض، مالیات یا پول را) دریافت کردن، وصول کردن",
      "(در لولا یا جای خود) جا انداختن"
    ],
    "en": [
      "(Austrian) to collect, to levy (fees, taxes)",
      "to lift into place (e.g. a door onto its hinges)"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Behörde",
    "Finanzen",
    "Österreich"
  ],
