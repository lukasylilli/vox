    {
      "niveau": "A2",
      "satz": "Der Reis backt im Topf an.",
      "uebersetzung": {
        "fa": "برنج ته قابلمه می‌چسبد.",
        "en": "The rice is sticking to the pot."
      }
    },
    {
      "niveau": "B2",
      "satz": "Wenn man den Kuchen nicht in eine gefettete Form gibt, ist er hinterher am Boden angebacken.",
      "uebersetzung": {
        "fa": "اگر کیک را در قالب چرب‌شده نریزی، بعداً به کف قالب می‌چسبد.",
        "en": "If you don't put the cake in a greased tin, it ends up stuck to the bottom."
      }
    }
