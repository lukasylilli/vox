  "id": "verb_herausfliegen",
  "wort": "herausfliegen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(از جایی) پرواز کردن و بیرون آمدن، بیرون پریدن",
      "(محاوره) اخراج شدن، بیرون انداخته شدن"
    ],
    "en": [
      "to fly out",
      "(colloquial) to be kicked out"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Alltag",
    "Umgangssprache"
  ],
  "ipa": "hɛˈʁaʊ̯sˌfliːɡn̩",
  "anmerkung": "Umgangssprachlich oft «rauskommen», «rausfinden» usw. In der Bedeutung «hinausgeworfen werden» umgangssprachlich.",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Ein Vogel fliegt aus dem Nest heraus.",
      "uebersetzung": {
        "fa": "پرنده‌ای از لانه بیرون می‌پرد.",
        "en": "A bird flies out of the nest."
      }
    },
    {
      "niveau": "B2",
      "satz": "Weil er dreimal zu spät kam, ist er aus dem Kurs herausgeflogen.",
      "uebersetzung": {
        "fa": "چون سه بار دیر آمد، از دوره اخراج شد.",
        "en": "Because he was late three times, he got kicked out of the course."
      }
    }
  ],
  "synonyme": [
    {
      "wort": "rausfliegen",
      "uebersetzung": {
        "fa": "(محاوره) اخراج شدن",
        "en": "to get kicked out"
      }
    },
    {
      "wort": "hinausgeworfen werden",
      "uebersetzung": {
        "fa": "بیرون انداخته شدن",
        "en": "to be thrown out"
      }
    }
  ],
