  "wort": "gegenhalten",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(محاوره) مقاومت کردن، در برابر (چیزی) ایستادن",
      "(محاوره) استدلال مخالف آوردن"
    ],
    "en": [
      "(colloquial) to resist, to counter",
      "(colloquial) to object, to argue against"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Diskussion",
    "Sport"
  ],
  "ipa": "ˈɡeːɡn̩ˌhaltn̩",
  "anmerkung": "Umgangssprachlich; gehoben eher «dagegenhalten» oder «entgegenhalten».",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Wir müssen gegenhalten.",
      "uebersetzung": {
        "fa": "باید ایستادگی کنیم.",
        "en": "We have to push back."
      }
    },
    {
      "niveau": "B2",
      "satz": "Als die Gegner immer stärker angriffen, hat die Mannschaft mit aller Kraft gegengehalten.",
      "uebersetzung": {
        "fa": "وقتی حریفان مدام قوی‌تر حمله می‌کردند، تیم با تمام قوا ایستادگی کرد.",
        "en": "When the opponents attacked harder and harder, the team pushed back with all their strength."
      }
    }
  ],
