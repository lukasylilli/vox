  "wort": "ergehen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(es ergeht jemandem) حال و روز (کسی) بودن، بر (کسی) گذشتن",
      "(رسمی) (حکم یا دستوری) صادر شدن",
      "(sich ergehen in) زیاده‌روی کردن در (سخن)"
    ],
    "en": [
      "(es ergeht jdm) to fare",
      "(formal) to be issued (order, judgement)",
      "(sich in etwas) to indulge in"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Gefühle",
    "Recht"
  ],
  "ipa": "ɛɐ̯ˈɡeːən",
  "anmerkung": null,
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Wie ist es dir ergangen?",
      "uebersetzung": {
        "fa": "چه بر سرت آمد؟ (روزگارت چطور گذشت؟)",
        "en": "How did you get on?"
      }
    },
    {
      "niveau": "B2",
      "satz": "Gestern ist das Urteil ergangen, und der Angeklagte muss eine hohe Geldstrafe zahlen.",
      "uebersetzung": {
        "fa": "دیروز حکم صادر شد و متهم باید جریمه‌ی نقدی سنگینی بپردازد.",
        "en": "Yesterday the judgement was issued, and the defendant has to pay a heavy fine."
      }
    }
  ],
