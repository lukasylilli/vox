  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Das Gericht gibt der Klage statt.",
      "uebersetzung": {
        "fa": "دادگاه شکایت را می‌پذیرد.",
        "en": "The court upholds the complaint."
      }
    },
    {
      "niveau": "B2",
      "satz": "Nachdem alle Unterlagen geprüft worden waren, hat die Behörde meinem Antrag stattgegeben.",
      "uebersetzung": {
        "fa": "بعد از آنکه همه‌ی مدارک بررسی شد، اداره با درخواست من موافقت کرد.",
        "en": "After all the documents had been checked, the authority granted my application."
      }
    }
  ],
  "synonyme": [
