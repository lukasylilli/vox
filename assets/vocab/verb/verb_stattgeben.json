  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(درخواستی را) پذیرفتن، با چیزی موافقت کردن (اداری/حقوقی)"
    ],
    "en": [
      "to grant",
      "to accept (a request)"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Recht",
    "Verwaltung"
  ],
