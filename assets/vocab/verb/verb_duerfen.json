  "wort": "dürfen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "اجازه داشتن، مجاز بودن",
      "(در نفی) نباید",
      "(dürfte) احتمالاً"
    ],
    "en": [
      "to be allowed to, may",
      "(negated) must not",
      "(dürfte) probably"
    ]
  },
  "niveau": "A1",
  "themen": [
    "Alltag",
    "Grammatik"
  ],
  "ipa": "ˈdʏʁfn̩",
  "anmerkung": "Modalverb: kein Imperativ. Partizip II «gedurft» nur als Vollverb; mit Infinitiv Ersatzinfinitiv («Er hat kommen dürfen»).",
  "beispiele": [
    {
      "niveau": "A1",
      "satz": "Darf ich hier rauchen?",
      "uebersetzung": {
        "fa": "اجازه دارم اینجا سیگار بکشم؟",
        "en": "May I smoke here?"
      }
    },
    {
      "niveau": "B1",
      "satz": "Die Ärztin sagt, dass ich nach der Operation drei Tage nichts essen darf.",
      "uebersetzung": {
        "fa": "پزشک می‌گوید که بعد از عمل سه روز نباید چیزی بخورم.",
        "en": "The doctor says that I must not eat anything for three days after the operation."
      }
    }
  ],
  "synonyme": [
