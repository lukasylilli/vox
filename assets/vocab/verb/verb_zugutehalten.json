  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Man muss ihm sein Alter zugutehalten.",
      "uebersetzung": {
        "fa": "باید سن او را در نظر گرفت (و بر او سخت نگرفت).",
        "en": "You have to make allowances for his age."
      }
    },
    {
      "niveau": "B2",
      "satz": "Man muss der Firma zugutehalten, dass sie den Fehler sofort korrigiert hat.",
      "uebersetzung": {
        "fa": "باید به نفع شرکت در نظر گرفت که اشتباه را فوراً اصلاح کرد.",
        "en": "You have to give the company credit for correcting the mistake immediately."
      }
    }
  ],
