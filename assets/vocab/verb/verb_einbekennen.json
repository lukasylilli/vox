    {
      "niveau": "A2",
      "satz": "Der Minister bekennt seinen Fehler ein.",
      "uebersetzung": {
        "fa": "وزیر اشتباهش را می‌پذیرد.",
        "en": "The minister admits his mistake."
      }
    },
    {
      "niveau": "B2",
      "satz": "Erst nach langem Zögern hat die Firma einbekannt, dass die Daten gestohlen worden waren.",
      "uebersetzung": {
        "fa": "شرکت تنها پس از تردیدی طولانی پذیرفت که داده‌ها دزدیده شده بودند.",
        "en": "Only after long hesitation did the company admit that the data had been stolen."
      }
    }
