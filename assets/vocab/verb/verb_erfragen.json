  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(اطلاعاتی را) با پرسیدن به دست آوردن، استعلام کردن"
    ],
    "en": [
      "to ask for, to inquire about, to ascertain by asking"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Kommunikation",
    "Behörde"
  ],
  "ipa": "ɛɐ̯ˈfʁaːɡn̩",
  "anmerkung": "In der Verbliste unter den unregelmäßigen Verben; konjugiert regelmäßig (erfragte, erfragt) wie fragen.",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Die Preise können Sie telefonisch erfragen.",
      "uebersetzung": {
        "fa": "قیمت‌ها را می‌توانید تلفنی بپرسید.",
        "en": "You can ask about the prices by phone."
      }
    },
    {
      "niveau": "B2",
      "satz": "Bevor die Behandlung beginnt, erfragt die Ärztin genau, welche Medikamente der Patient einnimmt.",
      "uebersetzung": {
        "fa": "پیش از شروع درمان، پزشک دقیقاً می‌پرسد که بیمار چه داروهایی مصرف می‌کند.",
        "en": "Before treatment begins, the doctor asks exactly which medicines the patient is taking."
      }
    }
  ],
