  "uebersetzung": {
    "fa": [
      "(از کتابخانه و مانند آن) امانت گرفتن",
      "(واژه یا اندیشه‌ای از جای دیگر) وام گرفتن"
    ],
    "en": [
      "to borrow (from a library)",
      "to borrow (a word, idea)"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Bildung",
    "Bibliothek",
    "Sprache"
  ],
  "ipa": "ɛntˈlaɪ̯ən",
  "anmerkung": null,
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Ich entleihe drei Bücher.",
      "uebersetzung": {
        "fa": "سه کتاب امانت می‌گیرم.",
        "en": "I'm borrowing three books."
      }
    },
    {
      "niveau": "B2",
      "satz": "Viele Wörter im Deutschen sind aus dem Französischen entliehen, zum Beispiel «Restaurant».",
      "uebersetzung": {
        "fa": "بسیاری از واژه‌های آلمانی از فرانسوی وام گرفته شده‌اند، برای مثال «رستوران».",
        "en": "Many German words are borrowed from French, for example «Restaurant»."
      }
    }
  ],
