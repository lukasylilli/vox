  "wort": "zulaufen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "دوان‌دوان به طرف کسی رفتن",
      "(حیوان) پناه آوردن به کسی",
      "(شکل) باریک شدن به‌سوی"
    ],
    "en": [
      "to run towards",
      "to stray to someone (animal)",
      "to taper"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Alltag",
    "Tiere"
  ],
  "ipa": "ˈt͡suːˌlaʊ̯fn̩",
  "anmerkung": "Trennbar (lief zu, zugelaufen), Perfekt mit «sein». «Uns ist eine Katze zugelaufen.» Form: «spitz zulaufen».",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Das Kind läuft auf seine Mutter zu.",
      "uebersetzung": {
        "fa": "بچه به طرف مادرش می‌دود.",
        "en": "The child runs towards its mother."
      }
    },
    {
      "niveau": "B2",
      "satz": "Die Katze, die uns letzten Winter zugelaufen ist, wohnt jetzt bei uns.",
      "uebersetzung": {
        "fa": "گربه‌ای که زمستان گذشته به ما پناه آورد، حالا پیش ما زندگی می‌کند.",
        "en": "The cat that strayed to us last winter now lives with us."
      }
    }
  ],
  "synonyme": [
