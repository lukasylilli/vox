  "id": "verb_entbehren",
  "wort": "entbehren",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(از چیزی) محروم بودن، بی‌بهره ماندن، نبودِ (چیزی را) تحمل کردن",
      "(+ Genitiv) فاقد (چیزی) بودن"
    ],
    "en": [
      "to do without, to spare",
      "(+ genitive) to lack"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Gefühle",
    "Sprache (gehoben)"
  ],
  "ipa": "ɛntˈbeːʁən",
  "anmerkung": "In der Verbliste unter den unregelmäßigen Verben; konjugiert regelmäßig (entbehrte, entbehrt). Mit Genitiv gehoben: «Das entbehrt jeder Grundlage».",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Ich kann das Auto nicht entbehren.",
      "uebersetzung": {
        "fa": "نمی‌توانم از ماشین چشم‌پوشی کنم.",
        "en": "I can't do without the car."
      }
    },
    {
      "niveau": "B2",
      "satz": "Als Kind musste er vieles entbehren, weil seine Eltern sehr wenig Geld hatten.",
      "uebersetzung": {
        "fa": "در کودکی ناچار بود از خیلی چیزها محروم باشد، چون پدر و مادرش پول خیلی کمی داشتند.",
        "en": "As a child he had to do without a lot because his parents had very little money."
      }
    }
  ],
  "synonyme": [
