  "uebersetzung": {
    "fa": [
      "(چیزی را با زحمت) پایین آوردن",
      "(غذا را به‌زحمت) قورت دادن",
      "(تب یا قیمتی را) پایین آوردن"
    ],
    "en": [
      "to get (something) down",
      "to get (food) down, to swallow",
      "to bring down (fever, price)"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Alltag",
    "Gesundheit"
  ],
