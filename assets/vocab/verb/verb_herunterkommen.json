  "uebersetzung": {
    "fa": [
      "پایین آمدن",
      "(از نظر مالی، جسمی یا ظاهری) به روز بد افتادن، خراب شدن",
      "(محاوره) آرام شدن، به حالت عادی برگشتن"
    ],
    "en": [
      "to come down",
      "to go downhill, to become run-down",
      "(colloquial) to calm down, to come down"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Alltag",
    "Gefühle"
  ],
