  "anmerkung": "Regelmäßig (amortisierte, amortisiert); meist reflexiv: «sich amortisieren».",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Die Solaranlage amortisiert sich.",
      "uebersetzung": {
        "fa": "سامانه‌ی خورشیدی هزینه‌اش را برمی‌گرداند.",
        "en": "The solar system pays for itself."
      }
    },
    {
      "niveau": "B2",
      "satz": "Die teure Maschine hat sich schon nach zwei Jahren amortisiert, weil sie so viel Energie spart.",
      "uebersetzung": {
        "fa": "دستگاه گران‌قیمت پس از دو سال هزینه‌اش را برگرداند، چون این‌قدر انرژی صرفه‌جویی می‌کند.",
        "en": "The expensive machine paid for itself after just two years because it saves so much energy."
      }
    }
  ],
  "synonyme": [
