  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(با وسیله‌ی نقلیه) پایین آمدن",
      "(رایانه را) خاموش کردن",
      "(تولید یا هزینه‌ای را) کاهش دادن"
    ],
    "en": [
      "to drive down, to come down",
      "to shut down (a computer)",
      "to cut back, to scale down"
    ]
  },
