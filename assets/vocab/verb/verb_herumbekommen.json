  "id": "verb_herumbekommen",
  "wort": "herumbekommen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(محاوره) (کسی را) راضی کردن، متقاعد کردن",
      "(محاوره) (زمانی را) سپری کردن"
    ],
    "en": [
      "(colloquial) to talk (someone) round",
      "(colloquial) to get through (time)"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Kommunikation",
    "Umgangssprache"
  ],
  "ipa": "hɛˈʁʊmbəˌkɔmən",
  "anmerkung": "Umgangssprachlich.",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Ich bekomme ihn schon herum.",
      "uebersetzung": {
        "fa": "بالاخره راضی‌اش می‌کنم.",
        "en": "I'll talk him round."
      }
    },
    {
      "niveau": "B2",
      "satz": "Nach langem Bitten hat sie ihre Eltern herumbekommen, dass sie allein nach Wien fahren darf.",
      "uebersetzung": {
        "fa": "بعد از خواهش زیاد، پدر و مادرش را راضی کرد که اجازه بدهند تنها به وین برود.",
        "en": "After a lot of pleading she talked her parents round into letting her go to Vienna alone."
      }
    }
  ],
