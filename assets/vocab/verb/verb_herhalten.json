  "id": "verb_herhalten",
  "wort": "herhalten",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(چیزی را) جلو آوردن و نگه داشتن",
      "(als etwas herhalten müssen) مجبور بودن (برای کسی) قربانی یا بهانه شدن"
    ],
    "en": [
      "to hold out",
      "(als etwas herhalten müssen) to have to serve as, to be made to take the blame"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Beziehungen",
    "Arbeit"
  ],
  "ipa": "ˈheːɐ̯ˌhaltn̩",
  "anmerkung": null,
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Kannst du mal die Tasche herhalten?",
      "uebersetzung": {
        "fa": "می‌شود کیف را بیاوری جلو و نگه داری؟",
        "en": "Can you hold the bag out?"
      }
    },
    {
      "niveau": "B2",
      "satz": "Bei jedem Fehler im Team muss immer der Praktikant als Sündenbock herhalten.",
      "uebersetzung": {
        "fa": "برای هر اشتباهی در تیم، همیشه کارآموز باید سپر بلا شود.",
        "en": "For every mistake in the team, the intern always has to serve as the scapegoat."
      }
    }
  ],
  "synonyme": [
