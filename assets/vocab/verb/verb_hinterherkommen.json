{
  "schema": "3.0",
  "id": "verb_hinterherkommen",
  "wort": "hinterherkommen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "پشت سر (کسی) آمدن",
      "(محاوره) (با سرعت دیگران یا کار) همگام شدن، عقب نماندن"
    ],
    "en": [
      "to come behind, to follow",
      "(colloquial) to keep up"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Arbeit",
    "Lernen"
  ],
  "ipa": "hɪntɐˈheːɐ̯ˌkɔmən",
  "anmerkung": null,
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Ich komme gleich hinterher.",
      "uebersetzung": {
        "fa": "الان پشت سرت می‌آیم.",
        "en": "I'll follow right behind."
      }
    },
    {
      "niveau": "B2",
      "satz": "Der Lehrer erklärt so schnell, dass viele Schüler mit dem Mitschreiben nicht hinterherkommen.",
      "uebersetzung": {
        "fa": "معلم آن‌قدر سریع توضیح می‌دهد که خیلی از دانش‌آموزان در یادداشت‌برداری عقب می‌مانند.",
        "en": "The teacher explains so fast that many pupils can't keep up with taking notes."
      }
    }
  ],
  "synonyme": [
    {
      "wort": "mitkommen",
      "uebersetzung": {
        "fa": "همراه شدن؛ (درس را) دنبال کردن",
        "en": "to keep up"
      }
    },
    {
      "wort": "nachkommen",
      "uebersetzung": {
        "fa": "بعداً آمدن",
        "en": "to follow later"
      }
    }
  ],
  "antonyme": [
    {
      "wort": "zurückbleiben",
      "uebersetzung": {
        "fa": "عقب ماندن",
        "en": "to fall behind"
      }
    }
  ],
