  "uebersetzung": {
    "fa": [
      "بعداً آمدن، دنبال (کسی) آمدن",
      "(einer Pflicht/Bitte nachkommen) (وظیفه یا درخواستی را) انجام دادن، به جا آوردن",
      "(با کار) همپا بودن"
    ],
    "en": [
      "to come later, to follow",
      "to comply with, to fulfil (a duty, request)",
      "to keep up (with work)"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Alltag",
    "Behörde",
    "Arbeit"
  ],
