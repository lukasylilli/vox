  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(محاوره) (کسی یا چیزی را) به اینجا آوردن، تهیه کردن، از جایی پیدا کردن"
    ],
    "en": [
      "(colloquial) to get hold of, to get (from somewhere)"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Alltag",
    "Umgangssprache"
  ],
  "ipa": "ˈheːɐ̯bəˌkɔmən",
  "anmerkung": "Umgangssprachlich.",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Wo bekomme ich das her?",
      "uebersetzung": {
        "fa": "این را از کجا گیر بیاورم؟",
        "en": "Where can I get that?"
      }
    },
    {
      "niveau": "B2",
      "satz": "Ich weiß nicht, wo wir so kurzfristig noch einen Babysitter herbekommen sollen.",
      "uebersetzung": {
        "fa": "نمی‌دانم این‌قدر دیروقت از کجا یک پرستار بچه گیر بیاوریم.",
        "en": "I don't know where we're supposed to get a babysitter at such short notice."
      }
    }
  ],
  "synonyme": [
