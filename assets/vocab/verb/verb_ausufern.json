    {
      "niveau": "A2",
      "satz": "Die Kosten ufern aus.",
      "uebersetzung": {
        "fa": "هزینه‌ها از کنترل خارج می‌شوند.",
        "en": "The costs are getting out of hand."
      }
    },
    {
      "niveau": "B2",
      "satz": "Die Sitzung ist völlig ausgeufert, weil jeder zu jedem Punkt etwas sagen wollte.",
