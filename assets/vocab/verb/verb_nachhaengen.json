  "id": "verb_nachhaengen",
  "wort": "nachhängen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(در فکر یا خاطره‌ای) غرق بودن، (به گذشته) دل‌مشغول بودن",
      "(در کار یا درس) عقب بودن"
    ],
    "en": [
      "to dwell on, to be lost in (thoughts)",
      "to lag behind"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Gefühle",
    "Lernen"
  ],
  "ipa": "ˈnaːxˌhɛŋən",
  "anmerkung": "Intransitiv: hing nach, nachgehangen; in Süddeutschland und Österreich auch mit «sein».",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Er hängt seinen Gedanken nach.",
      "uebersetzung": {
        "fa": "غرق افکارش است.",
        "en": "He is lost in his thoughts."
      }
    },
    {
      "niveau": "B2",
      "satz": "Sie hängt immer noch der alten Beziehung nach, obwohl sie schon zwei Jahre vorbei ist.",
      "uebersetzung": {
        "fa": "هنوز دل‌مشغول آن رابطه‌ی قدیمی است، با اینکه دو سال از تمام شدنش گذشته.",
        "en": "She is still dwelling on the old relationship, although it ended two years ago."
      }
    }
  ],
