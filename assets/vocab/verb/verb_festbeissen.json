    {
      "niveau": "A2",
      "satz": "Der Hund beißt sich am Stock fest.",
      "uebersetzung": {
        "fa": "سگ چوب را محکم با دندان گرفته و ول نمی‌کند.",
        "en": "The dog hangs on to the stick with its teeth."
      }
    },
    {
      "niveau": "B2",
      "satz": "Ich habe mich an dieser Matheaufgabe so festgebissen, dass ich die anderen Aufgaben vergessen habe.",
      "uebersetzung": {
        "fa": "آن‌قدر سر این مسئله‌ی ریاضی گیر کردم که بقیه‌ی مسئله‌ها را فراموش کردم.",
        "en": "I got so stuck on this maths problem that I forgot the other tasks."
      }
    }
  ],
