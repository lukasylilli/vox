  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(sich festbeißen) (حیوان) با دندان محکم گرفتن و رها نکردن",
      "(در کار یا مسئله‌ای) گیر کردن، سمج شدن"
    ],
    "en": [
      "(sich) to bite and hold on",
      "(sich) to get stuck on, to become obsessed with"
    ]
  },
  "niveau": "C1",
