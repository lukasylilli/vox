  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "قطع کردن (حرف کسی)",
      "(کاری را) موقتاً متوقف کردن"
    ],
    "en": [
      "to interrupt",
      "to suspend, to break off"
    ]
  },
  "niveau": "B1",
  "themen": [
    "Kommunikation",
    "Arbeit"
  ],
  "ipa": "ʊntɐˈbʁɛçn̩",
  "anmerkung": "Untrennbar (unterbrach, unterbrochen).",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Bitte unterbrich mich nicht!",
      "uebersetzung": {
        "fa": "لطفاً حرفم را قطع نکن!",
        "en": "Please don't interrupt me!"
      }
    },
    {
      "niveau": "B2",
      "satz": "Wir mussten die Sitzung unterbrechen, weil der Strom ausgefallen war.",
      "uebersetzung": {
        "fa": "مجبور شدیم جلسه را متوقف کنیم، چون برق رفته بود.",
        "en": "We had to interrupt the meeting because the power had gone out."
      }
    }
  ],
