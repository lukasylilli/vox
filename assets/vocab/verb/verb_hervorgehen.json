  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(از چیزی) معلوم شدن، برآمدن، نتیجه شدن",
      "(از جایی یا وضعی) بیرون آمدن، (پیروز و مانند آن) به در آمدن"
    ],
    "en": [
      "to emerge from, to be clear from",
      "to come out of, to emerge (as winner)"
    ]
  },
  "niveau": "C1",
  "themen": [
