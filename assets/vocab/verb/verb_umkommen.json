  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(در حادثه) جان باختن، کشته شدن",
      "(محاوره) از (چیزی) هلاک شدن"
    ],
    "en": [
      "to die, to be killed (in an accident)",
      "(colloquial) to be dying (of sth.)"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Gesellschaft",
    "Nachrichten"
  ],
  "ipa": "ˈʊmˌkɔmən",
  "anmerkung": "Für gewaltsamen oder plötzlichen Tod (Unfall, Katastrophe). Ugs. übertragen: «vor Hitze/Langeweile umkommen».",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Bei dem Unfall ist niemand umgekommen.",
      "uebersetzung": {
        "fa": "در این تصادف کسی جان نباخت.",
        "en": "Nobody was killed in the accident."
      }
    },
    {
      "niveau": "B2",
      "satz": "Bei dem Erdbeben, das die Region letzte Woche erschütterte, kamen mehr als hundert Menschen um.",
      "uebersetzung": {
        "fa": "در زلزله‌ای که هفته‌ی پیش منطقه را لرزاند، بیش از صد نفر جان باختند.",
        "en": "More than a hundred people died in the earthquake that shook the region last week."
      }
    }
  ],
