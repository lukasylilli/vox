  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "از لانه پرواز کردن",
      "(محاوره) برای گردش بیرون رفتن",
      "با هواپیما خارج کردن (تخلیه)"
    ],
    "en": [
      "to fly out (of the nest)",
      "to go out (colloq.)",
      "to evacuate by air"
    ]
  },
  "niveau": "C1",
