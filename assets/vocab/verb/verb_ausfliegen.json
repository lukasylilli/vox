  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Die jungen Vögel fliegen aus.",
      "uebersetzung": {
        "fa": "جوجه‌پرنده‌ها از لانه پرواز می‌کنند.",
        "en": "The young birds leave the nest."
      }
    },
    {
      "niveau": "B2",
      "satz": "Als wir am Sonntag klingelten, war die ganze Familie ausgeflogen, und niemand öffnete.",
      "uebersetzung": {
        "fa": "یکشنبه که زنگ زدیم، کل خانواده بیرون رفته بودند و کسی در را باز نکرد.",
        "en": "When we rang on Sunday, the whole family had gone out and nobody opened the door."
      }
    }
  ],
