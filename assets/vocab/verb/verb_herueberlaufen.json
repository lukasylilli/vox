  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(دوان یا پیاده) از آن طرف به این طرف آمدن"
    ],
    "en": [
      "to run over, to come running over"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Bewegung",
    "Verkehr"
  ],
