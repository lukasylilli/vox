  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Lauf nicht einfach über die Straße herüber!",
      "uebersetzung": {
        "fa": "همین‌طوری از خیابان ندو این طرف!",
        "en": "Don't just run across the road!"
      }
    },
    {
      "niveau": "B2",
      "satz": "Das Kind ist plötzlich zwischen den parkenden Autos herübergelaufen, und der Fahrer musste scharf bremsen.",
      "uebersetzung": {
        "fa": "بچه ناگهان از بین ماشین‌های پارک‌شده دوید این طرف و راننده مجبور شد ترمز شدید بگیرد.",
        "en": "The child suddenly ran out from between the parked cars, and the driver had to brake hard."
      }
    }
  ],
