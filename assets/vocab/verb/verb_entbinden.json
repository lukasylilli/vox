{
  "schema": "3.0",
  "id": "verb_entbinden",
  "wort": "entbinden",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "زایمان کردن؛ (بچه را) به دنیا آوردن (در پزشکی)",
      "(از وظیفه یا تعهدی) معاف کردن"
    ],
    "en": [
      "to give birth; to deliver (a baby)",
      "to release (from a duty)"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Medizin",
    "Pflege",
    "Recht"
  ],
  "ipa": "ɛntˈbɪndn̩",
  "anmerkung": null,
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Sie hat gestern entbunden.",
      "uebersetzung": {
        "fa": "او دیروز زایمان کرد.",
        "en": "She gave birth yesterday."
      }
    },
    {
      "niveau": "B2",
      "satz": "Der Arzt wurde vor Gericht von seiner Schweigepflicht entbunden, damit er aussagen konnte.",
      "uebersetzung": {
        "fa": "پزشک در دادگاه از تعهد رازداری‌اش معاف شد تا بتواند شهادت بدهد.",
        "en": "The doctor was released from his duty of confidentiality in court so that he could testify."
      }
    }
  ],
  "synonyme": [
