  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "دستش به جای اشتباه رفتن",
      "(محاوره) اشتباه کردن (در انتخاب کلمه، نت)"
    ],
    "en": [
      "to miss one's grip",
      "to get it wrong",
      "to make a gaffe"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Kommunikation",
    "Musik"
  ],
