    {
      "niveau": "A2",
      "satz": "Der Pianist greift daneben.",
      "uebersetzung": {
        "fa": "پیانیست نت را اشتباه می‌زند.",
        "en": "The pianist plays a wrong note."
      }
    },
    {
      "niveau": "B2",
      "satz": "Mit dieser Bemerkung über ihr Alter hat er ziemlich danebengegriffen, das merkte er sofort.",
      "uebersetzung": {
        "fa": "با آن حرف درباره‌ی سنش حسابی خطا کرد و فوراً هم متوجه شد.",
        "en": "He really put his foot in it with that remark about her age, and he noticed immediately."
      }
    }
  ],
