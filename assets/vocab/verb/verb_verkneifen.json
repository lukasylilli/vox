{
  "schema": "3.0",
  "id": "verb_verkneifen",
  "wort": "verkneifen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(محاوره) جلوی (چیزی را) گرفتن، از (چیزی) خودداری کردن"
    ],
    "en": [
      "(colloquial) to hold back, to refrain from"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Gefühle",
    "Verhalten"
  ],
  "ipa": "fɛɐ̯ˈknaɪ̯fn̩",
  "anmerkung": "Untrennbar, reflexiv mit Dativ: «sich (Dat) etwas verkneifen» (verkniff sich, hat sich verkniffen). Umgangssprachlich.",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Ich konnte mir das Lachen nicht verkneifen.",
      "uebersetzung": {
        "fa": "نتوانستم جلوی خنده‌ام را بگیرم.",
        "en": "I couldn't hold back my laughter."
      }
    },
    {
      "niveau": "B2",
      "satz": "Weil ich abnehmen will, verkneife ich mir abends die Süßigkeiten.",
      "uebersetzung": {
        "fa": "چون می‌خواهم وزن کم کنم، شب‌ها از شیرینی خودداری می‌کنم.",
        "en": "Because I want to lose weight, I deny myself sweets in the evening."
      }
    }
  ],
  "synonyme": [
    {
      "wort": "sich verbeißen",
      "uebersetzung": {
        "fa": "فرو خوردن",
        "en": "to stifle"
      }
    },
    {
      "wort": "verzichten",
      "uebersetzung": {
        "fa": "صرف نظر کردن",
        "en": "to do without"
      }
    }
  ],
