  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Er wird im Netz angefeindet.",
      "uebersetzung": {
        "fa": "در اینترنت با او خصمانه رفتار می‌شود.",
        "en": "He is being attacked online."
      }
    },
    {
      "niveau": "B2",
      "satz": "Weil die Journalistin über Korruption berichtet hatte, wurde sie monatelang angefeindet.",
      "uebersetzung": {
        "fa": "چون آن روزنامه‌نگار درباره‌ی فساد گزارش داده بود، ماه‌ها با او دشمنی کردند.",
        "en": "Because the journalist had reported on corruption, she was attacked for months."
      }
    }
  ],
