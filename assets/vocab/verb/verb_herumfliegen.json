  "id": "verb_herumfliegen",
  "wort": "herumfliegen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "این طرف و آن طرف پرواز کردن",
      "(محاوره) (اشیا) این طرف و آن طرف پخش و پلا بودن"
    ],
    "en": [
      "to fly around",
      "(colloquial) to be lying around everywhere"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Tiere",
    "Alltag"
  ],
  "ipa": "hɛˈʁʊmˌfliːɡn̩",
  "anmerkung": "Umgangssprachlich oft «rum…».",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Eine Fliege fliegt herum.",
      "uebersetzung": {
        "fa": "مگسی این طرف و آن طرف پرواز می‌کند.",
        "en": "A fly is flying around."
      }
    },
    {
      "niveau": "B2",
      "satz": "Nach dem Sturm flogen überall Blätter und Plastiktüten auf der Straße herum.",
      "uebersetzung": {
        "fa": "بعد از طوفان، همه‌جای خیابان برگ و کیسه‌ی پلاستیکی این طرف و آن طرف می‌رفت.",
        "en": "After the storm, leaves and plastic bags were flying around everywhere in the street."
      }
    }
  ],
  "synonyme": [
