  "uebersetzung": {
    "fa": [
      "(چیزی را به کسی) دادن، واگذار کردن",
      "(sich hergeben für) به (کار ناپسندی) تن دادن",
      "(محاوره) (چیزی) ارزش یا فایده داشتن"
    ],
    "en": [
      "to give (up), to hand over",
      "(sich für) to lend oneself to",
      "(colloquial) to be worth, to yield"
    ]
  },
  "niveau": "B1",
  "themen": [
    "Alltag",
    "Moral"
  ],
