  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "در نظر گرفتن، به چیزی فکر کردن",
      "(jemanden mit etwas bedenken) به کسی چیزی دادن (ادبی)"
    ],
    "en": [
      "to consider",
      "to bear in mind"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Kommunikation",
    "Denken"
  ],
  "ipa": "bəˈdɛŋkn̩",
  "anmerkung": null,
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Bedenke die Folgen!",
      "uebersetzung": {
        "fa": "به عواقبش فکر کن!",
        "en": "Consider the consequences!"
      }
    },
    {
      "niveau": "B2",
      "satz": "Man muss bedenken, dass viele Menschen sich so eine teure Wohnung nicht leisten können.",
      "uebersetzung": {
        "fa": "باید در نظر گرفت که خیلی‌ها نمی‌توانند از عهده‌ی چنین آپارتمان گرانی بربیایند.",
        "en": "One must bear in mind that many people cannot afford such an expensive flat."
      }
    }
  ],
