  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(ناگهان از جایی) بیرون زدن، پدیدار شدن",
      "(احساسی) ناگهان بروز کردن"
    ],
    "en": [
      "to burst out, to break through",
      "to burst out (feeling)"
    ]
  },
  "niveau": "C1",
