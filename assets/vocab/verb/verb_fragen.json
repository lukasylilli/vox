  "beispiele": [
    {
      "niveau": "A1",
      "satz": "Darf ich Sie etwas fragen?",
      "uebersetzung": {
        "fa": "می‌توانم چیزی از شما بپرسم؟",
        "en": "May I ask you something?"
      }
    },
    {
      "niveau": "B1",
      "satz": "Ich frage mich, ob ich die richtige Entscheidung getroffen habe.",
      "uebersetzung": {
        "fa": "از خودم می‌پرسم آیا تصمیم درستی گرفته‌ام.",
        "en": "I wonder whether I made the right decision."
