  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Ich bringe dir das Buch morgen rüber.",
      "uebersetzung": {
        "fa": "فردا کتاب را برایت می‌آورم.",
        "en": "I'll bring the book over to you tomorrow."
      }
    },
    {
      "niveau": "B2",
      "satz": "Der Lehrer hat das Thema so gut rübergebracht, dass alle es verstanden haben.",
      "uebersetzung": {
        "fa": "معلم موضوع را آن‌قدر خوب منتقل کرد که همه فهمیدند.",
        "en": "The teacher got the topic across so well that everyone understood it."
      }
    }
  ],
