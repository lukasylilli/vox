    "fa": [
      "(محاوره) به آن طرف بردن / به این طرف آوردن",
      "(محاوره) (مطلبی را) خوب منتقل کردن"
    ],
    "en": [
      "(colloquial) to bring over",
      "(colloquial) to get across (a message)"
    ]
  },
  "niveau": "B2",
