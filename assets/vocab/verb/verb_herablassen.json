{
  "schema": "3.0",
  "id": "verb_herablassen",
  "wort": "herablassen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(با طناب و مانند آن) پایین فرستادن",
      "(sich herablassen) با تکبر (به کاری) تن دادن، منت گذاشتن"
    ],
    "en": [
      "to let down, to lower",
      "(sich) to condescend, to deign"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Beziehungen",
    "Verhalten"
  ],
  "ipa": "hɛˈʁapˌlasn̩",
  "anmerkung": "Das Partizip «herablassend» (= überheblich) ist auch ein eigenes Adjektiv.",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Er lässt den Korb am Seil herab.",
      "uebersetzung": {
        "fa": "او سبد را با طناب پایین می‌فرستد.",
        "en": "He lowers the basket on the rope."
      }
    },
    {
      "niveau": "B2",
      "satz": "Nach einer Stunde hat sich der Chef endlich herabgelassen, mit den Mitarbeitern zu sprechen.",
      "uebersetzung": {
        "fa": "بعد از یک ساعت رئیس بالاخره منت گذاشت و با کارمندان صحبت کرد.",
        "en": "After an hour the boss finally deigned to speak with the staff."
      }
    }
  ],
  "synonyme": [
