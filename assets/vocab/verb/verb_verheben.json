  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(هنگام بلند کردن بار) به خود آسیب زدن، کمر خود را آسیب زدن"
    ],
    "en": [
      "to strain oneself (lifting)"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Gesundheit",
    "Arbeit"
  ],
  "ipa": "fɛɐ̯ˈheːbn̩",
  "anmerkung": "Untrennbar, reflexiv (verhob sich, hat sich verhoben). Übertragen: «sich an einem Projekt verheben» (= sich übernehmen).",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Ich habe mich beim Umzug verhoben.",
      "uebersetzung": {
        "fa": "موقع اسباب‌کشی کمرم آسیب دید.",
        "en": "I strained myself during the move."
      }
    },
    {
      "niveau": "B2",
      "satz": "Damit man sich nicht verhebt, sollte man schwere Kisten aus den Knien heben.",
      "uebersetzung": {
        "fa": "برای این که آدم به خودش آسیب نزند، باید جعبه‌های سنگین را با زانو بلند کند.",
        "en": "So as not to strain yourself, you should lift heavy boxes from the knees."
      }
    }
  ],
  "synonyme": [
    {
      "wort": "sich übernehmen",
      "uebersetzung": {
        "fa": "بیش از توان کار کردن",
        "en": "to overreach oneself"
      }
    }
  ],
