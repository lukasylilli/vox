{
  "schema": "3.0",
  "id": "verb_hinweggehen",
  "wort": "hinweggehen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(über etwas hinweggehen) (موضوعی را) نادیده گرفتن، از کنارش گذشتن",
      "(طوفان و مانند آن) از روی (جایی) گذشتن"
    ],
    "en": [
      "(über etw) to pass over, to ignore",
      "(storm) to sweep over"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Kommunikation",
    "Wetter"
  ],
  "ipa": "hɪnˈvɛkˌɡeːən",
  "anmerkung": null,
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Er geht über die Frage hinweg.",
      "uebersetzung": {
        "fa": "او سؤال را نادیده می‌گیرد.",
        "en": "He passes over the question."
      }
    },
    {
      "niveau": "B2",
      "satz": "Der Chef ist einfach über meine Einwände hinweggegangen, als hätte ich nichts gesagt.",
      "uebersetzung": {
        "fa": "رئیس به‌راحتی اعتراض‌هایم را نادیده گرفت، انگار چیزی نگفته بودم.",
        "en": "The boss simply ignored my objections, as if I hadn't said anything."
      }
    }
  ],
  "synonyme": [
