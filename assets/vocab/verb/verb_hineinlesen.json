{
  "schema": "3.0",
  "id": "verb_hineinlesen",
  "wort": "hineinlesen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(در متنی) معنایی را که نیست برداشت کردن، تعبیر اضافه کردن",
      "(sich hineinlesen) با خواندن با (موضوعی) آشنا شدن"
    ],
    "en": [
      "to read into (a text)",
      "(sich) to read up on, to get into (a subject) by reading"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Lesen",
    "Kommunikation"
  ],
  "ipa": "hɪˈnaɪ̯nˌleːzn̩",
  "anmerkung": null,
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Du liest zu viel hinein.",
      "uebersetzung": {
        "fa": "تو بیش از حد برداشت می‌کنی.",
        "en": "You're reading too much into it."
      }
    },
    {
      "niveau": "B2",
      "satz": "Bevor ich das Seminar halte, muss ich mich erst gründlich in das Thema hineinlesen.",
      "uebersetzung": {
        "fa": "قبل از اینکه سمینار را برگزار کنم، باید اول حسابی درباره‌ی موضوع مطالعه کنم.",
        "en": "Before I give the seminar, I first have to read up thoroughly on the topic."
      }
    }
  ],
  "synonyme": [
    {
      "wort": "überinterpretieren",
      "uebersetzung": {
        "fa": "بیش از حد تعبیر کردن",
        "en": "to over-interpret"
