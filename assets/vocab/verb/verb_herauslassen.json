    "fa": [
      "اجازه‌ی بیرون آمدن دادن، بیرون گذاشتن",
      "(محاوره) (احساسی را) بروز دادن، خالی کردن"
    ],
    "en": [
      "to let out",
      "(colloquial) to let out (feelings)"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Alltag",
    "Gefühle"
  ],
