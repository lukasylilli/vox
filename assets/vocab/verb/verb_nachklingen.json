{
  "schema": "3.0",
  "id": "verb_nachklingen",
  "wort": "nachklingen",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(صدا) پس از قطع شدن هنوز به گوش رسیدن، طنین داشتن",
      "(احساس یا تجربه‌ای) مدتی در ذهن ماندن"
    ],
    "en": [
      "to linger, to reverberate",
      "(feeling, experience) to linger on"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Musik",
    "Gefühle"
  ],
  "ipa": "ˈnaːxˌklɪŋən",
  "anmerkung": null,
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Der Ton klingt lange nach.",
      "uebersetzung": {
        "fa": "صدا مدت زیادی طنین دارد.",
        "en": "The note lingers for a long time."
      }
    },
    {
      "niveau": "B2",
      "satz": "Die Worte des Arztes haben noch lange in mir nachgeklungen.",
      "uebersetzung": {
        "fa": "حرف‌های پزشک تا مدت‌ها در ذهنم ماند.",
        "en": "The doctor's words lingered in my mind for a long time."
      }
    }
  ],
  "synonyme": [
