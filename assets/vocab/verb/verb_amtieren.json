  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(در مقامی) خدمت کردن، متصدی بودن"
    ],
    "en": [
      "to hold office",
      "to officiate"
    ]
  },
  "niveau": "C1",
  "themen": [
    "Politik",
    "Arbeit"
  ],
  "ipa": "amˈtiːʁən",
  "anmerkung": "Regelmäßig (amtierte, amtiert). Partizip I «amtierend» oft adjektivisch: «der amtierende Weltmeister».",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Sie amtiert als Bürgermeisterin.",
      "uebersetzung": {
        "fa": "او شهردار است (در این مقام خدمت می‌کند).",
        "en": "She is serving as mayor."
      }
    },
    {
      "niveau": "B2",
      "satz": "Der Präsident amtiert noch bis zum Ende des Jahres, dann übernimmt sein Nachfolger.",
      "uebersetzung": {
        "fa": "رئیس‌جمهور تا پایان سال در مقامش می‌ماند، سپس جانشینش کار را به دست می‌گیرد.",
        "en": "The president remains in office until the end of the year, then his successor takes over."
      }
    }
  ],
