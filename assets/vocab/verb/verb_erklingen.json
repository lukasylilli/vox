  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(صدا یا موسیقی) به گوش رسیدن، طنین‌انداز شدن"
    ],
    "en": [
      "to ring out, to sound, to be heard"
    ]
  },
  "niveau": "C1",
