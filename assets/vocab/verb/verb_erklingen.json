  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Eine Glocke erklingt.",
      "uebersetzung": {
        "fa": "صدای زنگی به گوش می‌رسد.",
        "en": "A bell rings out."
      }
    },
    {
      "niveau": "B2",
      "satz": "Als das Licht im Saal ausging, erklang leise Musik, und das Publikum wurde still.",
      "uebersetzung": {
        "fa": "وقتی چراغ‌های سالن خاموش شد، موسیقی آرامی طنین انداخت و تماشاگران ساکت شدند.",
        "en": "When the lights in the hall went out, soft music began to play and the audience fell silent."
      }
    }
  ],
