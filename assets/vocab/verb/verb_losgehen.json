  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "راه افتادن (پیاده)",
      "(برنامه یا کاری) شروع شدن",
      "(بمب یا سلاحی) منفجر شدن، شلیک شدن؛ (auf jemanden losgehen) به (کسی) حمله کردن"
    ],
    "en": [
      "to set off (on foot)",
      "to start, to begin",
      "to go off (bomb, gun); (auf jdn) to go for someone"
    ]
  },
  "niveau": "A2",
  "themen": [
    "Alltag",
    "Freizeit"
  ],
