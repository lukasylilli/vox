    {
      "niveau": "A2",
      "satz": "Wann geht der Film los?",
      "uebersetzung": {
        "fa": "فیلم کی شروع می‌شود؟",
        "en": "When does the film start?"
      }
    },
    {
      "niveau": "B1",
      "satz": "Wir müssen jetzt losgehen, sonst verpassen wir den letzten Bus.",
      "uebersetzung": {
        "fa": "باید الان راه بیفتیم، وگرنه آخرین اتوبوس را از دست می‌دهیم.",
        "en": "We have to set off now, otherwise we'll miss the last bus."
      }
    }
  ],
