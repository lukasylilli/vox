  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(دست یا لیوانی را) بالا بردن",
      "(مالیات، عوارض یا داده‌ای را) وضع و دریافت کردن، گردآوری کردن",
      "(sich erheben) برخاستن؛ (علیه کسی) شورش کردن"
    ],
    "en": [
      "to raise, to lift",
      "to levy (taxes); to collect (data)",
      "(sich) to rise, to get up; to revolt"
    ]
  },
  "niveau": "B2",
  "themen": [
    "Politik",
    "Wissenschaft",
    "Recht"
  ],
