{
  "schema": "3.0",
  "id": "verb_verleiden",
  "wort": "verleiden",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(لذت چیزی را برای کسی) خراب کردن، از چشم (کسی) انداختن"
    ],
    "en": [
      "to spoil (sth. for sb.)",
      "to put sb. off sth."
    ]
  },
  "niveau": "C1",
  "themen": [
    "Gefühle"
  ],
  "ipa": "fɛɐ̯ˈlaɪ̯dn̩",
  "anmerkung": "Regelmäßig (verleidete, verleidet), obwohl in der Liste der unregelmäßigen Verben. Immer: «jemandem etwas verleiden».",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Der Regen hat uns den Urlaub verleidet.",
      "uebersetzung": {
        "fa": "باران تعطیلات را برایمان خراب کرد.",
        "en": "The rain spoiled our holiday for us."
      }
    },
    {
      "niveau": "B2",
      "satz": "Der strenge Lehrer hat mir die Mathematik so verleidet, dass ich sie bis heute nicht mag.",
      "uebersetzung": {
        "fa": "آن معلم سخت‌گیر ریاضی را آن‌قدر از چشمم انداخت که تا امروز از آن خوشم نمی‌آید.",
        "en": "The strict teacher put me off maths so much that I still don't like it today."
      }
    }
  ],
