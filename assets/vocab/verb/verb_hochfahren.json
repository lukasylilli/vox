  "id": "verb_hochfahren",
  "wort": "hochfahren",
  "wortart": "verb",
  "uebersetzung": {
    "fa": [
      "(با وسیله‌ی نقلیه یا آسانسور) بالا رفتن",
      "(رایانه را) روشن کردن، راه‌اندازی کردن؛ (تولید را) افزایش دادن",
      "(از ترس یا خواب) از جا پریدن"
    ],
    "en": [
      "to go up, to drive up",
      "to boot up (a computer); to ramp up",
      "to start up (from sleep, in fright)"
    ]
  },
  "niveau": "B1",
  "themen": [
    "Technik",
    "Verkehr"
  ],
  "ipa": "ˈhoːxˌfaːʁən",
  "anmerkung": "Intransitiv mit «sein» (in den dritten Stock hochfahren; aus dem Schlaf hochfahren); transitiv (den Computer hochfahren, die Produktion hochfahren) mit «haben». Umgangssprachlich; gehoben eher «hinauf…/herauf…».",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Der Computer fährt langsam hoch.",
      "uebersetzung": {
        "fa": "کامپیوتر آرام بالا می‌آید (روشن می‌شود).",
        "en": "The computer is booting up slowly."
      }
    },
    {
      "niveau": "B2",
      "satz": "Mitten in der Nacht ist sie vom Klingeln des Telefons erschrocken hochgefahren.",
      "uebersetzung": {
        "fa": "نیمه‌شب با صدای زنگ تلفن وحشت‌زده از جا پرید.",
        "en": "In the middle of the night she started up in fright at the ringing of the phone."
      }
    }
  ],
