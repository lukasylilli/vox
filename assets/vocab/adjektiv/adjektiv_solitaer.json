    {
      "niveau": "A2",
      "satz": "Die Biene lebt solitär.",
      "uebersetzung": {
        "fa": "این زنبور تنها زندگی می‌کند.",
        "en": "The bee lives a solitary life."
      }
    },
    {
      "niveau": "B1",
      "satz": "Die solitären Bienen bauen keine Staaten, sondern leben einzeln.",
      "uebersetzung": {
        "fa": "زنبورهای منفرد کلونی نمی‌سازند و تک‌تک زندگی می‌کنند.",
        "en": "Solitary bees do not build colonies but live singly."
      }
    },
    {
      "niveau": "B1",
      "satz": "Ein solitärer Baum stand mitten auf der Wiese und prägte das ganze Bild der Landschaft.",
      "uebersetzung": {
        "fa": "درختی منفرد وسط چمنزار ایستاده بود و تصویر کل منظره را شکل می‌داد.",
        "en": "A solitary tree stood in the middle of the meadow and shaped the whole picture of the landscape."
      }
    }
