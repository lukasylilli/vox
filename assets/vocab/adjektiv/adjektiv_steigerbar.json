  "anmerkung": "Kann erhöht werden; in der Grammatik: Adjektive, die einen Komparativ bilden können („groß, größer“). Wird nicht gesteigert.",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "„Schön“ ist steigerbar.",
      "uebersetzung": {
        "fa": "«schön» تفضیل‌پذیر است.",
        "en": "“Schön” can be compared."
      }
    },
    {
      "niveau": "B2",
      "satz": "Nicht jedes Adjektiv ist steigerbar, zum Beispiel „tot“ oder „schwanger“.",
      "uebersetzung": {
        "fa": "هر صفتی قابل تفضیل نیست، مثلاً «مرده» یا «باردار».",
        "en": "Not every adjective can be compared, for example “dead” or “pregnant”."
      }
    },
    {
      "niveau": "B2",
      "satz": "Die Leistung des Motors ist noch steigerbar, wenn man ihn richtig einstellt.",
      "uebersetzung": {
        "fa": "کارایی موتور هنوز قابل افزایش است اگر درست تنظیمش کنند.",
        "en": "The engine’s performance can still be increased if it is set correctly."
      }
    }
  ],
