  "anmerkung": "Über den einzelnen Staaten stehend; z. B. die EU als supranationale Organisation. Wird nicht gesteigert.",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Die Europäische Union ist eine supranationale Organisation.",
      "uebersetzung": {
        "fa": "اتحادیه‌ی اروپا یک سازمان فراملی است.",
        "en": "The European Union is a supranational organisation."
      }
    },
    {
      "niveau": "B1",
      "satz": "Supranationale Gesetze gelten in allen Mitgliedsstaaten und haben oft Vorrang vor nationalem Recht.",
      "uebersetzung": {
        "fa": "قوانین فراملی در همه‌ی کشورهای عضو اعتبار دارند و اغلب بر قانون ملی مقدم‌اند.",
        "en": "Supranational laws apply in all member states and often take precedence over national law."
      }
    }
  ],
