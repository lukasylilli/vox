  "anmerkung": "Gehoben, altmodisch und oft ironisch: lieb und vertraut; bekannt aus „trautes Heim, Glück allein“. Wird nicht gesteigert.",
  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Er sitzt im trauten Heim.",
      "uebersetzung": {
        "fa": "در خانه‌ی گرم و صمیمی‌اش نشسته است.",
        "en": "He is sitting in his cosy home."
      }
    },
    {
      "niveau": "B1",
      "satz": "„Trautes Heim, Glück allein“ steht auf dem alten Bild in der Küche.",
      "uebersetzung": {
        "fa": "روی تابلوی قدیمی آشپزخانه نوشته «خانه‌ی عزیز، تنها خوشبختی».",
        "en": "“Home sweet home” is written on the old picture in the kitchen."
      }
    },
    {
      "niveau": "B1",
      "satz": "Im trauten Kreis der Familie feierte sie ihren neunzigsten Geburtstag.",
      "uebersetzung": {
        "fa": "او نودمین سالروز تولدش را در جمع صمیمی خانواده جشن گرفت.",
        "en": "She celebrated her ninetieth birthday in the intimate circle of her family."
      }
    }
  ],
