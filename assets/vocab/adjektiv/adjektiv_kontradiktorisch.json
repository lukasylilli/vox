  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Die Aussagen sind kontradiktorisch.",
      "uebersetzung": {
        "fa": "این گزاره‌ها متناقض‌اند.",
        "en": "The statements are contradictory."
      }
    },
    {
      "niveau": "B2",
      "satz": "Zwei Aussagen sind kontradiktorisch, wenn genau eine von beiden wahr sein muss, wie «Es regnet» und «Es regnet nicht».",
      "uebersetzung": {
        "fa": "دو گزاره متناقض‌اند اگر دقیقاً یکی از آن دو باید درست باشد، مثل «باران می‌بارد» و «باران نمی‌بارد».",
        "en": "Two statements are contradictory if exactly one of them must be true, like «It is raining» and «It is not raining»."
      }
    }
  ],
