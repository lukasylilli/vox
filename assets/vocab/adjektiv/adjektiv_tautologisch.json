    {
      "niveau": "C1",
      "satz": "„Ein runder Kreis“ ist ein tautologischer Ausdruck.",
      "uebersetzung": {
        "fa": "«دایره‌ی گرد» یک عبارت همان‌گویانه است.",
        "en": "“A round circle” is a tautological expression."
      }
    },
    {
      "niveau": "C2",
      "satz": "Die Begründung ist tautologisch: Sie wiederholt nur die Behauptung mit anderen Worten.",
      "uebersetzung": {
        "fa": "استدلال همان‌گویانه است: فقط ادعا را با کلمات دیگر تکرار می‌کند.",
        "en": "The reasoning is tautological: it merely repeats the claim in other words."
      }
    }
  ],
