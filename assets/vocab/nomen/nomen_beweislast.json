  "beispiele": [
    {
      "niveau": "A2",
      "satz": "Wer trägt die Beweislast?",
      "uebersetzung": {
        "fa": "بار اثبات بر عهده‌ی کیست؟",
        "en": "Who bears the burden of proof?"
      }
    },
    {
      "niveau": "B2",
      "satz": "Im Strafprozess liegt die Beweislast bei der Anklage, denn der Angeklagte gilt bis zum Urteil als unschuldig.",
      "uebersetzung": {
        "fa": "در دادرسی کیفری، بار اثبات بر عهده‌ی دادستانی است، چون متهم تا صدور حکم بی‌گناه شمرده می‌شود.",
        "en": "In criminal proceedings the burden of proof lies with the prosecution, because the defendant is presumed innocent until the verdict."
      }
    }
  ],
